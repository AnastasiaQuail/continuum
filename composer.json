{
    "name": "anastasiaquail/continuum",
    "description": "",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/collections": "^2.6.0",
        "doctrine/dbal": "^4.4.3",
        "doctrine/doctrine-bundle": "^3.2.4",
        "doctrine/doctrine-migrations-bundle": "^4.0.0",
        "doctrine/orm": "^3.6.7",
        "doctrine/persistence": "^4.2.0",
        "psr/cache": "^3.0.0",
        "psr/log": "^3.0.2",
        "symfony/apache-pack": "^1.0.1",
        "symfony/asset": "^8.1.0",
        "symfony/asset-mapper": "^8.1.1",
        "symfony/console": "^8.1.1",
        "symfony/dependency-injection": "^8.1.1",
        "symfony/doctrine-bridge": "^8.1.1",
        "symfony/dotenv": "^8.1.0",
        "symfony/event-dispatcher": "^8.1.1",
        "symfony/finder": "^8.1.1",
        "symfony/flex": "^2.11.0",
        "symfony/form": "^8.1.1",
        "symfony/framework-bundle": "^8.1.1",
        "symfony/http-client-contracts": "^3.7.1",
        "symfony/http-foundation": "^8.1.1",
        "symfony/http-kernel": "^8.1.1",
        "symfony/monolog-bundle": "^4.0.2",
        "symfony/options-resolver": "^8.1.0",
        "symfony/password-hasher": "^8.1.0",
        "symfony/process": "^8.1.0",
        "symfony/property-access": "^8.1.0",
        "symfony/routing": "^8.1.0",
        "symfony/runtime": "^8.1.0",
        "symfony/security-bundle": "^8.1.1",
        "symfony/security-core": "^8.1.1",
        "symfony/security-http": "^8.1.1",
        "symfony/serializer": "^8.1.1",
        "symfony/twig-bundle": "^8.1.0",
        "symfony/uid": "^8.1.0",
        "symfony/ux-icons": "^3.2.0",
        "symfony/validator": "^8.1.1",
        "symfony/yaml": "^8.1.1",
        "twig/twig": "^3.27.1"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.6.0",
        "deployer/deployer": "^8.0.5",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "ergebnis/composer-normalize": "^2.52.0",
        "friendsofphp/php-cs-fixer": "^3.95.11",
        "infection/infection": "^0.34.0",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0.4",
        "phpstan/phpstan-doctrine": "^2.0.27",
        "phpstan/phpstan-phpunit": "^2.0.16",
        "phpstan/phpstan-strict-rules": "^2.0.11",
        "phpstan/phpstan-symfony": "^2.0.20",
        "phpunit/phpunit": "^13.2.2",
        "rector/rector": "^2.5.2",
        "shipmonk/composer-dependency-analyser": "^1.8.4",
        "symfony/browser-kit": "^8.1.1",
        "symfony/css-selector": "^8.1.0",
        "symfony/debug-bundle": "^8.1.0",
        "symfony/maker-bundle": "^1.67.0",
        "symfony/web-profiler-bundle": "^8.1.1",
        "vincentlanglet/twig-cs-fixer": "^4.0.2"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php85": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Continuum\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Continuum\\Tests\\": "tests/",
            "Continuum\\Tools\\": "tools/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "docker": true,
            "require": "8.1.*"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "db:restore": "@php bin/console app:db:restore /app/data/backup.sql",
        "icons": "@php bin/console ux:icons:lock",
        "infection": "@php vendor/bin/infection --threads=max --show-mutations=max",
        "migration": "@php bin/console make:migration --formatted",
        "migration:migrate": "@php bin/console doctrine:migrations:migrate",
        "migration:rollback": "@migration:migrate prev",
        "php-cs": [
            "@putenv PHP_CS_FIXER_FUTURE_MODE=1",
            "@php vendor/bin/php-cs-fixer check --verbose --diff"
        ],
        "php-cs:fix": [
            "@putenv PHP_CS_FIXER_FUTURE_MODE=1",
            "@php vendor/bin/php-cs-fixer fix"
        ],
        "phpstan": "@php vendor/bin/phpstan analyse",
        "phpstan:clear": "@php vendor/bin/phpstan clear-result-cache",
        "qa": [
            "@self-check",
            "@static-analysis",
            "@tests",
            "@infection"
        ],
        "rector": "@rector:fix --dry-run",
        "rector:fix": "@php vendor/bin/rector process",
        "self-audit": "@composer audit",
        "self-check": [
            "@self-audit",
            "@self-dependencies",
            "@self-dump-autoload",
            "@self-normalize",
            "@self-validate"
        ],
        "self-dependencies": "@php vendor/bin/composer-dependency-analyser",
        "self-dump-autoload": "@composer dump-autoload --dry-run --optimize --strict-psr",
        "self-normalize": "@composer normalize composer.json --dry-run",
        "self-validate": "@composer validate --strict",
        "static-analysis": [
            "@php-cs",
            "@phpstan",
            "@rector",
            "@twig-cs"
        ],
        "tests": "@php vendor/bin/phpunit",
        "tests:ci": [
            "@putenv DATABASE_PREPARE=1",
            "@composer tests"
        ],
        "tests:coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "@tests --coverage-html src-coverage/"
        ],
        "twig-cs": [
            "@php bin/console lint:twig --show-deprecations",
            "@php vendor/bin/twig-cs-fixer lint"
        ],
        "twig-cs:fix": "@php vendor/bin/twig-cs-fixer fix"
    }
}
