{% extends 'base.html.twig' %}

{% block title %}Events on {{ day.format('j F Y') }}{% endblock %}
{% block page_title %}{{ day.format('j F Y') }}{% endblock %}
{% block body_id %}calendar-date{% endblock %}

{% set breadcrumbs = [
    {label: 'Calendar', url: path('app_calendar', {year: day.format('Y')})},
    {label: 'Edit'},
] %}

{% block main -%}
    {%- if events is not empty -%}
        <section class="card">
            <h2 class="card-title">Events of the day</h2>

            {%- for event in events -%}
                {%- set event_date = event.datetime.setTimezone(app.user.timezone) -%}

                <div class="calendar-event" data-general-type="{{ event.type.value }}">
                    <div class="calendar-event-body">
                        <span class="calendar-event-type">{{ event.title }}</span>
                        {%- if not event.allDay -%}
                            <span> at {{ event_date.format('H:i') }}</span>
                        {%- endif -%}

                        <form method="post" action="{{ path('app_calendar_event_delete', {id: event.id}) }}"
                              onsubmit="return confirm('Delete?')">
                            <input type="hidden" name="_method" value="DELETE">
                            <button
                                class="btn btn-sm btn-transparent btn-danger"
                                {% if is_granted('CALENDAR_EVENT_DELETE') %}type="submit" {% else %}disabled{% endif %}>
                                {{- ux_icon('lucide:trash') -}}
                            </button>
                        </form>
                    </div>

                    <div class="calendar-event-created-at">
                        {{- 'Added ' ~ event.id.datetime.setTimezone(app.user.timezone).format('j F Y, H:i') -}}
                    </div>
                </div>
            {%- endfor -%}
        </section>
    {%- endif -%}

    <section class="card">
        <div class="card-title card-title-controls">
            <h2>Add new event</h2>

            {%- set prev_day = day.modify('-1 day') -%}
            {%- set next_day = day.modify('+1 day') -%}
            {{ include('default/_pagination.html.twig', {
                prev: {
                    url: path('app_calendar_day', {day: prev_day.format('Y-m-d')}),
                    label: prev_day.format('j F'),
                    is_granted: prev_day.format('Y') > app_year_min,
                },
                next: {
                    url: path('app_calendar_day', {day: next_day.format('Y-m-d')}),
                    label: next_day.format('j F'),
                    is_granted: next_day.format('Y') < app_year_max,
                },
            }) }}
        </div>

        {{- form_start(form) -}}

        {{- form_row(form.title) -}}

        <div class="mb-3">
            {{- form_label(form.type) -}}
            <div class="form-control-choose-type-group">
                {%- for choice in form.type.vars.choices -%}
                    <label class="form-control-choose-type" data-general-type="{{ choice.value }}">
                        <input type="radio" name="type" id="{{ form.type.vars.id }}_{{ choice.value }}"
                               value="{{ choice.value }}"
                               {%- if form.type.vars.required %}required="required"{% endif %}
                            {%- if choice.value === form.type.vars.value %}checked{% endif %}>
                        <span class="btn btn-sm">{{ choice.label }}</span>
                    </label>
                {%- endfor -%}
            </div>
            {{- form_errors(form.type) -}}
            {%- do form.type.setRendered -%}
        </div>

        <div class="mb-3">
            {{- form_label(form.time) -}}
            <div class="form-control-time">
                {{- form_widget(form.time) -}}
                <button class="btn" onclick="document.getElementById('time').value = null; return false;">
                    {{- ux_icon('lucide:x') -}}
                </button>
            </div>
            {{- form_errors(form.time) -}}
        </div>

        <div class="card-submit">
            <button type="submit" class="btn btn-primary btn-outline">Create event</button>
        </div>

        {{- form_end(form) -}}
    </section>
{%- endblock %}
