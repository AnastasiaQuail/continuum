{% extends 'base.html.twig' %}

{%- block javascripts -%}
    {{ parent() }}
    <script src="{{ asset('js/calendar.js') }}"></script>
{%- endblock -%}

{% set is_current_year = day.format('Y') === user_date().format('Y') %}

{% block title %}Events on {{ day.format('j F Y') }}{% endblock %}
{% block page_title %}Events of the day{% endblock %}
{% block page_subtitle %}{{ is_current_year ? day.format('j F') : day.format('j F Y') }}{% endblock %}
{% block body_id %}calendar-date{% endblock %}

{% set back_path = path('app_calendar', {year: day.format('Y')}) %}

{% block body_actions -%}
    <div class="body-actions actions-pagination">
        {%- set prev_day = day.modify('-1 day') -%}
        {%- set next_day = day.modify('+1 day') -%}

        {{ include('default/_pagination.html.twig', {
            prev: {
                url: path('app_calendar_day', {day: prev_day.format('Y-m-d')}),
                label: prev_day.format('j F'),
                is_granted: prev_day.format('Y') > app_year_min,
            },
            next: {
                url: path('app_calendar_day', {day: next_day.format('Y-m-d')}),
                label: next_day.format('j F'),
                is_granted: next_day.format('Y') < app_year_max,
            },
        }) }}
    </div>
{%- endblock %}

{% block main -%}
    <section class="card">
        {%- for event in events -%}
            <div class="calendar-event" data-general-type="{{ event.type.value }}">
                <div class="calendar-event-body">
                    <span class="badge badge-fill">{{ event.title }}</span>
                    {%- if not event.allDay -%}
                        <span> at {{ event.getUserDatetime(app.user).format('H:i') }}</span>
                    {%- endif -%}

                    <form method="post" action="{{ path('app_calendar_event_delete', {id: event.id}) }}"
                          onsubmit="return confirm('Delete?')">
                        <input type="hidden" name="_method" value="DELETE">
                        <button
                            class="btn btn-sm btn-transparent btn-danger"
                            {% if is_granted('CALENDAR_EVENT_DELETE') %}type="submit" {% else %}disabled{% endif %}>
                            {{- ux_icon('lucide:trash') -}}
                        </button>
                    </form>
                </div>

                <div class="calendar-event-created-at">
                    {{- 'Added ' ~ event.createdAt.setTimezone(app.user.timezone).format('j F Y, H:i') -}}
                </div>
            </div>
        {%- endfor -%}

        {%- for holiday_event in holiday_events -%}
            <div class="calendar-event calendar-holiday-event">{{ holiday_event }}</div>
        {%- endfor -%}
    </section>

    <h2 class="card-title">Add new event</h2>

    <section class="card">
        {{- form_start(form) -}}

        {{- form_row(form.title) -}}

        <div class="mb-3">
            {{- form_label(form.type) -}}
            <div class="form-control-choose-type-group">
                {%- for choice in form.type.vars.choices -%}
                    <label class="form-control-choose-type" data-general-type="{{ choice.value }}">
                        <input type="radio" name="type" id="{{ form.type.vars.id }}_{{ choice.value }}"
                               value="{{ choice.value }}"
                               {%- if form.type.vars.required %}required="required"{% endif %}
                            {%- if choice.value === form.type.vars.value %}checked{% endif %}>
                        <span class="btn btn-sm" tabindex="0">{{ choice.label }}</span>
                    </label>
                {%- endfor -%}
            </div>
            {{- form_errors(form.type) -}}
            {%- do form.type.setRendered -%}
        </div>

        <div class="mb-3">
            {{- form_label(form.time) -}}
            <div class="form-control-time">
                {{- form_widget(form.time) -}}
                <button class="btn" onclick="document.getElementById('time').value = null; return false;">
                    {{- ux_icon('lucide:x') -}}
                </button>
            </div>
            {{- form_errors(form.time) -}}
        </div>

        {%- if previous_events -%}
            <div class="calendar-event-guesses">
                <div class="form-label">Or choose from you previous events</div>
                <div class="calendar-event-guesses-body">
                    {%- for previous_event in previous_events -%}
                        {%- set event_time = previous_event.getUserDatetime(app.user).format('H:i') -%}
                        <button class="btn btn-sm calendar-event-guess"
                                data-event-title="{{ previous_event.title }}"
                                data-general-type="{{ previous_event.type.value }}"
                                {% if not previous_event.allDay %}data-event-time="{{ event_time }}"{% endif %}>
                            <span>{{ previous_event.title }}</span>
                            {%- if not previous_event.allDay -%}
                                <small>at</small>
                                <span>{{ event_time }}</span>
                            {%- endif -%}
                        </button>
                    {%- endfor -%}
                </div>
            </div>
        {%- endif -%}

        <div class="card-submit">
            <button type="submit" class="btn btn-primary btn-outline">Create event</button>
        </div>

        {{- form_end(form) -}}
    </section>
{%- endblock %}
