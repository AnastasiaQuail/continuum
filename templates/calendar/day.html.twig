{% extends 'base.html.twig' %}

{% block title %}Calendar | {{ day.format('j F Y') }}{% endblock %}
{% block body_id %}calendar-date{% endblock %}

{% set breadcrumbs = [
    { label: 'Calendar', url: path('app_calendar') },
    { label: day.format('Y'), url: path('app_calendar', {'year': day.format('Y')}) },
    { label: day.format('j F') },
] %}

{% block main -%}
    {%- if events is not empty -%}
        <section class="card">
            <h3 class="card-title">Events</h3>

            {%- for event in events -%}
                {%- set eventDate = event.datetime.setTimezone(app.user.timezone) -%}

                <div class="calendar-event" data-general-type="{{ event.type.value }}">
                    <span class="calendar-event-type">{{ event.title }}</span>
                    {%- if not event.allDay -%}
                        <span> at {{ eventDate.format('H:i') }}</span>
                    {%- endif -%}

                    {% if is_granted('CALENDAR_EVENT_DELETE') %}
                        <form method="post" action="{{ path('app_calendar_event_delete', {'id': event.id}) }}"
                              onsubmit="return confirm('Delete?')">
                            <input type="hidden" name="_method" value="DELETE">
                            <button class="btn btn-sm btn-transparent btn-danger">{{ ux_icon('lucide:trash') }}</button>
                        </form>
                    {% endif %}
                </div>
            {%- endfor -%}
        </section>
    {%- endif -%}

    <section class="card">
        <h3 class="card-title">Create new event</h3>

        {{- form_start(form, {method: 'POST', action: path('app_calendar_day', {'day': day.format('Y-m-d')})}) -}}

        {{- form_row(form.title) -}}

        <div class="mb-3">
            {{- form_label(form.type) -}}
            <div class="form-control-radio-type-group">
                {%- for choice in form.type.vars.choices -%}
                    <label class="form-control-radio-type" data-general-type="{{ choice.value }}">
                        <input type="radio" name="type" id="{{ form.type.vars.id }}_{{ choice.value }}"
                               value="{{ choice.value }}"
                               {%- if form.type.vars.required %}required="required"{% endif %}
                            {%- if choice.value === form.type.vars.value %}checked{% endif %}>
                        <span class="btn btn-sm">{{ choice.label }}</span>
                    </label>
                {%- endfor -%}
            </div>
            {{- form_errors(form.type) -}}
            {%- do form.type.setRendered -%}
        </div>

        <div class="mb-3">
            {{- form_label(form.time) -}}
            <div class="form-control-time">
                {{- form_widget(form.time) -}}
                <button class="btn" onclick="document.getElementById('time').value = null; return false;">
                    {{- ux_icon('lucide:x') -}}
                </button>
            </div>
            {{- form_errors(form.time) -}}
        </div>

        <div class="card-submit">
            <button type="submit" class="btn btn-primary btn-outline">Create event</button>
        </div>

        {{- form_end(form) -}}
    </section>
{%- endblock %}
