{% extends 'base.html.twig' %}

{%- block javascripts -%}
    {{ parent() }}
    <script src="{{ asset('js/calendar.js') }}"></script>
{%- endblock -%}

{% set is_current_year = day.format('Y') === user_date().format('Y') %}

{% block title %}Events on {{ day.format('j F Y') }}{% endblock %}
{% block page_title %}Events of the day{% endblock %}
{% block page_subtitle %}{{ is_current_year ? day.format('j F') : day.format('j F Y') }}{% endblock %}
{% block body_id %}calendar-date{% endblock %}

{% set back_path = path('app_calendar', {year: day.format('Y')}) %}

{% block header_actions -%}
    <twig:Form:ExternalSubmit target="#form-calendar"/>
{%- endblock %}

{% block body_actions -%}
    <div class="body-actions actions-pagination">
        {%- set prev_day = day.modify('-1 day') -%}
        {%- set next_day = day.modify('+1 day') -%}

        {{ include('default/_pagination.html.twig', {
            prev: {
                url: path('app_calendar_day', {day: prev_day.format('Y-m-d')}),
                label: prev_day.format('j F'),
                is_granted: prev_day.format('Y') > app_year_min,
            },
            next: {
                url: path('app_calendar_day', {day: next_day.format('Y-m-d')}),
                label: next_day.format('j F'),
                is_granted: next_day.format('Y') < app_year_max,
            },
        }) }}
    </div>
{%- endblock %}

{% block main -%}
    <twig:Card>
        {%- for event in events -%}
            <div class="calendar-event">
                <div class="calendar-event-body">
                    <twig:Badge color="{{ event.type.value }}">{{ event.title }}</twig:Badge>
                    {%- if not event.allDay -%}
                        <span> at {{ event.getUserDatetime(app.user).format('H:i') }}</span>
                    {%- endif -%}

                    <form method="post" action="{{ path('app_calendar_event_delete', {id: event.id}) }}"
                          onsubmit="return confirm('Delete?')">
                        <input type="hidden" name="_method" value="DELETE">
                        <button
                            class="btn btn-sm btn-transparent btn-danger"
                            {% if is_granted('CALENDAR_EVENT_DELETE') %}type="submit" {% else %}disabled{% endif %}>
                            {{- ux_icon('lucide:trash') -}}
                        </button>
                    </form>
                </div>

                <div class="calendar-event-created-at" data-general-type="{{ event.type.value }}">
                    {{- 'Added ' ~ event.createdAt.setTimezone(app.user.timezone).format('j F Y, H:i') -}}
                </div>
            </div>
        {%- endfor -%}

        {%- for holiday_event in holiday_events -%}
            <div class="calendar-event calendar-holiday-event">{{ ux_icon('lucide:balloon') }} {{ holiday_event }}</div>
        {%- endfor -%}
    </twig:Card>

    <h2>Add new event</h2>

    <twig:CardForm>
        {{- form_start(form, {attr: {id: 'form-calendar', class: 'form-submit-external'}}) -}}

        {{- form_row(form.title, {attr: {placeholder: 'Required'}}) -}}
        {{- form_row(form.type, {button_size: 'btn-sm'}) -}}
        {{- form_row(form.time) -}}

        {%- if previous_events -%}
            <twig:Form:RowField class="form-row-post calendar-event-guesses"
                                label="Or choose from you previous events">
                <div class="form-row-post-body">
                    {%- for previous_event in previous_events -%}
                        {%- set event_time = previous_event.getUserDatetime(app.user).format('H:i') -%}
                        <button class="btn btn-sm calendar-event-guess"
                                data-event-title="{{ previous_event.title }}"
                                data-general-type="{{ previous_event.type.value }}"
                                {% if not previous_event.allDay %}data-event-time="{{ event_time }}"{% endif %}>
                            <span>{{ previous_event.title }}</span>
                            {%- if not previous_event.allDay -%}
                                <small>at</small>
                                <span>{{ event_time }}</span>
                            {%- endif -%}
                        </button>
                    {%- endfor -%}
                </div>
            </twig:Form:RowField>
        {%- endif -%}

        <twig:Form:Submit label="Create event"/>

        {{- form_end(form) -}}
    </twig:CardForm>
{%- endblock %}
