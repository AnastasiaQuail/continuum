{% extends 'base.html.twig' %}

{% set currentDate = user_date('now') %}

{% block title %}Calendar{{ year != currentDate.format('Y') ? ' | ' ~ year }}{% endblock %}
{% block body_id %}calendar{% endblock %}

{% set breadcrumbs = [
    { label: 'Calendar', url: path('app_calendar') },
    { label: year },
] %}

{% set paginations = {
    prev: {
        url: path('app_calendar', {'year': year - 1}),
        label: year - 1,
        isGranted: year > app_year_min,
    },
    title: year,
    next: {
        url: path('app_calendar', {'year': year + 1}),
        label: year + 1,
        isGranted: year < app_year_max,
    },
} %}

{% block showcase -%}
    {%- if upcomingNotifications is not empty and is_granted('CALENDAR_UPCOMING_NOTIFICATIONS') -%}
        <section class="card calendar calendar-upcoming-notifications" id="calendar-notifications">
            <div class="notifications-body">
                {%- for upcomingNotification in upcomingNotifications -%}
                    <div class="notification-text" data-general-type="{{ upcomingNotification.type.value }}">
                        <strong>{{ upcomingNotification.title }}</strong>
                        <span>- {{ upcomingNotification.text -}}</span>
                    </div>
                {%- endfor -%}
                <div class="notifications-arrow">{{ ux_icon('lucide:chevron-right') }}</div>
            </div>
        </section>
    {%- endif -%}
{%- endblock %}

{% block main -%}
    <section class="card card-calendar">
        <div class="calendar">
            {%- set current = currentDate.format('Y-m-d') -%}
            {%- set isGranted = is_granted('CALENDAR_EDIT') -%}

            {%- for monthNumber in 1..12 -%}
                {%- set month = year ~ '-' ~ (monthNumber < 10 ? '0') ~ monthNumber -%}
                {%- set firstDay = month ~ '-01' -%}
                {%- set firstWeekDay = firstDay|date('N') -%}

                <article class="month" style="--month-offset: {{ firstWeekDay - 1 }};">
                    <div class="month-title">{{ month|date('F') }}</div>
                    <div class="month-days">
                        {%- if firstWeekDay > 1 -%}
                            <div class="day fake-day" style="--fake-days: {{ firstWeekDay - 1 }};">
                                <span>1</span>
                            </div>
                        {%- endif -%}

                        {%- for dayNumber in 1..firstDay|date('t') -%}
                            {%- set day = month ~ '-' ~ (dayNumber < 10 ? '0') ~ dayNumber -%}
                            {%- set isWeekend = day|date('N') == 6 or day|date('N') == 7 -%}

                            {%- set dayEvent = events[day] is defined ? events[day].dayEvent : null -%}
                            {%- set hourEvents = events[day] is defined ? events[day].hourEvents : [] -%}

                            <{% if isGranted %}a{% else %}div{% endif %}
                                {% if isGranted %}href="{{ path('app_calendar_day', {'day': day}) }}"{% endif %}
                                class="day {{- day < current ? ' day-past' -}} {{- day == current ? ' day-current' -}} {{- day < startDay.format('Y-m-d') ? ' day-inactive' -}} {{- isWeekend ? ' day-weekend' -}}"
                                {%- if dayEvent is not null %}data-general-type="{{ dayEvent.type.value }}"{% endif -%}>
                                <span>{{ dayNumber }}</span>

                                {%- if hourEvents is not empty -%}
                                    <div class="day-badges">
                                        {%- for hourEvent in hourEvents -%}
                                            <span class="day-badge"
                                                  data-general-type="{{ hourEvent.type.value }}"></span>
                                        {%- endfor -%}
                                    </div>
                                {%- endif -%}
                            </{% if isGranted %}a{% else %}div{% endif %}>
                        {%- endfor -%}
                    </div>
                </article>
            {%- endfor -%}
        </div>
    </section>
{%- endblock %}
