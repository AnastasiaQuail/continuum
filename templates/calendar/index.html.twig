{% extends 'base.html.twig' %}

{% block title %}Calendar {{ year }}{% endblock %}
{% block body_id %}calendar{% endblock %}

{% block main -%}
    {%- set currentDate = date('now', app.user.timezone) -%}
    {%- set current = currentDate.format('Y-m-d') -%}
    {%- set currentMonth = currentDate.format('Y-m') -%}

    {% if upcomingNotifications is not empty %}
        <section class="card calendar calendar-upcoming-notification">
            {% for upcomingNotification in upcomingNotifications %}
                <div class="notification-text" data-event-type="{{ upcomingNotification.type.value }}">
                    <strong>{{ upcomingNotification.title }}</strong> - {{ upcomingNotification.text }}
                </div>
            {% endfor %}
        </section>
    {% endif %}

    <nav class="calendar-pagination">
        <a class="page-link page-link-prev" href="{{ path('app_calendar', {'year': year - 1}) }}">
            {{ ux_icon('lucide:chevron-right') }}
            <span>{{ year - 1 }}</span>
        </a>
        <h2>{{ year }}</h2>
        <a class="page-link page-link-next" href="{{ path('app_calendar', {'year': year + 1}) }}">
            <span>{{ year + 1 }}</span>
            {{ ux_icon('lucide:chevron-right') }}
        </a>
    </nav>

    <section class="card card-calendar">
        <div class="calendar">
            {%- for monthNumber in 1..12 -%}
                {%- set month = year ~ '-' ~ (monthNumber < 10 ? '0') ~ monthNumber -%}
                {%- set firstDay = month ~ '-01' -%}
                {%- set firstWeekDay = firstDay|date('N') -%}

                <div class="month {{- currentMonth == month ? ' month-current' }}">
                    <div class="month-title">{{ month|date('F') }}</div>
                    <div class="month-days">
                        {%- if firstWeekDay > 1 -%}
                            <div class="day fake-day" style="--fake-days: {{ firstWeekDay - 1 }}">
                                <span>1</span>
                            </div>
                        {%- endif -%}

                        {%- for dayNumber in 1..firstDay|date('t') -%}
                            {%- set day = month ~ '-' ~ (dayNumber < 10 ? '0') ~ dayNumber -%}

                            {%- set dayEvent = events[day] is defined ? events[day].dayEvent : null -%}
                            {%- set hourEvents = events[day] is defined ? events[day].hourEvents : [] -%}

                            <div
                                class="day {{- day < current ? ' day-past' -}} {{- day == current ? ' day-current' -}} {{- day < startDay|date('Y-m-d') ? ' day-inactive' -}}"
                                {%- if dayEvent is not null %}data-event-type="{{ dayEvent.type.value }}"{% endif -%}
                                data-id="{{ day }}">
                                <span>{{ dayNumber }}</span>

                                {%- if hourEvents is not empty -%}
                                    <div class="day-badges">
                                        {%- for hourEvent in hourEvents -%}
                                            <span class="day-badge" data-event-type="{{ hourEvent.type.value }}"></span>
                                        {%- endfor -%}
                                    </div>
                                {%- endif -%}
                            </div>
                        {%- endfor -%}
                    </div>
                </div>
            {%- endfor -%}
        </div>
    </section>
{%- endblock %}
