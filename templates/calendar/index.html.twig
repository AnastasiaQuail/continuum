{% extends 'base.html.twig' %}

{%- block javascripts -%}
    {{ parent() }}
    <script src="{{ asset('js/calendar.js') }}"></script>
{%- endblock -%}

{% block title %}Calendar{% endblock %}
{% block page_subtitle %}{{ year }}{% endblock %}
{% block body_id %}calendar{% endblock %}

{% block showcase -%}
    {%- if upcoming_events is not empty and is_granted('CALENDAR_UPCOMING_EVENTS') -%}
        <section class="card calendar-upcoming-events" id="calendar-upcoming-events">
            {{- include('calendar/_upcoming_events.html.twig', {collapsable: true}) -}}
        </section>
    {%- endif -%}
{%- endblock %}

{% block body_actions -%}
    <div class="body-actions actions-pagination">
        {{ include('default/_pagination.html.twig', {
            prev: {
                url: path('app_calendar', {year: year - 1}),
                label: year - 1,
                is_granted: year > app_year_min,
            },
            next: {
                url: path('app_calendar', {year: year + 1}),
                label: year + 1,
                is_granted: year < app_year_max,
            },
        }) }}
    </div>
{%- endblock %}

{% block main -%}
    <section class="card card-calendar">
        <div class="calendar">
            {%- set start_date = start_day.format('Y-m-d') -%}
            {%- set current_date = user_date() -%}
            {%- set current_month = current_date.format('Y-m') -%}
            {%- set current = current_date.format('Y-m-d') -%}
            {%- set is_granted = is_granted('CALENDAR_EDIT') -%}

            {%- for month_number in 1..12 -%}
                {%- set month = year ~ '-' ~ (month_number < 10 ? '0') ~ month_number -%}
                {%- set first_day = month ~ '-01' -%}
                {%- set first_week_day = first_day|date('N') -%}

                <article class="month {{ month === current_month ? ' month-current' }}"
                         style="--month-offset: {{ first_week_day - 1 }};">
                    <div class="month-title">{{ month|date('F') }}</div>
                    <div class="month-days">
                        {%- if first_week_day > 1 -%}
                            <div class="day fake-day" style="--fake-days: {{ first_week_day - 1 }};">
                                <span>1</span>
                            </div>
                        {%- endif -%}

                        {%- for day_number in 1..first_day|date('t') -%}
                            {%- set day = month ~ '-' ~ (day_number < 10 ? '0') ~ day_number -%}
                            {%- set day_event = events[day] is defined ? events[day].dayEvent : null -%}
                            {%- set hour_events = events[day] is defined ? events[day].hourEvents : [] -%}

                            <{% if is_granted %}a{% else %}div{% endif %}
                                {% if is_granted %}href="{{ path('app_calendar_day', {day: day}) }}"{% endif %}
                                class="day {{- day < current ? ' day-past' -}} {{- day === current ? ' day-current' -}} {{- day < start_date ? ' day-inactive' -}} {{- day|is_weekend ? ' day-weekend' -}}"
                                {%- if day_event !== null %}data-general-type="{{ day_event.type.value }}"{% endif -%}>
                                <span>{{ day_number }}</span>

                                {%- if hour_events is not empty -%}
                                    <div class="day-badges">
                                        {%- for hour_event in hour_events -%}
                                            <span class="day-badge"
                                                  data-general-type="{{ hour_event.type.value }}"></span>
                                        {%- endfor -%}
                                    </div>
                                {%- endif -%}
                            </{% if is_granted %}a{% else %}div{% endif %}>
                        {%- endfor -%}
                    </div>
                </article>
            {%- endfor -%}
        </div>
    </section>
{%- endblock %}
