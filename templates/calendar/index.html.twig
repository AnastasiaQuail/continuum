{% extends 'base.html.twig' %}

{%- block javascripts -%}
    {{ parent() }}
    <script src="{{ asset('js/calendar.js') }}"></script>
{%- endblock -%}

{% block title %}Calendar{% endblock %}
{% block page_subtitle %}{{ year }}{% endblock %}
{% block body_id %}calendar{% endblock %}

{% block header_actions -%}
    {%- set new_event_day = user_date('+1 day').format('Y-m-d') -%}

    <twig:HeaderAction text="Add event" href="{{ path('app_calendar_day', {day: new_event_day}) }}"
                       isGranted="{{ is_granted('CALENDAR_EDIT', new_event_day) }}"/>
{%- endblock %}

{% block showcase -%}
    {%- if upcoming_events is not empty and is_granted('CALENDAR_UPCOMING_EVENTS') -%}
        <twig:Card class="card-calendar-upcoming-events" id="card-calendar-upcoming-events">
            {{- include('calendar/_upcoming_events.html.twig', {collapsable: true}) -}}
        </twig:Card>
    {%- endif -%}
{%- endblock %}

{% block body_pagination_actions -%}
    <twig:Pagination:Prev href="{{ path('app_calendar', {year: year - 1}) }}"
                          isGranted="{{ year > app_year_min }}"
                          label="{{ year - 1 }}"/>

    <twig:Pagination:Next href="{{ path('app_calendar', {year: year + 1}) }}"
                          isGranted="{{ year < app_year_max }}"
                          label="{{ year + 1 }}"/>
{%- endblock %}

{% block main -%}
    <twig:Card class="card-calendar">
        {%- set start_date = start_day.format('Y-m-d') -%}
        {%- set current_day = user_date().format('Y-m-d') -%}

        <twig:Caledar year="{{ year }}">
            {# "day" is an internal string in the "Y-m-d" format #}
            {%- set day_events = events[day] is defined ? events[day].dayEvents : [] -%}
            {%- set main_event = day_events|first -%}
            {%- set hour_events = events[day] is defined ? events[day].hourEvents : [] -%}

            <twig:Calendar:Day day="{{ day }}"
                               href="{{ path('app_calendar_day', {day: day}) }}"
                               hasPopover
                               isGranted="{{ is_granted('CALENDAR_EDIT', day) }}"
                               color="{{ main_event ? main_event.type.value }}"
                               isInactive="{{ day < start_date }}"
                               isPast="{{ day < current_day }}"
                               isCurrent="{{ day === current_day }}"
                               isWeekend="{{ day|is_weekend }}">
                {%- for hour_event in hour_events -%}
                    <twig:Calendar:Badge color="{{ hour_event.type.value }}"/>
                {%- endfor -%}

                <twig:block name="popover_events">
                    {%- for event in day_events|merge(hour_events) -%}
                        <twig:Calendar:PopoverEvent event="{{ event }}"/>
                    {%- endfor -%}
                </twig:block>
            </twig:Calendar:Day>
        </twig:Caledar>
    </twig:Card>
{%- endblock %}
