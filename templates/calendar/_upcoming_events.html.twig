<div class="upcoming-events-body {{ (collapsable ?? false) ? 'collapsable' }}">
    {%- for upcoming_event in upcoming_events -%}
        <div class="upcoming-event-badge" data-general-type="{{ upcoming_event.type.value }}">
            <span class="badge">{{ upcoming_event.title }}</span>
            <span class="upcoming-event-text">- {{ upcoming_event.text -}}</span>
        </div>
    {%- endfor -%}

    {%- if collapsable ?? false -%}
        <div class="upcoming-event-arrow">{{ ux_icon('lucide:chevron-down') }}</div>
    {%- endif -%}
</div>
