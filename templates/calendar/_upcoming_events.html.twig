<div class="upcoming-events-body {{ (collapsable ?? false) ? 'collapsable' }}">
    {%- for upcoming_event in upcoming_events -%}
        <div class="upcoming-event-text" data-general-type="{{ upcoming_event.type.value }}">
            <strong>{{ upcoming_event.title }}</strong>
            <span>- {{ upcoming_event.text -}}</span>
        </div>
    {%- endfor -%}

    {%- if collapsable ?? false -%}
        <div class="upcoming-event-arrow">{{ ux_icon('lucide:chevron-right') }}</div>
    {%- endif -%}
</div>
