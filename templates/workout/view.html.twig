{% extends 'base.html.twig' %}

{%- block javascripts -%}
    {{ parent() }}
    <script src="{{ asset('js/workout.js') }}"></script>
{%- endblock -%}

{% set date = workout.date.setTimezone(app.user.timezone) %}

{% block title %}Workout on {{ date.format('j F Y') }}{% endblock %}
{% block page_title %}{{ date.format('j F Y, H:i') }}{% endblock %}
{% block body_id %}workout-view{% endblock %}

{% set breadcrumbs = [
    {label: 'Workouts', url: path('app_workouts', {month: date.format('Y-m')})},
    {label: 'Edit'},
] %}

{% block main -%}
    <section class="card">
        <h2 class="card-title">Workout exercises</h2>

        <div class="workout-exercises-edit">
            {%- for workout_exercise in workout.workoutExercises -%}
                <div class="workout-exercise">
                    <div class="exercise {{ workout_exercise.description !== '' ? 'exercise-description-show' }}"
                         data-general-type="{{ workout_exercise.exercise.group.color.value }}">
                        <div class="exercise-name">{{ workout_exercise.exercise.name }}</div>

                        {%- set is_update_granted = is_granted('WORKOUT_EXERCISE_UPDATE', workout_exercise) -%}

                        <div class="exercise-controls">
                            <button class="btn btn-link btn-description-show"
                                    {% if not is_update_granted %}disabled{% endif %}>
                                {{- ux_icon('lucide:message-circle-more') -}}
                            </button>

                            {%- if workout_exercise.sets.isEmpty -%}
                                <form method="post"
                                      action="{{ path('app_workout_exercise_delete', {id: workout_exercise.id}) }}"
                                      onsubmit="return confirm('Delete?') && submitBy(this);">
                                    <input type="hidden" name="_method" value="DELETE">
                                    <button
                                        class="btn btn-danger btn-link"
                                        {% if is_granted('WORKOUT_EXERCISE_DELETE', workout_exercise) %}type="submit"
                                        {% else %}disabled{% endif %}>
                                        {{- ux_icon('lucide:trash') -}}
                                        {{- ux_icon('lucide:loader-circle', {class: 'submit-loader'}) -}}
                                    </button>
                                </form>
                            {%- endif -%}
                        </div>

                        <div class="exercise-description">
                            <form method="post"
                                  action="{{ path('app_workout_exercise_update', {id: workout_exercise.id}) }}"
                                  onsubmit="return submitBy(this);">
                                <input type="hidden" name="_method" value="PATCH">
                                <label for="description"></label>
                                <input class="form-control" type="text" id="description" name="description"
                                       maxlength="255" value="{{ workout_exercise.description }}"
                                       placeholder="Add description...">
                                <button class="btn btn-transparent" {% if is_update_granted %}type="submit"
                                        {% else %}disabled{% endif %}>
                                    {{- ux_icon('lucide:message-circle-plus') -}}
                                    {{- ux_icon('lucide:loader-circle', {class: 'submit-loader'}) -}}
                                </button>
                            </form>
                        </div>
                    </div>

                    <div class="workout-exercise-sets">
                        {%- for workout_set in workout_exercise.sets -%}
                            <div class="workout-exercise-set workout-exercise-set-exists">
                                <div class="workout-exercise-set-fields">
                                    <div class="workout-exercise-set-weight">
                                        <span>{{ workout_set.weight }}</span>
                                        <span>kg</span>
                                    </div>
                                    <div class="workout-exercise-set-reps">{{ workout_set.reps }}</div>
                                </div>
                                <div class="workout-exercise-set-warmup {{ workout_set.isWarmup ? 'active' }}">
                                    {{- ux_icon('lucide:battery-charging') -}}
                                </div>
                                <div class="workout-exercise-set-controls">
                                    <form method="post"
                                          action="{{ path('app_workout_set_delete', {id: workout_set.id}) }}"
                                          onsubmit="return confirm('Delete?') && submitBy(this);">
                                        <input type="hidden" name="_method" value="DELETE">
                                        <button
                                            class="btn btn-danger btn-link"
                                            {% if is_granted('WORKOUT_SET_DELETE', workout_set) %}type="submit"
                                            {% else %}disabled{% endif %}>
                                            {{- ux_icon('lucide:trash') -}}
                                            {{- ux_icon('lucide:loader-circle', {class: 'submit-loader'}) -}}
                                        </button>
                                    </form>
                                </div>
                            </div>
                        {%- endfor -%}

                        {%- if is_granted('WORKOUT_SET_CREATE', workout_exercise) -%}
                            {%- set exercise_id = workout_exercise.exercise.id.toString -%}
                            {%- set prev_workout_exercise = prev_workout_exercises[exercise_id] is defined ? prev_workout_exercises[exercise_id] : null -%}

                            {%- set last_set = workout_exercise.sets|last -%}
                            {%- if not last_set and prev_workout_exercise -%}
                                {%- set last_set = prev_workout_exercise.sets|first -%}
                            {%- endif -%}

                            <div class="workout-exercise-set workout-exercise-set-new">
                                <form method="post"
                                      action="{{ path('app_workout_set_create', {id: workout_exercise.id}) }}"
                                      onsubmit="return submitBy(this);">
                                    <label for="weight"></label>
                                    <label for="reps"></label>
                                    <div class="workout-exercise-set-fields">
                                        <input class="form-control" type="number" id="weight" name="weight"
                                               value="{{ last_set?.weight ?? 0 }}" autocomplete="off"
                                               {%- if loop.last -%}autofocus="autofocus"{%- endif -%}
                                               min="0" max="199" step="0.1" required="required" data-mask="postfix"
                                               data-postfix="kg">
                                        <input class="form-control" type="number" id="reps" name="reps"
                                               value="{{ last_set?.reps ?? 1 }}" autocomplete="off"
                                               min="1" max="99" step="1" required="required">
                                    </div>
                                    <div class="workout-exercise-set-warmup form-control-choose-type-group">
                                        <label class="form-control-choose-type">
                                            <input type="checkbox" name="warmup"
                                                {% if last_set?.isWarmup ?? false %} checked="checked"{% endif %}>
                                            <span class="btn">
                                            {{- ux_icon('lucide:battery-charging') -}}
                                            <span>Is warmup</span>
                                        </span>
                                        </label>
                                    </div>
                                    <div class="workout-exercise-set-controls">
                                        <button class="btn btn-primary btn-transparent" type="submit">
                                            {{- ux_icon('lucide:plus') -}}
                                            {{- ux_icon('lucide:loader-circle', {class: 'submit-loader'}) -}}
                                        </button>
                                    </div>
                                </form>
                            </div>

                            {%- if prev_workout_exercise -%}
                                <div class="workout-exercise-set workout-exercise-set-prev">
                                    {%- for prev_set in prev_workout_exercise.sets -%}
                                        <div class="workout-exercise-prev {{ prev_set.isWarmup ? 'prev-warmup' }}">
                                            {%- if prev_set.weight > 0 -%}
                                                <span>{{ prev_set.weight }}<small>kg</small></span>
                                            {%- endif -%}
                                            <span><small>x</small>{{ prev_set.reps }}</span>
                                        </div>
                                    {%- endfor -%}

                                    {%- if prev_workout_exercise.description !== '' -%}
                                        <div class="workout-exercise-prev prev-description">
                                            {{- prev_workout_exercise.description -}}
                                        </div>
                                    {%- endif -%}
                                </div>
                            {%- endif -%}
                        {%- endif -%}
                    </div>
                </div>
            {%- endfor -%}

            {%- if is_granted('WORKOUT_EXERCISE_CREATE', workout) -%}
                <div class="workout-exercise workout-exercise-new">
                    {%- if workout.workoutExercises is not empty -%}
                        {%- set first_group = (workout.workoutExercises|last).exercise.group -%}
                    {%- else -%}
                        {%- set first_group = exercise_groups|first -%}
                    {%- endif -%}

                    <div class="exercise" data-general-type="{{ first_group.color.value }}" data-tabs>
                        <label class="exercise-title" for="exercise_id">Start new exercise:</label>

                        <div class="exercise-tabs">
                            {%- for exercise_group in exercise_groups -%}
                                <button class="btn btn-link {{- exercise_group === first_group ? ' active' }}"
                                        data-general-type="{{ exercise_group.color.value }}"
                                        data-tab-id="{{ exercise_group.value }}">
                                    {{- exercise_group.name -}}
                                </button>
                            {%- endfor -%}
                        </div>

                        <div class="exercise-tab-contents">
                            {%- for exercise_group in exercise_groups -%}
                                <div class="exercise-content {{- exercise_group === first_group ? ' active' }}"
                                     data-tab-content-id="{{ exercise_group.value }}">
                                    <form method="post"
                                          action="{{ path('app_workout_exercise_create', {id: workout.id}) }}">
                                        <select class="form-control" id="exercise_id" name="exercise"
                                                required="required" onchange="return submitBy(this);">
                                            <option value="" disabled selected hidden>Choose exercise...</option>
                                            {%- for exercise in exercises -%}
                                                {%- if exercise_group === exercise.group -%}
                                                    <option value="{{ exercise.id }}">
                                                        {{- exercise.name -}}
                                                    </option>
                                                {%- endif -%}
                                            {%- endfor -%}
                                        </select>
                                        <div class="select-submit-loader">{{ ux_icon('lucide:loader-circle') }}</div>
                                    </form>
                                </div>
                            {%- endfor -%}
                        </div>
                    </div>
                </div>
            {%- endif -%}
        </div>
    </section>
{%- endblock %}
