{% extends 'base.html.twig' %}

{% set date = workout.date.setTimezone(app.user.timezone) %}

{% block title %}Workout on {{ date.format('j F Y') }}{% endblock %}
{% block page_title %}{{ date.format('j F Y, H:i') }}{% endblock %}
{% block body_id %}workout-view{% endblock %}

{% set breadcrumbs = [
    { label: 'Workouts', url: path('app_workouts', {month: date.format('Y-m')}) },
    { label: 'Edit' },
] %}

{% block main -%}
    <section class="card">
        <h2 class="card-title">Workout exercises</h2>

        <div class="workout-exercises-edit">
            {%- for workoutExercise in workout.workoutExercises -%}
                <div class="workout-exercise">
                    <div class="exercise" data-general-type="{{ workoutExercise.exercise.group.color.value }}">
                        <div class="exercise-name">{{ workoutExercise.exercise.name }}</div>
                        {%- if is_granted('WORKOUT_EXERCISE_DELETE', workoutExercise) -%}
                            <div class="exercise-controls">
                                <form method="post"
                                      action="{{ path('app_workout_exercise_delete', {'id': workoutExercise.id}) }}"
                                      onsubmit="return confirm('Delete?')">
                                    <input type="hidden" name="_method" value="DELETE">
                                    <button class="btn btn-danger btn-link"
                                            type="submit">{{ ux_icon('lucide:trash') }}</button>
                                </form>
                            </div>
                        {%- endif -%}
                    </div>

                    <div class="workout-exercise-sets">
                        {%- for workoutSet in workoutExercise.sets -%}
                            <div class="workout-exercise-set workout-exercise-set-exists">
                                <div class="workout-exercise-set-fields">
                                    <div class="workout-exercise-set-weight">
                                        <span>{{ workoutSet.weight }}</span>
                                        <span>kg</span>
                                    </div>
                                    <div class="workout-exercise-set-reps">{{ workoutSet.reps }}</div>
                                </div>
                                <div class="workout-exercise-set-warmup {{ workoutSet.isWarmup ? 'active' }}">
                                    {{- ux_icon('lucide:battery-charging') -}}
                                </div>
                                {%- if is_granted('WORKOUT_SET_DELETE', workoutSet) -%}
                                    <div class="workout-exercise-set-controls">
                                        <form method="post"
                                              action="{{ path('app_workout_set_delete', {'id': workoutSet.id}) }}"
                                              onsubmit="return confirm('Delete?')">
                                            <input type="hidden" name="_method" value="DELETE">
                                            <button class="btn btn-danger btn-link"
                                                    type="submit">{{ ux_icon('lucide:trash') }}</button>
                                        </form>
                                    </div>
                                {%- endif -%}
                            </div>
                        {%- endfor -%}

                        {%- if is_granted('WORKOUT_SET_CREATE', workoutExercise) -%}
                            <div class="workout-exercise-set workout-exercise-set-new">
                                {%- set lastSet = workoutExercise.sets|last -%}
                                <form method="post"
                                      action="{{ path('app_workout_set_create', {'id': workoutExercise.id}) }}">
                                    <label for="weight"></label>
                                    <label for="reps"></label>
                                    <div class="workout-exercise-set-fields">
                                        <input class="form-control" type="number" id="weight" name="weight"
                                               value="{{ lastSet?.weight ?? 0 }}" autocomplete="off"
                                               {%- if loop.last -%}autofocus="autofocus"{%- endif -%}
                                               min="0" max="199" step="0.1" required data-mask="postfix"
                                               data-postfix="kg">
                                        <input class="form-control" type="number" id="reps" name="reps"
                                               value="{{ lastSet?.reps ?? 1 }}" autocomplete="off"
                                               min="1" max="99" step="1" required>
                                    </div>
                                    <div class="workout-exercise-set-warmup form-control-choose-type-group">
                                        <label class="form-control-choose-type">
                                            <input type="checkbox" name="warmup">
                                            <span class="btn">
                                            {{- ux_icon('lucide:battery-charging') -}}
                                            <span>Is warmup</span>
                                        </span>
                                        </label>
                                    </div>
                                    <div class="workout-exercise-set-controls">
                                        <button class="btn btn-primary btn-transparent" type="submit">
                                            {{- ux_icon('lucide:plus') -}}
                                        </button>
                                    </div>
                                </form>
                            </div>

                            {%- set exerciseId = workoutExercise.exercise.id.toString -%}
                            {%- if prevWorkoutExercises[exerciseId] is defined -%}
                                <div class="workout-exercise-set workout-exercise-set-prev">
                                    {%- for prevSet in prevWorkoutExercises[exerciseId].sets -%}
                                        <div class="workout-exercise-prev">
                                            {%- if prevSet.weight > 0 -%}
                                                <span>{{ prevSet.weight }}<small>kg</small></span>
                                            {%- endif -%}
                                            <span><small>x</small>{{ prevSet.reps }}</span>
                                        </div>
                                    {%- endfor -%}
                                </div>
                            {%- endif -%}
                        {%- endif -%}
                    </div>
                </div>
            {%- endfor -%}

            {%- if is_granted('WORKOUT_EXERCISE_CREATE', workout) -%}
                <div class="workout-exercise workout-exercise-new">
                    {%- if workout.workoutExercises is not empty -%}
                        {%- set firstGroup = (workout.workoutExercises|last).exercise.group -%}
                    {%- else -%}
                        {%- set firstGroup = exerciseGroups|first -%}
                    {%- endif -%}

                    <div class="exercise" data-general-type="{{ firstGroup.color.value }}" data-tabs>
                        <label class="exercise-title" for="exercise_id">Start new exercise:</label>

                        <div class="exercise-tabs">
                            {%- for exerciseGroup in exerciseGroups -%}
                                <button class="btn btn-link {{- exerciseGroup === firstGroup ? ' active' }}"
                                        data-general-type="{{ exerciseGroup.color.value }}"
                                        data-tab-id="{{ exerciseGroup.value }}">
                                    {{- exerciseGroup.name -}}
                                </button>
                            {%- endfor -%}
                        </div>

                        <div class="exercise-tab-contents">
                            {%- for exerciseGroup in exerciseGroups -%}
                                <div class="exercise-content {{- exerciseGroup === firstGroup ? ' active' }}"
                                     data-tab-content-id="{{ exerciseGroup.value }}">
                                    <form method="post"
                                          action="{{ path('app_workout_exercise_create', {'id': workout.id}) }}">
                                        <select class="form-control" id="exercise_id" name="exercise" required
                                                onchange="return submitBy(this);">
                                            <option value="" disabled selected hidden>Choose exercise...</option>
                                            {%- for exercise in exercises -%}
                                                {%- if exerciseGroup === exercise.group -%}
                                                    <option value="{{ exercise.id }}">
                                                        {{- exercise.name|capitalize -}}
                                                    </option>
                                                {%- endif -%}
                                            {%- endfor -%}
                                        </select>
                                        <div class="exercise-controls">{{ ux_icon('lucide:loader-circle') }}</div>
                                    </form>
                                </div>
                            {%- endfor -%}
                        </div>
                    </div>
                </div>
            {%- endif -%}
        </div>
    </section>
{%- endblock %}
