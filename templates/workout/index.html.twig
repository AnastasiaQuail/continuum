{% extends 'base.html.twig' %}

{% set current_date = user_date() %}
{% set is_current_year = month.format('Y') === current_date.format('Y') %}

{% block title %}Workouts{% endblock %}
{% block page_subtitle %}{{ is_current_year ? month.format('F') : month.format('F Y') }}{% endblock %}
{% block body_id %}workouts{% endblock %}

{% block header_actions -%}
    <twig:HeaderAction text="{{ ux_icon('lucide:plus') }}" href="{{ path('app_workout_create') }}" method="post"
                       isGranted="{{ is_granted('WORKOUT_CREATE') }}"/>

    <twig:HeaderAction text="{{ ux_icon('lucide:gallery-vertical-end') }}" href="{{ path('app_exercises') }}"
                       isGranted="{{ is_granted('EXERCISE_VIEW') }}"/>
{%- endblock %}

{% block body_pagination_actions -%}
    {%- set prev_month = month.modify('-1 month') -%}
    <twig:Pagination:Prev href="{{ path('app_workouts', {month: prev_month.format('Y-m')}) }}"
                          isGranted="{{ prev_month.format('Y') >= app_year_min and is_granted('WORKOUT_VIEW', prev_month) }}"
                          label="{{ prev_month.format('F') }}"/>

    {%- set next_month = month.modify('+1 month') -%}
    <twig:Pagination:Next href="{{ path('app_workouts', {month: next_month.format('Y-m')}) }}"
                          isGranted="{{ current_date.format('Y-m') >= next_month.format('Y-m') }}"
                          label="{{ next_month.format('F') }}"/>
{%- endblock %}

{% block main -%}
    <twig:Card isTransparent class="card-calendar-month">
        {%- set workout_map = [] -%}
        {%- for workout in workouts -%}
            {%- set day = workout.date.setTimezone(app.user.timezone).format('Y-m-d') -%}
            {%- set workout_map = workout_map|merge({(day): workout}) -%}
        {%- endfor -%}

        {%- set current_day = current_date.format('Y-m-d') -%}

        <twig:Caledar onlyMonth="{{ month }}" isShort onlyBadges>
            {# "day" is an internal string in the "Y-m-d" format #}
            {%- set workout = workout_map[day] is defined ? workout_map[day] : null -%}

            <twig:Calendar:Day day="{{ day }}"
                               color="{{ workout !== null ? 'green' }}"
                               isCurrent="{{ day === current_day }}"
                               isWeekend="{{ day|is_weekend }}">
                {%- for workout_exercise in workout?.workoutExercises -%}
                    <twig:Calendar:Badge color="{{ workout_exercise.exercise.group.color.value }}"/>
                {%- endfor -%}
            </twig:Calendar:Day>
        </twig:Caledar>
    </twig:Card>

    {%- if workouts is empty -%}
        <twig:CardEmptyCollection message="No workouts this month yet"/>
    {%- elseif month.format('Y-m') === current_date.format('Y-m') -%}
        {%- set last_workout_date = (workouts|last).date.setTimezone(app.user.timezone) -%}
        {%- set days = current_date.format('d') - last_workout_date.format('d') -%}

        {%- if days > 3 -%}
            <div class="alert alert-warning alert-inline">
                {{ ux_icon('lucide:clock-alert') }}
                <span><strong>{{ days }} days</strong> since the last workout</span>
            </div>
        {%- endif -%}
    {%- endif -%}

    {%- for workout in workouts|reverse -%}
        <div class="card-container card-container-workout card-container-collapse">
            <twig:CardForm class="card-workout" id="workout_{{ workout.id }}">
                <twig:Form:RowField isHeader href="{{ path('app_workouts_view', {id: workout.id}) }}"
                                    isGranted="{{ is_granted('WORKOUT_EDIT', workout) }}"
                                    label="{{ workout.date.setTimezone(app.user.timezone).format('j F, H:i') }}"/>

                {%- if workout.workoutExercises.empty -%}
                    <twig:Form:RowEmptyCollection message="No exercises yet"/>
                {%- endif -%}

                {%- for workout_exercise in workout.workoutExercises -%}
                    {%- set id = workout_exercise.id.toString -%}
                    {%- set exercise = workout_exercise.exercise -%}
                    {%- set sets = workout_exercise.sets -%}
                    {%- set work_sets = sets|filter(set => not set.isWarmup) -%}

                    <twig:Form:RowField isCompact isLarge data-general-type="{{ exercise.group.color.value }}">
                        <twig:block name="label">
                            <span class="form-label-name">{{ exercise.name }}</span>

                            <div class="form-label-legend">
                                {%- if work_sets is not empty -%}
                                    <span class="form-label-reps">{{ work_sets|length }} reps</span>

                                    {%- if progresses[id] is defined -%}
                                        {%- set progress = progresses[id] -%}

                                        {%- if progress.change.value !== 'unchanged' -%}
                                            <span class="form-label-progress" data-change="{{ progress.change.value }}">
                                            {{- progress.percent -}}%
                                            {{- ux_icon('lucide:trending-up') -}}
                                        </span>
                                        {%- endif -%}
                                    {%- endif -%}
                                {%- endif -%}
                            </div>
                        </twig:block>

                        <twig:block name="field">
                            <div class="form-workout-sets">
                                {%- if sets is empty -%}
                                    <twig:Workout:SetEmptyCollection message="No reps yet"/>
                                {%- else -%}
                                    {%- for set in sets -%}
                                        <twig:Workout:Set set="{{ set }}"/>
                                    {%- endfor -%}
                                {%- endif -%}
                            </div>
                        </twig:block>

                        <twig:block name="footer">
                            {%- if workout_exercise.description !== '' -%}
                                <div class="form-workout-hint">{{ workout_exercise.description }}</div>
                            {%- endif -%}

                            {%- if sets|length > 1 -%}
                                {% set time_first = (sets|first).performedAt.timestamp %}
                                {% set time_last = (sets|last).performedAt.timestamp %}
                                {% set minutes = ((time_last - time_first) / 60)|round(0, 'ceil') %}

                                <div class="form-text">
                                    {{ ux_icon('lucide:timer') }} {{ minutes }} min.
                                </div>
                            {%- endif -%}
                        </twig:block>
                    </twig:Form:RowField>
                {%- endfor -%}
            </twig:CardForm>

            {%- set start = 0 -%}
            {%- set end = 0 -%}

            {%- for workout_exercise in workout.workoutExercises -%}
                {%- for exercise_set in workout_exercise.sets -%}
                    {%- if start === 0 or start > exercise_set.performedAt.timestamp -%}
                        {%- set start = exercise_set.performedAt.timestamp -%}
                    {%- endif -%}
                    {%- if end < exercise_set.performedAt.timestamp -%}
                        {%- set end = exercise_set.performedAt.timestamp -%}
                    {%- endif -%}
                {%- endfor -%}
            {%- endfor -%}

            {%- set total_minutes = ((end - start) / 60)|round -%}
            {%- set hours = (total_minutes / 60)|round(0, 'floor') -%}
            {%- set minutes = total_minutes - hours * 60 -%}

            {%- if workout.workoutExercises is not empty -%}
                <twig:Card:Description class="card-description-workout">
                    <twig:Card:DescriptionLine type="column">
                        {%- if total_minutes -%}
                            {% if hours > 0 %}{{ hours }} {{ hours > 1 ? 'hours' : 'hour' }}{% endif %}
                            {{ minutes > 9 ? minutes : '0' ~ minutes }} minutes
                        {%- endif -%}
                    </twig:Card:DescriptionLine>
                    <twig:Card:DescriptionLine type="column" class="card-description-toggler"
                                               onclick="this.closest('.card-container').classList.toggle('card-container-collapse'); return false;">
                        <span class="toggler-unfold">Show details {{ ux_icon('lucide:unfold-vertical') }}</span>
                        <span class="toggler-fold">Hide details {{ ux_icon('lucide:fold-vertical') }}</span>
                    </twig:Card:DescriptionLine>
                </twig:Card:Description>
            {%- endif -%}
        </div>
    {%- endfor -%}
{%- endblock %}
