{% extends 'base.html.twig' %}

{% set is_current_year = month.format('Y') === user_date().format('Y') %}

{% block title %}Workouts{% endblock %}
{% block page_subtitle %}{{ is_current_year ? month.format('F') : month.format('F Y') }}{% endblock %}
{% block body_id %}workouts{% endblock %}

{% block header_actions -%}
    <form method="post" action="{{ path('app_workout_create') }}">
        <button
            class="btn btn-glass"
            {% if is_granted('WORKOUT_CREATE') %}type="submit"{% else %} disabled{% endif %}>
            {{- ux_icon('lucide:plus') -}}
        </button>
    </form>

    {%- set is_granted = is_granted('EXERCISE_VIEW') -%}

    <{% if is_granted %}a{% else %}button{% endif %}
        {% if is_granted %} href="{{ path('app_exercises') }}"{% else %} disabled{% endif %}
        class="btn btn-glass">
        {{- ux_icon('lucide:gallery-vertical-end') -}}
    </{% if is_granted %}a{% else %}button{% endif %}>
{%- endblock %}

{% block body_actions -%}
    <div class="body-actions actions-pagination">
        {% set prev_month = month.modify('-1 month') %}
        {% set next_month = month.modify('+1 month') %}

        {{ include('default/_pagination.html.twig', {
            prev: {
                url: path('app_workouts', {month: prev_month.format('Y-m')}),
                label: prev_month.format('F'),
                is_granted: prev_month.format('Y') >= app_year_min and is_granted('WORKOUT_VIEW', prev_month),
            },
            next: {
                url: path('app_workouts', {month: next_month.format('Y-m')}),
                label: next_month.format('F'),
                is_granted: user_date().format('Y-m') >= next_month.format('Y-m'),
            },
        }) }}
    </div>
{%- endblock %}

{% block main -%}
    <section class="card card-transparent card-calendar-month">
        <div class="calendar calendar-month calendar-month-short calendar-badges">
            <article class="month">
                {%- set current = user_date().format('Y-m-d') -%}
                {%- set first_week_day = month.format('N') -%}

                <div class="month-day-title">
                    {%- for day_title in ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'] -%}
                        <span>{{ day_title }}</span>
                    {%- endfor -%}
                </div>
                <div class="month-days">
                    {%- if first_week_day > 1 -%}
                        <div class="day fake-day" style="--fake-days: {{ first_week_day - 1 }};">
                            <span>1</span>
                        </div>
                    {%- endif -%}

                    {%- set workout_map = [] -%}

                    {%- for workout in workouts -%}
                        {%- set day = workout.date.setTimezone(app.user.timezone).format('Y-m-d') -%}
                        {%- set workout_map = workout_map|merge({(day): workout}) -%}
                    {%- endfor -%}

                    {%- for day_number in 1..month.format('t') -%}
                        {%- set day = month.format('Y-m-') ~ (day_number < 10 ? '0') ~ day_number -%}
                        {%- set workout = workout_map[day] is defined ? workout_map[day] : null -%}

                        <div
                            class="day {{- day === current ? ' day-current' -}} {{- day|is_weekend ? ' day-weekend' -}}"
                            {%- if workout !== null %}data-general-type="green"{% endif -%}>
                            <span>{{ day_number }}</span>

                            {%- if workout !== null -%}
                                <div class="day-badges">
                                    {%- for workout_exercise in workout.workoutExercises -%}
                                        <span class="day-badge"
                                              data-general-type="{{ workout_exercise.exercise.group.color.value }}"></span>
                                    {%- endfor -%}
                                </div>
                            {%- endif -%}
                        </div>
                    {%- endfor -%}
                </div>
            </article>
        </div>
    </section>

    {%- if workouts is empty -%}
        <div class="card collection-empty">
            {{- ux_icon('lucide:frown') -}}
            <span>No workouts this month yet</span>
        </div>
    {%- endif -%}

    {%- for workout in workouts|reverse -%}
        <section class="card card-form card-workout" id="workout_{{ workout.id }}">
            {%- set is_granted = is_granted('WORKOUT_EDIT', workout) -%}
            {%- set time = workout.date.setTimezone(app.user.timezone).format('j F, H:i') -%}

            <{% if is_granted %}a{% else %}div{% endif %}
                {% if is_granted %}href="{{ path('app_workouts_view', {id: workout.id}) }}"{% endif %}
                class="form-row form-row-header-edit">
                <div class="form-label">{{ time }}</div>
                <div class="form-field">{{ ux_icon('lucide:square-pen') }}</div>
            </{% if is_granted %}a{% else %}div{% endif %}>

            {%- if workout.workoutExercises.empty -%}
                <div class="form-row form-row-collection-empty">
                    <div class="collection-empty">
                        {{- ux_icon('lucide:frown') -}}
                        <span>No exercises yet</span>
                    </div>
                </div>
            {%- endif -%}

            {%- for workout_exercise in workout.workoutExercises -%}
                {%- set id = workout_exercise.id.toString -%}
                {%- set exercise = workout_exercise.exercise -%}
                {%- set sets = workout_exercise.sets -%}

                <div class="form-row form-row-compact" data-general-type="{{ exercise.group.color.value }}">
                    <div class="form-label">
                        <span>{{ exercise.name }}</span>

                        {%- if sets|filter(set => not set.isWarmup) is not empty and progresses[id] is defined -%}
                            {%- set progress = progresses[id] -%}

                            {%- if progress.change.value !== 'unchanged' -%}
                                <span class="form-label-progress" data-change="{{ progress.change.value }}">
                                    {{- progress.percent -}}%
                                    {{- ux_icon('lucide:trending-up') -}}
                                </span>
                            {%- endif -%}
                        {%- endif -%}
                    </div>

                    <div class="form-field-large form-workout-sets">
                        {%- if sets is empty -%}
                            <div class="workout-set collection-empty">No reps yet</div>
                        {%- else -%}
                            {%- for set in sets -%}
                                <div class="workout-set {{ set.isWarmup ? 'set-warmup' }}">
                                    {%- if set.weight > 0 -%}
                                        <div class="workout-set-field set-weight">
                                            <span>{{ set.weight }}</span>
                                            <span>kg</span>
                                        </div>
                                    {%- endif -%}
                                    <div class="workout-set-field set-reps">
                                        <span>{{ set.reps }}</span>
                                        <span>x</span>
                                    </div>
                                </div>
                            {%- endfor -%}
                        {%- endif -%}
                    </div>

                    {%- if workout_exercise.description !== '' -%}
                        <div class="form-workout-hint">{{ workout_exercise.description }}</div>
                    {%- endif -%}
                </div>
            {%- endfor -%}
        </section>

        {%- set start = 0 -%}
        {%- set end = 0 -%}

        {%- for workout_exercise in workout.workoutExercises -%}
            {%- for exercise_set in workout_exercise.sets -%}
                {%- if start === 0 or start > exercise_set.performedAt.timestamp -%}
                    {%- set start = exercise_set.performedAt.timestamp -%}
                {%- endif -%}
                {%- if end < exercise_set.performedAt.timestamp -%}
                    {%- set end = exercise_set.performedAt.timestamp -%}
                {%- endif -%}
            {%- endfor -%}
        {%- endfor -%}

        {%- set total_minutes = ((end - start) / 60)|round -%}
        {%- set hours = (total_minutes / 60)|round(0, 'floor') -%}
        {%- set minutes = total_minutes - hours * 60 -%}

        <div class="card-description">
            <div>Duration:
                {% if hours > 0 %}{{ hours }} {{ hours > 1 ? 'hours' : 'hour' }}{% endif %}
                {{ minutes > 9 ? minutes : '0' ~ minutes }} minutes
            </div>
        </div>
    {%- endfor -%}
{%- endblock %}
