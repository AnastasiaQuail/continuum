{% extends 'base.html.twig' %}

{% block title %}Workouts{% endblock %}
{% block body_id %}workouts{% endblock %}

{% set breadcrumbs = [
    { label: 'Workouts' },
] %}

{% block page_links -%}
    {%- if is_granted('WORKOUT_CREATE') -%}
        <form method="post" action="{{ path('app_workout_create') }}">
            <button class="btn btn-primary btn-outline" type="submit">
                {{- ux_icon('lucide:biceps-flexed') -}}
                <span>Start workout</span>
            </button>
        </form>
    {%- endif -%}
    {%- if is_granted('EXERCISE_VIEW') -%}
        <a class="btn btn-primary btn-action" href="{{ path('app_exercises') }}">Exercises</a>
    {%- endif -%}
{%- endblock %}

{% block main -%}
    <section class="card">
        <div class="card-title card-title-controls">
            <h2>{{ month.format('F Y') }}</h2>

            {% set prevMonth = month.modify('-1 month') %}
            {% set nextMonth = month.modify('+1 month') %}
            {{ include('default/_pagination.html.twig', {
                'prev': {
                    url: path('app_workouts', {'month': prevMonth.format('Y-m')}),
                    label: prevMonth.format('F'),
                    isGranted: prevMonth.format('Y') >= app_year_min and is_granted('WORKOUT_VIEW', prevMonth),
                },
                'next': {
                    url: path('app_workouts', {'month': nextMonth.format('Y-m')}),
                    label: nextMonth.format('F'),
                    isGranted: user_date().format('Y-m') >= nextMonth.format('Y-m'),
                }
            }) }}
        </div>

        <div class="workouts">
            {%- if workouts is empty -%}
                <div class="workout collection-empty">
                    {{- ux_icon('lucide:frown') -}}
                    <span>No workouts</span>
                </div>
            {%- else -%}
                {%- for workout in workouts -%}
                    <div class="workout">
                        <div class="workout-date">
                            {%- set start = 0 -%}
                            {%- set end = 0 -%}

                            {%- for workoutExercise in workout.workoutExercises -%}
                                {%- for exerciseSet in workoutExercise.sets -%}
                                    {%- if start === 0 or start > exerciseSet.performedAt.timestamp -%}
                                        {%- set start = exerciseSet.performedAt.timestamp -%}
                                    {%- endif -%}
                                    {%- if end < exerciseSet.performedAt.timestamp -%}
                                        {%- set end = exerciseSet.performedAt.timestamp -%}
                                    {%- endif -%}
                                {%- endfor -%}
                            {%- endfor -%}

                            {%- set isGranted = is_granted('WORKOUT_EDIT', workout) -%}
                            {%- set time = workout.date.setTimezone(app.user.timezone).format('j F H:i') -%}
                            {%- set minutes = ((end - start) / 60)|round -%}

                            <{% if isGranted %}a{% else %}div{% endif %}
                                {% if isGranted %}href="{{ path('app_workouts_view', {id: workout.id}) }}"{% endif %}>
                                <span>{{ time }}</span>
                                <span>( {{ minutes }} min )</span>
                            </{% if isGranted %}a{% else %}div{% endif %}>
                        </div>
                        <div class="workout-exercises">
                            {%- if workout.workoutExercises.empty -%}
                                <div class="workout-exercise collection-empty">
                                    {{- ux_icon('lucide:frown') -}}
                                    <span>No exercises yet</span>

                                    {%- if is_granted('WORKOUT_DELETE', workout) -%}
                                        <form method="post"
                                              action="{{ path('app_workout_delete', {'id': workout.id}) }}"
                                              onsubmit="return confirm('Delete?')">
                                            <input type="hidden" name="_method" value="DELETE">
                                            <button class="btn btn-danger btn-sm btn-link"
                                                    type="submit">{{ ux_icon('lucide:trash') }}</button>
                                        </form>
                                    {%- endif -%}
                                </div>
                            {%- else -%}
                                {%- for workoutExercise in workout.workoutExercises -%}
                                    <div class="workout-exercise"
                                         style="--exercise-color: var({{ '--color-' ~ workoutExercise.exercise.group.color.value }});">
                                        <div class="workout-exercise-description">
                                            <div class="exercise-name">
                                                {{- workoutExercise.exercise.name|capitalize -}}
                                            </div>
                                            <div class="workout-exercise-duration">
                                                {%- set minutes = 0 -%}

                                                {%- if workoutExercise.sets is not empty -%}
                                                    {%- set start = (workoutExercise.sets|first).performedAt.timestamp -%}
                                                    {%- set end = (workoutExercise.sets|last).performedAt.timestamp -%}

                                                    {%- set minutes = ((end - start) / 60)|round + 1 -%}
                                                {%- endif -%}

                                                {{- minutes ~ ' min.' -}}
                                            </div>
                                        </div>
                                        <div class="workout-exercise-sets">
                                            {%- if workoutExercise.sets.empty -%}
                                                <div class="workout-exercise-set collection-empty">No reps yet</div>
                                            {%- else -%}
                                                {%- for exerciseSet in workoutExercise.sets -%}
                                                    <div
                                                        class="workout-exercise-set {{ exerciseSet.isWarmup ? 'set-warmup' }}">
                                                        {%- if exerciseSet.weight > 0 -%}
                                                            <div class="workout-exercise-set-weight">
                                                                <span>{{ exerciseSet.weight }}</span>
                                                                <span>kg</span>
                                                            </div>
                                                        {%- endif -%}
                                                        <div class="workout-exercise-set-reps">
                                                            <span>{{ exerciseSet.reps }}</span>
                                                            <span>x</span>
                                                        </div>
                                                    </div>
                                                {%- endfor -%}
                                            {%- endif -%}
                                        </div>
                                    </div>
                                {%- endfor -%}
                            {%- endif -%}
                        </div>
                    </div>
                {%- endfor -%}
            {%- endif -%}
        </div>
    </section>
{%- endblock %}
