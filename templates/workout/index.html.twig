{% extends 'base.html.twig' %}

{% block title %}Workouts{% endblock %}
{% block body_id %}workouts{% endblock %}

{% block page_links -%}
    <form method="post" action="{{ path('app_workout_create') }}">
        <button
            class="btn btn-primary btn-outline"
            {% if is_granted('WORKOUT_CREATE') %}type="submit" {% else %}disabled{% endif %}>
            {{- ux_icon('lucide:biceps-flexed') -}}
            <span>Start workout</span>
        </button>
    </form>

    {%- set is_granted = is_granted('EXERCISE_VIEW') -%}

    <{% if is_granted %}a{% else %}button{% endif %}
        {% if is_granted %} href="{{ path('app_exercises') }}"{% else %} disabled{% endif %}
        class="btn btn-primary btn-action">
        <span>Exercises</span>
    </{% if is_granted %}a{% else %}button{% endif %}>
{%- endblock %}

{% block main -%}
    <section id="workouts-card" class="card">
        <div class="card-title card-title-controls">
            <h2>{{ month.format('F Y') }}</h2>

            {% set prev_month = month.modify('-1 month') %}
            {% set next_month = month.modify('+1 month') %}
            {{ include('default/_pagination.html.twig', {
                prev: {
                    url: path('app_workouts', {month: prev_month.format('Y-m')}),
                    label: prev_month.format('F'),
                    is_granted: prev_month.format('Y') >= app_year_min and is_granted('WORKOUT_VIEW', prev_month),
                },
                next: {
                    url: path('app_workouts', {month: next_month.format('Y-m')}),
                    label: next_month.format('F'),
                    is_granted: user_date().format('Y-m') >= next_month.format('Y-m'),
                },
            }) }}
        </div>

        <div class="workouts">
            {%- if workouts is empty -%}
                <div class="workout collection-empty">
                    {{- ux_icon('lucide:frown') -}}
                    <span>No workouts</span>
                </div>
            {%- else -%}
                {%- for workout in workouts|reverse -%}
                    <div class="workout" id="workout_{{ workout.id }}">
                        <div class="workout-date">
                            {%- set start = 0 -%}
                            {%- set end = 0 -%}

                            {%- for workout_exercise in workout.workoutExercises -%}
                                {%- for exercise_set in workout_exercise.sets -%}
                                    {%- if start === 0 or start > exercise_set.performedAt.timestamp -%}
                                        {%- set start = exercise_set.performedAt.timestamp -%}
                                    {%- endif -%}
                                    {%- if end < exercise_set.performedAt.timestamp -%}
                                        {%- set end = exercise_set.performedAt.timestamp -%}
                                    {%- endif -%}
                                {%- endfor -%}
                            {%- endfor -%}

                            {%- set is_granted = is_granted('WORKOUT_EDIT', workout) -%}
                            {%- set time = workout.date.setTimezone(app.user.timezone).format('j F H:i') -%}
                            {%- set minutes = ((end - start) / 60)|round -%}

                            <{% if is_granted %}a{% else %}div{% endif %}
                                {% if is_granted %}href="{{ path('app_workouts_view', {id: workout.id}) }}"{% endif %}>
                                <span>{{ time }}</span>
                                <span>( {{ minutes }} min )</span>
                            </{% if is_granted %}a{% else %}div{% endif %}>
                        </div>
                        <div class="workout-exercises">
                            {%- if workout.workoutExercises.empty -%}
                                <div class="workout-exercise collection-empty">
                                    {{- ux_icon('lucide:frown') -}}
                                    <span>No exercises yet</span>
                                    <form method="post"
                                          action="{{ path('app_workout_delete', {id: workout.id}) }}"
                                          onsubmit="return confirm('Delete?')">
                                        <input type="hidden" name="_method" value="DELETE">
                                        <button
                                            class="btn btn-danger btn-sm btn-link"
                                            {% if is_granted('WORKOUT_DELETE', workout) %}type="submit"
                                            {% else %}disabled{% endif %}>
                                            {{- ux_icon('lucide:trash') -}}
                                        </button>
                                    </form>
                                </div>
                            {%- else -%}
                                {%- for workout_exercise in workout.workoutExercises -%}
                                    <div class="workout-exercise"
                                         style="--exercise-color: var({{ '--color-' ~ workout_exercise.exercise.group.color.value }});">
                                        <div class="workout-exercise-description">
                                            <div class="exercise-name">
                                                {{- workout_exercise.exercise.name -}}

                                                {%- if not workout_exercise.sets.isEmpty -%}
                                                    {%- set we_id = workout_exercise.id.toString -%}
                                                    {%- if progresses[we_id] is defined -%}
                                                        {%- if progresses[we_id].change.value !== 'unchanged' -%}
                                                            <span class="exercise-progress"
                                                                  data-change="{{ progresses[we_id].change.value }}">
                                                            {{- progresses[we_id].percent -}}%
                                                            {{- ux_icon('lucide:trending-up') -}}
                                                        </span>
                                                        {%- endif -%}
                                                    {%- endif -%}
                                                {%- endif -%}
                                            </div>

                                            {%- if workout_exercise.description !== '' -%}
                                                <div class="workout-exercise-description">
                                                    {{- workout_exercise.description -}}
                                                </div>
                                            {%- endif -%}

                                            {%- if not workout_exercise.sets.isEmpty -%}
                                                <div class="workout-exercise-duration">
                                                    {%- set start = (workout_exercise.sets|first).performedAt.timestamp -%}
                                                    {%- set end = (workout_exercise.sets|last).performedAt.timestamp -%}

                                                    {{- (((end - start) / 60)|round + 1) ~ ' min.' -}}
                                                </div>
                                            {%- endif -%}
                                        </div>
                                        <div class="workout-exercise-sets">
                                            {%- if workout_exercise.sets.isEmpty -%}
                                                <div class="workout-exercise-set collection-empty">No reps yet</div>
                                            {%- else -%}
                                                {%- for exercise_set in workout_exercise.sets -%}
                                                    <div
                                                        class="workout-exercise-set {{ exercise_set.isWarmup ? 'set-warmup' }}">
                                                        {%- if exercise_set.weight > 0 -%}
                                                            <div class="workout-exercise-set-field set-weight">
                                                                <span>{{ exercise_set.weight }}</span>
                                                                <span>kg</span>
                                                            </div>
                                                        {%- endif -%}
                                                        <div class="workout-exercise-set-field set-reps">
                                                            <span>{{ exercise_set.reps }}</span>
                                                            <span>x</span>
                                                        </div>
                                                    </div>
                                                {%- endfor -%}
                                            {%- endif -%}
                                        </div>
                                    </div>
                                {%- endfor -%}
                            {%- endif -%}
                        </div>
                    </div>
                {%- endfor -%}
            {%- endif -%}
        </div>
    </section>
{%- endblock %}
