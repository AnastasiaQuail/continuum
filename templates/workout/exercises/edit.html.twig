{% extends 'base.html.twig' %}

{% block title %}{{ exercise ? 'Edit exercise' : 'Add exercise' }}{% endblock %}
{% block page_title %}Exercise{% endblock %}
{% block body_id %}exercise-edit{% endblock %}

{% set back_path = path('app_exercises') %}

{% block header_actions -%}
    <twig:Form:ExternalSubmit target="#form-exercise"/>
{%- endblock %}

{% block main -%}
    <twig:CardForm>
        {{- form_start(form, {attr: {id: 'form-exercise', class: 'form-submit-external'}}) -}}

        {{- form_row(form.group) -}}
        {{- form_row(form.name, {attr: {placeholder: 'Required'}}) -}}
        {{- form_row(form.isActive) -}}

        <twig:Form:Submit/>

        {{- form_end(form) -}}
    </twig:CardForm>

    {%- if exercise -%}
        <twig:CardForm:Delete action="{{ path('app_exercise_delete', {id: exercise.id}) }}"
                              isGranted="{{ is_granted('EXERCISE_DELETE', exercise) }}"
                              label="Delete exercise"/>
    {%- endif -%}
{%- endblock %}
