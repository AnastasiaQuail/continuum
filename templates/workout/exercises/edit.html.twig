{% extends 'base.html.twig' %}

{% block title %}Exercise{% endblock %}
{% block body_id %}exercise-edit{% endblock %}

{% set back_path = path('app_exercises') %}

{% block header_actions -%}
    <button class="btn btn-glass btn-glass-primary"
            data-form-submit="#form-exercise">{{ ux_icon('lucide:check') }}</button>
{%- endblock %}

{% block main -%}
    <section class="card card-form">
        {{- form_start(form, {attr: {id: 'form-exercise', class: 'form-submit-external'}}) -}}

        {{- form_row(form.group) -}}
        {{- form_row(form.name, {attr: {placeholder: 'Required'}}) -}}
        {{- form_row(form.isActive) -}}

        {{- form_row_submit() -}}

        {{- form_end(form) -}}
    </section>

    {%- if exercise and exercise.workoutExercises is empty -%}
        <section class="card card-form">
            {{- form_delete(
                path('app_exercise_delete', {id: exercise.id}),
                is_granted('EXERCISE_DELETE', exercise),
                'Delete exercise',
            ) -}}
        </section>
    {%- endif -%}
{%- endblock %}
