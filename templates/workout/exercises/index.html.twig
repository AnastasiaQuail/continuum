{% extends 'base.html.twig' %}

{% block title %}Exercises{% endblock %}
{% block body_id %}exercises{% endblock %}

{% set breadcrumbs = [
    {label: 'Workouts', url: path('app_workouts')},
    {label: 'Exercises'},
] %}

{% block page_links -%}
    {%- set is_granted = is_granted('EXERCISE_CREATE') -%}
    <{% if is_granted %}a{% else %}button{% endif %}
        {% if is_granted %} href="{{ path('app_exercise_create') }}"{% else %} disabled{% endif %}
        class="btn btn-primary btn-outline">
        {{ ux_icon('lucide:plus') }}
        <span>Create exercise</span>
    </{% if is_granted %}a{% else %}button{% endif %}>
{%- endblock %}

{% block main -%}
    <section class="card">
        <div class="exercises">
            {%- for exercise in exercises -%}
                {%- set is_granted = is_granted('EXERCISE_EDIT', exercise) -%}
                <{% if is_granted %}a{% else %}span{% endif %}
                    {% if is_granted %}href="{{ path('app_exercise_edit', {id: exercise.id}) }}"{% endif %}
                    class="exercise" data-general-type="{{ exercise.group.color.value }}">
                    <div class="badge">{{ exercise.group.name }}</div>
                    <div class="exercise-name">
                        <span>{{ exercise.name|capitalize }}</span>
                        <span class="exercise-usages">({{ exercise_count_map[exercise.id.toString] }} workouts)</span>
                    </div>
                </{% if is_granted %}a{% else %}span{% endif %}>
            {%- endfor -%}
        </div>
    </section>
{%- endblock %}
