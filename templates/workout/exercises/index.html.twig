{% extends 'base.html.twig' %}

{% block title %}Exercises{% endblock %}
{% block body_id %}exercises{% endblock %}

{% set breadcrumbs = [
    { label: 'Workouts', url: path('app_workouts') },
    { label: 'Exercises' },
] %}

{% block page_links -%}
    {%- set isGranted = is_granted('EXERCISE_CREATE') -%}
    <{% if isGranted %}a{% else %}button{% endif %}
        {% if isGranted %} href="{{ path('app_exercise_create') }}"{% else %} disabled{% endif %}
        class="btn btn-primary btn-outline">
        {{ ux_icon('lucide:plus') }}
        <span>Create exercise</span>
    </{% if isGranted %}a{% else %}button{% endif %}>
{%- endblock %}

{% block main -%}
    <section class="card">
        <div class="exercises">
            {%- for exercise in exercises -%}
                {%- set isGranted = is_granted('EXERCISE_EDIT', exercise) -%}
                <{% if isGranted %}a{% else %}span{% endif %}
                    {% if isGranted %}href="{{ path('app_exercise_edit', {'id': exercise.id}) }}"{% endif %}
                    class="exercise" data-general-type="{{ exercise.group.color.value }}">
                    <div class="badge">{{ exercise.group.name }}</div>
                    <div class="exercise-name">
                        <span>{{ exercise.name|capitalize }}</span>
                        <span class="exercise-usages">({{ exerciseCountMap[exercise.id.toString] }} workouts)</span>
                    </div>
                </{% if isGranted %}a{% else %}span{% endif %}>
            {%- endfor -%}
        </div>
    </section>
{%- endblock %}
