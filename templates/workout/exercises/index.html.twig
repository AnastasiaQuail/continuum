{% extends 'base.html.twig' %}

{%- block javascripts -%}
    {{ parent() }}
    <script src="{{ asset('js/echarts.min.js') }}"></script>
    <script src="{{ asset('js/chart.js') }}"></script>
{%- endblock -%}

{% block title %}Exercises{% endblock %}
{% block body_id %}exercises{% endblock %}

{% set back_path = path('app_workouts') %}

{% block header_actions -%}
    <twig:HeaderAction text="{{ ux_icon('lucide:plus') }}" href="{{ path('app_exercise_create') }}" method="post"
                       isGranted="{{ is_granted('EXERCISE_CREATE') }}"/>

    <twig:MonthFilter href="{{ path('app_exercises', {months: '###'}) }}" months="4,6,8,10"/>
{%- endblock %}

{% block main -%}
    {%- for exercise in exercises -%}
        {%- set exercise_id = exercise.id.toString -%}

        <twig:CardForm class="card-exercise">
            <twig:Form:RowField isHeaderLarge href="{{ path('app_exercise_edit', {id: exercise_id}) }}"
                                isGranted="{{ is_granted('EXERCISE_EDIT', exercise) }}">
                <twig:block name="label">
                    <twig:Badge color="{{ exercise.group.color.value }}">{{ exercise.group.name }}</twig:Badge>
                    {%- if not exercise.isActive -%}
                        <twig:Badge color="red">{{ ux_icon('lucide:eye-off') }}</twig:Badge>
                    {%- endif -%}
                    {{ exercise.name }}
                </twig:block>
            </twig:Form:RowField>

            {%- if exercise_progress_map[exercise_id] is defined -%}
                {%- set exercise_map = exercise_progress_map[exercise_id] -%}

                <twig:Form:Row class="form-row-exercise-progress">
                    <div class="form-field exercise-progress-values">
                        <div class="exercise-progress-value">
                            <span class="form-field-legend">From</span>
                            {%- for set in exercise_map|first.sets -%}
                                <twig:Workout:Set set="{{ set }}"/>
                            {%- endfor -%}
                        </div>

                        {%- if exercise_map|length > 1 -%}
                            <div class="exercise-progress-value">
                                <span class="form-field-legend">To</span>
                                {%- for set in exercise_map|last.sets -%}
                                    <twig:Workout:Set set="{{ set }}"/>
                                {%- endfor -%}
                            </div>
                        {%- endif -%}
                    </div>

                    <div class="form-field">
                        <twig:Chart name="exercise-progress" values="{{ exercise_map }}"
                                    data-days="{{ exercise_days }}" data-color="{{ exercise.group.color.value }}"/>
                    </div>
                </twig:Form:Row>
            {%- endif -%}
        </twig:CardForm>

        <twig:Card:Description>
            {%- if exercise_count_map[exercise_id] -%}
                Used in {{ exercise_count_map[exercise_id] }} workouts
            {%- else -%}
                Not used anywhere
            {%- endif -%}
        </twig:Card:Description>
    {%- endfor -%}
{%- endblock %}
