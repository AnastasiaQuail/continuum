{% extends 'base.html.twig' %}

{% import 'default/_filters.html.twig' as filters %}

{%- block javascripts -%}
    {{ parent() }}
    <script src="{{ asset('js/echarts.min.js') }}"></script>
    <script src="{{ asset('js/chart.js') }}"></script>
{%- endblock -%}

{% block title %}Exercises{% endblock %}
{% block body_id %}exercises{% endblock %}

{% set breadcrumbs = [
    {label: 'Workouts', url: path('app_workouts')},
    {label: 'Exercises'},
] %}

{% block page_links -%}
    {%- set is_granted = is_granted('EXERCISE_CREATE') -%}
    <{% if is_granted %}a{% else %}button{% endif %}
        {% if is_granted %} href="{{ path('app_exercise_create') }}"{% else %} disabled{% endif %}
        class="btn btn-primary btn-outline">
        {{ ux_icon('lucide:plus') }}
        <span>Create exercise</span>
    </{% if is_granted %}a{% else %}button{% endif %}>

    {{- filters.months(exercise_days, path('app_exercises', {months: '###'}), [4, 6, 8, 10]) -}}
{%- endblock %}

{% block main -%}
    <section class="card">
        <div class="exercises">
            {%- for exercise in exercises -%}
                {%- set exercise_id = exercise.id.toString -%}
                {%- set is_granted = is_granted('EXERCISE_EDIT', exercise) -%}

                <{% if is_granted %}a{% else %}span{% endif %}
                    {% if is_granted %}href="{{ path('app_exercise_edit', {id: exercise_id}) }}"{% endif %}
                    class="exercise" data-general-type="{{ exercise.group.color.value }}">
                    <div class="exercise-body">
                        <div class="exercise-badges">
                            <div class="badge badge-group">{{ exercise.group.name }}</div>
                            {%- if not exercise.isActive -%}
                                <div class="badge badge-disabled">{{ ux_icon('lucide:eye-off') }}</div>
                            {%- endif -%}
                        </div>
                        <div class="exercise-title {{ not exercise.isActive ? 'exercise-disabled' }}">
                            <span class="exercise-name">{{ exercise.name }}</span>
                            <span class="exercise-usages">({{ exercise_count_map[exercise_id] }} workouts)</span>
                        </div>
                    </div>

                    {%- if exercise_progress_map[exercise_id] is defined -%}
                        <div class="exercise-progress">
                            <div class="exercise-progress-chart" data-chart="exercise-progress"
                                 data-days="{{ exercise_days }}" data-color="{{ exercise.group.color.value }}"
                                 data-values="{{ exercise_progress_map[exercise_id]|json_encode }}"></div>
                        </div>
                    {%- endif -%}
                </{% if is_granted %}a{% else %}span{% endif %}>
            {%- endfor -%}
        </div>
    </section>
{%- endblock %}
