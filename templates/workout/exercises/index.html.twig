{% extends 'base.html.twig' %}

{% block title %}Exercises{% endblock %}
{% block body_id %}exercises{% endblock %}

{% set breadcrumbs = [
    { label: 'Workouts', url: path('app_workouts') },
    { label: 'Exercises' },
] %}

{% block page_links -%}
    <a class="btn btn-primary btn-outline" href="{{ path('app_exercise_create') }}">
        {{ ux_icon('lucide:plus') }}
        <span>Create exercise</span>
    </a>
{%- endblock %}

{% block main -%}
    <section class="card">
        <div class="exercises">
            {%- for exercise in exercises -%}
                <a href="{{ path('app_exercise_edit', {'id': exercise.id}) }}" class="exercise"
                   data-general-type="{{ exercise.group.color.value }}">
                    <div class="badge">{{ exercise.group.name }}</div>
                    <div class="exercise-name">
                        <span>{{ exercise.name|capitalize }}</span>
                        <span class="exercise-usages">({{ exerciseCountMap[exercise.id] }} workouts)</span>
                    </div>
                </a>
            {%- endfor -%}
        </div>
    </section>
{%- endblock %}
