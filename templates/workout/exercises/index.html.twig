{% extends 'base.html.twig' %}

{% block title %}Exercises{% endblock %}
{% block body_id %}exercises{% endblock %}

{% set breadcrumbs = [
    { label: 'Workouts', url: path('app_workouts') },
    { label: 'Exercises' },
] %}

{% block main -%}
    <section class="card">
        <div class="exercises">
            {%- for exercise in exercises -%}
                <a href="#{{ exercise.id }}" class="exercise" data-general-type="{{ exercise.group.color.value }}">
                    <div class="badge">{{ exercise.group.name }}</div>
                    <div>{{ exercise.name|capitalize }}</div>
                </a>
            {%- endfor -%}
        </div>
    </section>
{%- endblock %}
