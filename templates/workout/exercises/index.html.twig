{% extends 'base.html.twig' %}

{% import 'default/_filters.html.twig' as filters %}

{%- block javascripts -%}
    {{ parent() }}
    <script src="{{ asset('js/echarts.min.js') }}"></script>
    <script src="{{ asset('js/chart.js') }}"></script>
{%- endblock -%}

{% block title %}Exercises{% endblock %}
{% block body_id %}exercises{% endblock %}

{% set back_path = path('app_workouts') %}

{% block header_actions -%}
    {%- set is_granted = is_granted('EXERCISE_CREATE') -%}

    <{% if is_granted %}a{% else %}button{% endif %}
        {% if is_granted %} href="{{ path('app_exercise_create') }}"{% else %} disabled{% endif %}
        class="btn btn-glass">
        {{- ux_icon('lucide:plus') -}}
    </{% if is_granted %}a{% else %}button{% endif %}>

    {{- filters.months(
        ux_icon('lucide:sliders-horizontal'),
        exercise_days,
        path('app_exercises', {months: '###'}),
        [4, 6, 8, 10],
    ) -}}
{%- endblock %}

{% block main -%}
    {%- for exercise in exercises -%}
        {%- set exercise_id = exercise.id.toString -%}

        <twig:CardForm class="card-exercise">
            {%- set is_granted = is_granted('EXERCISE_EDIT', exercise) -%}

            <{% if is_granted %}a{% else %}div{% endif %}
                {% if is_granted %}href="{{ path('app_exercise_edit', {id: exercise_id}) }}"{% endif %}
                class="form-row form-row-header-edit form-row-header-large"
                data-general-type="{{ exercise.group.color.value }}">
                <div class="form-label form-label-exercise">
                    <twig:Badge>{{ exercise.group.name }}</twig:Badge>
                    {%- if not exercise.isActive -%}
                        <twig:Badge color="red">{{ ux_icon('lucide:eye-off') }}</twig:Badge>
                    {%- endif -%}
                    {{ exercise.name }}
                </div>
                <div class="form-field">{{ ux_icon('lucide:square-pen') }}</div>
            </{% if is_granted %}a{% else %}div{% endif %}>

            {%- if exercise_progress_map[exercise_id] is defined -%}
                {%- set exercise_map = exercise_progress_map[exercise_id] -%}

                <div class="form-row form-row-exercise-progress">
                    <div class="form-field exercise-progress-values">
                        {%- import 'workout/exercises/index.html.twig' as macro -%}

                        {{- macro.exercise_progress_sets('From', exercise_map|first.sets) -}}

                        {%- if exercise_map|length > 1 -%}
                            {{- macro.exercise_progress_sets('To', exercise_map|last.sets) -}}
                        {%- endif -%}
                    </div>

                    <div class="form-field">
                        <twig:Chart name="exercise-progress" values="{{ exercise_map }}"
                                    data-days="{{ exercise_days }}" data-color="{{ exercise.group.color.value }}"/>
                    </div>
                </div>
            {%- endif -%}
        </twig:CardForm>

        <twig:Card:Description>
            {%- if exercise_count_map[exercise_id] -%}
                Used in {{ exercise_count_map[exercise_id] }} workouts
            {%- else -%}
                Not used anywhere
            {%- endif -%}
        </twig:Card:Description>
    {%- endfor -%}
{%- endblock %}

{% macro exercise_progress_sets(description, sets) -%}
    <div class="exercise-progress-value">
        <span class="form-field-legend">{{ description }}</span>
        {%- for set in sets -%}
            <twig:Badge>
                {%- if set.weight > 0 -%}
                    <span>{{ set.weight }}<small>kg</small></span>
                {%- endif -%}
                <span><small>x</small>{{ set.reps }}</span>
            </twig:Badge>
        {%- endfor -%}
    </div>
{%- endmacro %}
