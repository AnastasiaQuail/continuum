{% extends 'public.html.twig' %}

{% block title %}Log in{% endblock %}
{% block body_id %}login{% endblock %}

{% block main -%}
    {%- if app.user -%}
        <div class="alert alert-secondary">
            You are logged in as {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Logout</a>
        </div>
        <div>
            <a class="btn btn-primary btn-transparent" href="{{ path('app_homepage') }}">
                {{ ux_icon('lucide:house') }}
                <span>Go home</span>
            </a>
        </div>
    {%- else -%}
        <div class="alert alert-danger browser-unsupport">
            <div class="alert-title">
                {{- ux_icon('lucide:triangle-alert') -}}
                <strong>This browser isn’t fully supported.</strong>
            </div>
            <div>
                <small>Some features may not work correctly.</small><br>
                <small>Please update your browser or use a modern alternative.</small>
            </div>
            <div><small>(Supported: <strong>Chrome 138+</strong>, <strong>Safari 26.2+</strong>)</small></div>
        </div>

        {%- if error -%}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {%- endif -%}

        <form method="post" action="{{ path('app_login') }}">
            <div>
                <label for="username" hidden>Login</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control"
                       autocomplete="email" placeholder="Login" required="required" autofocus>
            </div>

            <div class="form-control-group">
                <label for="password" hidden>Password</label>
                <input type="password" name="_password" id="password" class="form-control"
                       autocomplete="current-password" minlength="6" placeholder="Password" required="required">
            </div>

            <input type="hidden" name="_csrf_token" data-controller="csrf-protection"
                   value="{{ csrf_token('authenticate') }}">

            <div class="form-control-group">
                <button class="btn btn-primary btn-action" type="submit" id="submit">
                    {{ ux_icon('lucide:log-in') }}
                    <span>Sign in</span>
                </button>
            </div>
        </form>
    {%- endif -%}
{%- endblock %}
