{% extends 'base.html.twig' %}

{% set is_current_year = month.format('Y') === user_date().format('Y') %}

{% block title %}Weekly reflection{% endblock %}
{% block page_subtitle %}{{ is_current_year ? month.format('F') : month.format('F Y') }}{% endblock %}
{% block body_id %}weekly-reflection{% endblock %}

{% block body_pagination_actions -%}
    {%- set prev_month = month.modify('-1 month') -%}
    <twig:Pagination:Prev href="{{ path('app_weekly_reflections', {month: prev_month.format('Y-m')}) }}"
                          isGranted="{{ prev_month.format('Y') >= app_year_min and is_granted('WEEKLY_REFLECTION_VIEW', prev_month) }}"
                          label="{{ prev_month.format('F') }}"/>

    {%- set next_month = month.modify('+1 month') -%}
    <twig:Pagination:Next href="{{ path('app_weekly_reflections', {month: next_month.format('Y-m')}) }}"
                          isGranted="{{ prev_month.format('Y') <= app_year_max and is_granted('WEEKLY_REFLECTION_VIEW', next_month) }}"
                          label="{{ next_month.format('F') }}"/>
{%- endblock %}

{% block main -%}
    {%- for date, reflection in weekly_reflections|reverse -%}
        <twig:CardForm class="card-weekly-reflections">
            {%- set monday = date(date).modify('-6 days') -%}
            {%- set sunday = date(date) -%}
            {%- set is_different_month = monday.format('n') !== sunday.format('n') -%}

            <twig:Form:RowField isHeader href="{{ path('app_weekly_reflection_edit', {week: date}) }}"
                                isGranted="{{ is_granted('WEEKLY_REFLECTION_EDIT', sunday.format('Y-m-d')) }}"
                                label="{{ monday.format(is_different_month ? 'j F' : 'j') ~ ' - ' ~ sunday.format('j F') }}"/>

            {%- if reflection is null -%}
                <twig:Form:RowEmptyCollection message="No reflection for this week yet"/>
            {%- else -%}
                <div class="row row-md-3">
                    {%- import 'weekly_reflection/index.html.twig' as weekly_reflection -%}

                    {{- weekly_reflection.weekly_row(
                        'green',
                        ux_icon('lucide:heart'),
                        'Joy',
                        reflection.joy,
                    ) -}}

                    {{- weekly_reflection.weekly_row(
                        'yellow',
                        ux_icon('lucide:triangle-alert'),
                        'Difficulty',
                        reflection.difficulty,
                    ) -}}

                    {{- weekly_reflection.weekly_row(
                        'blue',
                        ux_icon('lucide:trophy'),
                        'Achievement',
                        reflection.achievement,
                    ) -}}
                </div>
            {%- endif -%}
        </twig:CardForm>
    {%- endfor -%}
{%- endblock %}

{%- macro weekly_row(color, icon, label, field) -%}
    {%- set is_secure = field.isPrivate and not is_granted('WEEKLY_REFLECTION_PRIVATE') -%}

    <twig:Form:RowField isLarge icon="{{ icon }}" label="{{ label }}" data-general-type="{{ color }}">
        <div class="{{ is_secure ? 'form-field-secure' : (field.isPrivate ? 'form-field-private') }}">
            {{- is_secure ? ux_icon('lucide:lock') : field.text -}}
        </div>
    </twig:Form:RowField>
{%- endmacro -%}
