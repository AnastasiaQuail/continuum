{% extends 'base.html.twig' %}

{% set is_current_year = month.format('Y') === user_date().format('Y') %}

{% block title %}Weekly reflection{% endblock %}
{% block page_subtitle %}{{ is_current_year ? month.format('F') : month.format('F Y') }}{% endblock %}
{% block body_id %}weekly-reflection{% endblock %}

{% block body_actions -%}
    <div class="body-actions actions-pagination">
        {% set prev_month = month.modify('-1 month') %}
        {% set next_month = month.modify('+1 month') %}

        {{ include('default/_pagination.html.twig', {
            prev: {
                url: path('app_weekly_reflections', {month: prev_month.format('Y-m')}),
                label: prev_month.format('F'),
                is_granted: prev_month.format('Y') >= app_year_min and is_granted('WEEKLY_REFLECTION_VIEW', prev_month),
            },
            next: {
                url: path('app_weekly_reflections', {month: next_month.format('Y-m')}),
                label: next_month.format('F'),
                is_granted: prev_month.format('Y') <= app_year_max and is_granted('WEEKLY_REFLECTION_VIEW', next_month),
            },
        }) }}
    </div>
{%- endblock %}

{% block main -%}
    {%- set is_granted = is_granted('WEEKLY_REFLECTION_EDIT') -%}

    {%- for date, reflection in weekly_reflections|reverse -%}
        <section class="card card-form card-weekly-reflections">
            {%- set monday = date(date).modify('-6 days') -%}
            {%- set sunday = date(date) -%}
            {%- set is_different_month = monday.format('n') !== sunday.format('n') -%}
            {%- set time = monday.format(is_different_month ? 'j F' : 'j') ~ ' - ' ~ sunday.format('j F') -%}

            <{% if is_granted %}a{% else %}div{% endif %}
                {% if is_granted %}href="{{ path('app_weekly_reflection_edit', {week: date}) }}"{% endif %}
                class="form-row form-row-header-edit">
                <div class="form-label">{{ time }}</div>
                {% if is_granted %}
                    <div class="form-field">{{ ux_icon('lucide:square-pen') }}</div>
                {% endif %}
            </{% if is_granted %}a{% else %}div{% endif %}>

            {%- if reflection is null -%}
                <div class="collection-empty">
                    {{- ux_icon('lucide:frown') -}}
                    <span>No reflection for this week yet</span>
                </div>
            {%- else -%}
                <div class="row row-md-3">
                    {{- _self.weekly_row(
                        'green',
                        ux_icon('lucide:heart'),
                        'Joy',
                        reflection.joy,
                    ) -}}

                    {{- _self.weekly_row(
                        'yellow',
                        ux_icon('lucide:triangle-alert'),
                        'Difficulty',
                        reflection.difficulty,
                    ) -}}

                    {{- _self.weekly_row(
                        'blue',
                        ux_icon('lucide:trophy'),
                        'Achievement',
                        reflection.achievement,
                    ) -}}
                </div>
            {%- endif -%}
        </section>
    {%- endfor -%}
{%- endblock %}

{%- macro weekly_row(color, icon, label, field) -%}
    {%- set is_secure = field.isPrivate and not is_granted('WEEKLY_REFLECTION_PRIVATE') -%}

    <div class="form-row" data-general-type="{{ color }}">
        <div class="form-icon form-icon-large">{{ icon|raw }}</div>
        <div class="form-label">{{ label }}</div>
        <div class="form-field-large {{ is_secure ? 'form-field-secure' : (field.isPrivate ? 'form-field-private') }}">
            {{- is_secure ? ux_icon('lucide:lock') : field.text -}}
        </div>
    </div>
{%- endmacro -%}
