{% extends 'base.html.twig' %}

{% set monday = week.modify('-6 days') %}
{% if monday.format('n') !== week.format('n') %}
    {% set current_title = monday.format('j F') ~ ' - ' ~ week.format('j F') %}
{% else %}
    {% set current_title = monday.format('j') ~ ' - ' ~ week.format('j F') %}
{% endif %}

{% if week.format('Y') !== user_date().format('Y') %}
    {% set current_title = current_title ~ ' ' ~ week.format('Y') %}
{% endif %}

{% block title %}Reflection on {{ current_title }}{% endblock %}
{% block page_title %}Mood of the week{% endblock %}
{% block page_subtitle %}{{ current_title }}{% endblock %}
{% block body_id %}weekly-reflection-edit{% endblock %}

{% set back_path = path('app_weekly_reflections', {month: week.format('Y-m')}) %}

{% block header_actions -%}
    <twig:Form:ExternalSubmit target="#form-weekly-reflection"/>
{%- endblock %}

{% block main -%}
    <twig:CardForm>
        {{- form_start(form, {attr: {id: 'form-weekly-reflection', class: 'form-submit-external'}}) -}}

        <twig:Form:Row class="form-row-text-field" data-general-type="green">
            {{- form_label(form.joy.text) -}}
            {{- form_widget(form.joy.text, {attr: {placeholder: 'Required'}}) -}}
            {{- form_errors(form.joy.text) -}}
            {{- form_widget(form.joy.isPrivate) -}}
        </twig:Form:Row>

        <twig:Form:Row class="form-row-text-field" data-general-type="yellow">
            {{- form_label(form.difficulty.text) -}}
            {{- form_widget(form.difficulty.text, {attr: {placeholder: 'Required'}}) -}}
            {{- form_errors(form.difficulty.text) -}}
            {{- form_widget(form.difficulty.isPrivate) -}}
        </twig:Form:Row>

        <twig:Form:Row class="form-row-text-field" data-general-type="blue">
            {{- form_label(form.achievement.text) -}}
            {{- form_widget(form.achievement.text, {attr: {placeholder: 'Required'}}) -}}
            {{- form_errors(form.achievement.text) -}}
            {{- form_widget(form.achievement.isPrivate) -}}
        </twig:Form:Row>

        <twig:Form:Submit/>

        {{- form_end(form) -}}
    </twig:CardForm>
{%- endblock %}
