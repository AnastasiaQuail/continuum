{% extends 'base.html.twig' %}

{% set monday = week.modify('-6 days') %}
{% if monday.format('n') !== week.format('n') %}
    {% set current_title = monday.format('j F') ~ ' - ' ~ week.format('j F') %}
{% else %}
    {% set current_title = monday.format('j') ~ ' - ' ~ week.format('j F') %}
{% endif %}

{% block title %}Reflection on {{ current_title }}{% endblock %}
{% block page_title %}{{ current_title }}{% endblock %}
{% block body_id %}weekly-reflection-edit{% endblock %}

{% set back_path = path('app_weekly_reflections', {month: week.format('Y-m')}) %}

{% block main -%}
    <section class="card">
        <h2 class="card-title">What happened this week?</h2>

        {{- form_start(form) -}}

        <div class="weekly-reflection weekly-reflection-form">
            {%- embed 'weekly_reflection/_alert.html.twig' with {type: 'joy'} -%}
                {%- block alert_body -%}
                    <div class="alert-form-textarea">
                        {{- form_widget(form.joy) -}}
                        {{- form_errors(form.joy) -}}
                    </div>
                    {{- form_widget(form.isJoyPrivate) -}}
                {%- endblock -%}
            {%- endembed -%}

            {%- embed 'weekly_reflection/_alert.html.twig' with {type: 'difficulty'} -%}
                {%- block alert_body -%}
                    <div class="alert-form-textarea">
                        {{- form_widget(form.difficulty) -}}
                        {{- form_errors(form.difficulty) -}}
                    </div>
                    {{- form_widget(form.isDifficultyPrivate) -}}
                {%- endblock -%}
            {%- endembed -%}

            {%- embed 'weekly_reflection/_alert.html.twig' with {type: 'achievement'} -%}
                {%- block alert_body -%}
                    <div class="alert-form-textarea">
                        {{- form_widget(form.achievement) -}}
                        {{- form_errors(form.achievement) -}}
                    </div>
                    {{- form_widget(form.isAchievementPrivate) -}}
                {%- endblock -%}
            {%- endembed -%}
        </div>

        <div class="card-submit">
            <button type="submit" class="btn btn-primary btn-outline">Save</button>
        </div>

        {{- form_end(form) -}}
    </section>
{%- endblock %}
