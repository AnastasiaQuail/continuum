{% extends 'base.html.twig' %}

{% set monday = week.modify('-6 days') %}
{% if monday.format('n') !== week.format('n') %}
    {% set current_title = monday.format('j F') ~ ' - ' ~ week.format('j F') %}
{% else %}
    {% set current_title = monday.format('j') ~ ' - ' ~ week.format('j F') %}
{% endif %}

{% if week.format('Y') !== user_date().format('Y') %}
    {% set current_title = current_title ~ ' ' ~ week.format('Y') %}
{% endif %}

{% block title %}Reflection on {{ current_title }}{% endblock %}
{% block page_title %}Mood of the week{% endblock %}
{% block page_subtitle %}{{ current_title }}{% endblock %}
{% block body_id %}weekly-reflection-edit{% endblock %}

{% set back_path = path('app_weekly_reflections', {month: week.format('Y-m')}) %}

{% block header_actions -%}
    <button class="btn btn-glass btn-glass-primary"
            data-form-submit="#form-weekly-reflection">{{ ux_icon('lucide:check') }}</button>
{%- endblock %}

{% block main -%}
    <twig:CardForm>
        {{- form_start(form, {attr: {id: 'form-weekly-reflection', class: 'form-submit-external'}}) -}}

        <div class="form-row form-row-text-field" data-general-type="green">
            {{- form_label(form.joy) -}}
            {{- form_widget(form.joy, {attr: {placeholder: 'Required'}}) -}}
            {{- form_widget(form.isJoyPrivate) -}}
        </div>

        <div class="form-row form-row-text-field" data-general-type="yellow">
            {{- form_label(form.difficulty) -}}
            {{- form_widget(form.difficulty, {attr: {placeholder: 'Required'}}) -}}
            {{- form_widget(form.isDifficultyPrivate) -}}
        </div>

        <div class="form-row form-row-text-field" data-general-type="blue">
            {{- form_label(form.achievement) -}}
            {{- form_widget(form.achievement, {attr: {placeholder: 'Required'}}) -}}
            {{- form_widget(form.isAchievementPrivate) -}}
        </div>

        {{- form_row_submit() -}}

        {{- form_end(form) -}}
    </twig:CardForm>
{%- endblock %}
