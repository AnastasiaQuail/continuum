{%- if app.user and is_couple_day() -%}
    {%- set html_data_day = 'data-couple-day' -%}
    {%- set favicon_href = asset('favicon-couple-day.svg') -%}
{%- elseif app.user and user_date().format('m-d') === '03-08' -%}
    {%- set html_data_day = 'data-women-day' -%}
    {%- set favicon_href = asset('favicon-women-day.svg') -%}
{%- else -%}
    {%- set html_data_day = null -%}
    {%- set favicon_href = asset('favicon.svg') -%}
{%- endif -%}

{%- set body_id = block('body_id') -%}

<!DOCTYPE html>
<html lang="en" data-timezone="{{ app.user?.timezone.name }}" {{ html_data_day }}>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1.0, user-scalable=no">
    <title>{% block title %}Continuum{% endblock %}</title>
    <link rel="shortcut icon" type="image/svg+xml" href="{{ favicon_href }}">
    <script>
        Object.keys(localStorage)
            .filter(key => key.startsWith('continuum-ls-'))
            .map(key => document.documentElement.setAttribute(`data-${key.slice(13)}`, localStorage.getItem(key)));
    </script>
    {%- block stylesheets -%}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet"
              href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&display=swap">
    {%- endblock -%}
    {%- block javascripts -%}
        {%- block importmap %}{{ importmap('app') }}{% endblock -%}
    {%- endblock -%}
</head>
<body id="{{ body_id }}" class="{% if sidebar_show|default !== 'hide' %}has-sidebar{% endif %}">
    {%- block header -%}
        <header class="header">
            <nav class="header-container">
                {%- if logo_show|default !== 'hide' -%}
                    <div class="header-logo">
                        <a class="header-logo-link" href="{{ path('app_homepage') }}">
                            {{- ux_icon('hugeicons:infinity-02') -}}
                            <span class="logo-text">Continuum
                                {%- if random(20) === 20 %}{{ ux_icon('lucide:bug', {class: 'logo-bug'}) }}{% endif -%}
                            </span>
                        </a>
                    </div>
                {%- endif -%}
                {%- if sidebar_show|default !== 'hide' -%}
                    <button id="sidebar-toggler" class="header-button">
                        {{- ux_icon('lucide:menu', {class: 'icon-menu-open'}) -}}
                        {{- ux_icon('lucide:x', {class: 'icon-menu-close'}) -}}
                    </button>
                {%- endif -%}

                <div class="header-controls">
                    {%- block header_events -%}
                        <div class="header-events">
                            <button class="header-button">{{ ux_icon('lucide:plus') }}</button>
                            <ul class="dropdown-menu">
                                {%- if is_granted('CALENDAR_EDIT') -%}
                                    <li class="dropdown-item">
                                        <a class="dropdown-link"
                                           href="{{ path('app_calendar_day', {day: user_date('+1 day').format('Y-m-d')}) }}">
                                            {{- ux_icon('lucide:calendar-plus') -}}
                                            <span>New event</span>
                                        </a>
                                    </li>
                                    <li class="dropdown-item">
                                        <hr class="dropdown-divider">
                                    </li>
                                {%- endif -%}
                                {%- if is_granted('MOOD_REFLECTION_EDIT') -%}
                                    <li class="dropdown-item">
                                        <a class="dropdown-link" href="{{ path('app_mood_reflection_last_unfilled') }}">
                                            {{- ux_icon('lucide:scan-face') -}}
                                            <span>Track mood</span>
                                        </a>
                                    </li>
                                {%- endif -%}
                                {%- if is_granted('BODY_MEASUREMENT_CREATE') -%}
                                    <li class="dropdown-item">
                                        <a class="dropdown-link" href="{{ path('app_measurement_create') }}">
                                            {{- ux_icon('lucide:ruler') -}}
                                            <span>Add measurement</span>
                                        </a>
                                    </li>
                                {%- endif -%}
                                {%- if is_granted('WORKOUT_CREATE') -%}
                                    <li class="dropdown-item">
                                        <form method="post" action="{{ path('app_workout_create') }}">
                                            <button class="dropdown-link" type="submit">
                                                {{- ux_icon('lucide:biceps-flexed') -}}
                                                <span>Start workout</span>
                                            </button>
                                        </form>
                                    </li>
                                {%- endif -%}
                            </ul>
                        </div>
                        <div class="header-divider"></div>
                    {%- endblock -%}

                    <button id="theme-toggler" class="header-button">
                        <span class="theme-light">{{ ux_icon('lucide:sun') }}</span>
                        <span class="theme-dark">{{ ux_icon('lucide:moon') }}</span>
                    </button>

                    {%- if logout_show|default !== 'hide' and is_granted('ROLE_USER') -%}
                        <a class="header-button" href="{{ logout_path() }}">{{ ux_icon('lucide:log-out') }}</a>
                    {%- endif -%}
                </div>
            </nav>
        </header>
    {%- endblock -%}

    {%- block sidebar -%}
        <aside id="sidebar" class="sidebar">
            <nav class="navbar">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        {{- _self.sidebar_link(
                            'app_calendar',
                            ['app_calendar_day'],
                            ux_icon('lucide:calendar-heart', {class: 'icon-fix-top'}),
                            'Calendar',
                            is_granted('CALENDAR_VIEW'),
                        ) -}}
                    </li>

                    <li>
                        <span class="nav-title-divider">Reflection</span>
                    </li>
                    <li class="nav-item">
                        {{- _self.sidebar_link(
                            'app_mood_reflections',
                            ['app_mood_reflection_edit'],
                            ux_icon('lucide:smile-plus'),
                            'Mood tracker',
                            is_granted('MOOD_REFLECTION_VIEW'),
                        ) -}}
                    </li>
                    <li class="nav-item">
                        {{- _self.sidebar_link(
                            'app_weekly_reflections',
                            ['app_weekly_reflection_edit'],
                            ux_icon('lucide:star'),
                            'Week in review',
                            is_granted('WEEKLY_REFLECTION_VIEW'),
                        ) -}}
                    </li>

                    <li>
                        <span class="nav-title-divider">Health</span>
                    </li>
                    <li class="nav-item">
                        {{- _self.sidebar_link(
                            'app_measurements',
                            ['app_measurement_create', 'app_measurement_edit'],
                            ux_icon('lucide:ruler-dimension-line'),
                            'Measurements',
                            is_granted('BODY_MEASUREMENT_VIEW'),
                        ) -}}
                    </li>
                    <li class="nav-item">
                        {{- _self.sidebar_link(
                            'app_workouts',
                            ['app_workouts_view'],
                            ux_icon('lucide:dumbbell'),
                            'Workouts',
                            is_granted('WORKOUT_VIEW'),
                        ) -}}
                    </li>

                    <li>
                        <span class="nav-title-divider">Settings</span>
                    </li>
                    <li class="nav-item">
                        {{- _self.sidebar_link(
                            'app_profile',
                            ['app_profile_location', 'app_profile_password'],
                            ux_icon('lucide:user'),
                            'Profile',
                        ) -}}
                    </li>
                    {%- if is_granted('REPORT_MONTH_VIEW') -%}
                        <li class="nav-item" data-general-type="red">
                            {{- _self.sidebar_link(
                                'app_report_month',
                                [],
                                ux_icon('lucide:chart-bar-big'),
                                'Monthly report',
                                true,
                                user_date().format('j') <= 3 ? {icon: ux_icon('lucide:badge-info'), type: 'orange'} : {},
                            ) -}}
                        </li>
                    {%- endif -%}
                    {%- if is_granted('ADMIN_USER_VIEW') -%}
                        <li class="nav-item">
                            {{- _self.sidebar_link(
                                'app_admin_users',
                                ['app_admin_user_edit'],
                                ux_icon('lucide:users'),
                                'Users',
                            ) -}}
                        </li>
                    {%- endif -%}
                    {%- if is_granted('ADMIN_BACKUP_VIEW') -%}
                        <li class="nav-item">
                            {{- _self.sidebar_link(
                                'app_admin_backups',
                                [],
                                ux_icon('lucide:database-backup'),
                                'Backups',
                                true,
                                has_backup_alert() ? {icon: ux_icon('lucide:triangle-alert'), type: 'red'} : null,
                            ) -}}
                        </li>
                    {%- endif -%}
                </ul>
            </nav>
        </aside>
    {%- endblock -%}

    <div class="body">
        <div id="body-messages" class="body-messages">
            {%- if app.request.hasPreviousSession -%}
                {%- for type, messages in app.flashes -%}
                    {%- for message in messages -%}
                        <div class="alert alert-{{ type }} alert-dismissible hidden"
                             role="alert">{{ message|trans }}</div>
                    {%- endfor -%}
                {%- endfor -%}
            {%- endif -%}
        </div>

        {%- block body -%}
            <main class="body-container">
                {%- block breadcrumb -%}
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="{{ path('app_homepage') }}">{{ ux_icon('lucide:house') }}</a>
                            </li>
                            {%- for crumb in breadcrumbs|default([{label: 'Homepage'}]) -%}
                                <li class="breadcrumb-item {% if loop.last %}active{% endif %}">
                                    {%- if crumb.url is defined -%}
                                        <a href="{{ crumb.url }}">{{ crumb.label }}</a>
                                    {%- else -%}
                                        {{- crumb.label -}}
                                    {%- endif -%}
                                </li>
                            {%- endfor -%}
                        </ol>
                    </nav>
                {%- endblock -%}

                {%- block showcase %}{% endblock -%}

                {%- block body_title -%}
                    <div class="page-title">
                        <h1 id="page-title-{{ body_id }}">{% block page_title %}{{ block('title') }}{% endblock %}</h1>
                        <div class="page-links">{% block page_links %}{% endblock %}</div>
                    </div>
                {%- endblock -%}

                {%- block main %}{% endblock -%}
            </main>
        {%- endblock -%}

        {%- block footer -%}
            <footer class="footer-container">
                <div class="footer-controls">
                    {%- if app.debug and is_granted('ROLE_SUPER_ADMIN') -%}
                        <div class="footer-control" id="footer-toolbar">
                            {{- ux_icon('lucide:database') -}}
                            <span>0</span>
                        </div>
                    {%- endif -%}
                    <div class="footer-control" id="footer-dog" data-href="{{ path('app_easter_egg_dog') }}">
                        {{- ux_icon('lucide:dog') -}}
                    </div>
                    <div class="footer-control footer-control-bird" id="footer-bird">
                        {{- ux_icon('lucide:bird') }}{{ bird_name() -}}
                    </div>
                </div>
            </footer>
        {%- endblock -%}
    </div>
</body>
</html>

{%- macro sidebar_link(path, related_paths, icon, name, is_granted = true, alert = {}) -%}
    {%- set is_active = false -%}
    {%- for related_path in [path, ...related_paths] -%}
        {%- if app.current_route === related_path -%}
            {%- set is_active = true -%}
        {%- endif -%}
    {%- endfor -%}

    <{% if is_granted %}a{% else %}button{% endif %}
        {% if is_granted %} href="{{ path(path) }}"{% else %} disabled{% endif %}
        class="nav-link {{ is_active ? 'active' }}">
        {{- icon|raw -}}
        <span>{{ name }}</span>
        {%- if alert -%}
            <span class="nav-icon" data-general-type="{{ alert.type }}">{{ alert.icon|raw }}</span>
        {%- endif -%}
    </{% if is_granted %}a{% else %}button{% endif %}>
{%- endmacro -%}
