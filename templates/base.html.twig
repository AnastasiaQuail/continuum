<!DOCTYPE html>
<html lang="en" data-timezone="{{ app.user ? app.user.timezone.name }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1.0, user-scalable=no">
    <title>{% block title %}Continuum{% endblock %}</title>
    <link rel="shortcut icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">
    <script>
        Object.keys(localStorage)
            .filter(key => key.startsWith('continuum-ls-'))
            .map(key => document.documentElement.setAttribute(`data-${key.slice(13)}`, localStorage.getItem(key)));
    </script>
    {%- block stylesheets -%}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet"
              href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&display=swap">
    {%- endblock -%}
    {%- block javascripts -%}
        {%- block importmap %}{{ importmap('app') }}{% endblock -%}
    {%- endblock -%}
</head>
<body id="{% block body_id %}{% endblock %}" class="{% if sidebarShow|default !== 'hide' %}has-sidebar{% endif %}">
    {%- block header -%}
        <header class="header">
            <nav class="header-container">
                {%- if sidebarShow|default !== 'hide' -%}
                    <div class="header-logo">
                        <a class="header-logo-link" href="{{ path('app_homepage') }}">
                            {{- ux_icon('hugeicons:infinity-02') -}}
                            <span>Continuum</span>
                        </a>
                    </div>
                    <button id="sidebar-toggler" class="header-button">
                        {{- ux_icon('lucide:menu', {class: 'icon-menu-open'}) -}}
                        {{- ux_icon('lucide:x', {class: 'icon-menu-close'}) -}}
                    </button>
                {%- endif -%}

                <div class="header-controls">
                    {%- block header_events -%}
                        <div class="header-events">
                            <button class="header-button">{{ ux_icon('lucide:plus') }}</button>
                            <ul class="dropdown-menu">
                                {%- if is_granted('CALENDAR_EDIT') -%}
                                    <li class="dropdown-item">
                                        <a class="dropdown-link"
                                           href="{{ path('app_calendar_day', {'day': user_date('+1 day').format('Y-m-d')}) }}">
                                            {{- ux_icon('lucide:calendar-plus') -}}
                                            <span>New event</span>
                                        </a>
                                    </li>
                                    <li class="dropdown-item">
                                        <hr class="dropdown-divider">
                                    </li>
                                {%- endif -%}
                                {%- if is_granted('MOOD_REFLECTION_EDIT') -%}
                                    <li class="dropdown-item">
                                        <a class="dropdown-link"
                                           href="{{ path('app_mood_reflection_edit', {'day': user_date().format('Y-m-d')}) }}">
                                            {{- ux_icon('lucide:scan-face') -}}
                                            <span>Track mood</span>
                                        </a>
                                    </li>
                                {%- endif -%}
                                {%- if is_granted('BODY_MEASUREMENT_CREATE') -%}
                                    <li class="dropdown-item">
                                        <a class="dropdown-link" href="{{ path('app_measurement_create') }}">
                                            {{- ux_icon('lucide:ruler') -}}
                                            <span>Add measurement</span>
                                        </a>
                                    </li>
                                {%- endif -%}
                                {%- if is_granted('WORKOUT_CREATE') -%}
                                    <li class="dropdown-item">
                                        <form method="post" action="{{ path('app_workout_create') }}">
                                            <button class="dropdown-link" type="submit">
                                                {{- ux_icon('lucide:biceps-flexed') -}}
                                                <span>Start workout</span>
                                            </button>
                                        </form>
                                    </li>
                                {%- endif -%}
                            </ul>
                        </div>
                        <div class="header-divider"></div>
                    {%- endblock -%}

                    <button id="theme-toggler" class="header-button">
                        <span class="theme-light">{{ ux_icon('lucide:sun') }}</span>
                        <span class="theme-dark">{{ ux_icon('lucide:moon') }}</span>
                    </button>

                    {%- if is_granted('ROLE_USER') -%}
                        <a class="header-button" href="{{ logout_path() }}">{{ ux_icon('lucide:log-out') }}</a>
                    {%- endif -%}
                </div>
            </nav>
        </header>
    {%- endblock -%}

    {%- block sidebar -%}
        {%- set _route = app.current_route -%}
        <aside id="sidebar" class="sidebar">
            <nav class="navbar">
                <ul class="navbar-nav">
                    {%- if is_granted('CALENDAR_VIEW') -%}
                        <li class="nav-item">
                            <a class="nav-link {{ _route === 'app_calendar' or _route === 'app_calendar_day' ? 'active' }}"
                               href="{{ path('app_calendar') }}">
                                {{- ux_icon('lucide:calendar-heart', {class: 'icon-fix-top'}) -}}
                                <span>Calendar</span>
                            </a>
                        </li>
                    {%- endif -%}

                    <li>
                        <span class="nav-title-divider">Reflection</span>
                    </li>
                    {%- if is_granted('MOOD_REFLECTION_VIEW') -%}
                        <li class="nav-item">
                            <a class="nav-link {{ _route === 'app_mood_reflections' or _route === 'app_mood_reflection_edit' ? 'active' }}"
                               href="{{ path('app_mood_reflections') }}">
                                {{- ux_icon('lucide:smile-plus') -}}
                                <span>Mood tracker</span>
                            </a>
                        </li>
                    {%- endif -%}
                    {%- if is_granted('WEEKLY_REFLECTION_VIEW') -%}
                        <li class="nav-item">
                            <a class="nav-link {{ _route === 'app_weekly_reflections' or _route === 'app_weekly_reflection_edit' ? 'active' }}"
                               href="{{ path('app_weekly_reflections') }}">
                                {{- ux_icon('lucide:star') -}}
                                <span>Week in review</span>
                            </a>
                        </li>
                    {%- endif -%}

                    <li>
                        <span class="nav-title-divider">Health</span>
                    </li>
                    {%- if is_granted('BODY_MEASUREMENT_VIEW') -%}
                        <li class="nav-item">
                            <a class="nav-link {{ _route === 'app_measurements' or _route === 'app_measurement_create' or _route === 'app_measurement_edit' ? 'active' }}"
                               href="{{ path('app_measurements') }}">
                                {{- ux_icon('lucide:ruler-dimension-line') -}}
                                <span>Measurements</span>
                            </a>
                        </li>
                    {%- endif -%}
                    {%- if is_granted('WORKOUT_VIEW') -%}
                        <li class="nav-item">
                            <a class="nav-link {{ _route === 'app_workouts' or _route === 'app_workouts_view' ? 'active' }}"
                               href="{{ path('app_workouts') }}">
                                {{- ux_icon('lucide:dumbbell') -}}
                                <span>Workouts</span>
                            </a>
                        </li>
                    {%- endif -%}

                    <li>
                        <hr class="nav-divider">
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ _route === 'app_profile' or _route === 'app_profile_location' or _route === 'app_profile_password' ? 'active' }}"
                           href="{{ path('app_profile') }}">
                            {{- ux_icon('lucide:user') -}}
                            <span>Profile</span>
                        </a>
                    </li>

                    {%- if is_granted('ROLE_ADMIN') -%}
                        <li>
                            <hr class="nav-divider">
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{ _route === 'app_admin_homepage' ? 'active' }}"
                               href="{{ path('app_admin_homepage') }}">
                                {{- ux_icon('lucide:shield-user') -}}
                                <span>Admin</span>
                                {%- if has_admin_alerts() -%}
                                    <span class="nav-icon icon-danger">{{ ux_icon('lucide:triangle-alert') }}</span>
                                {%- endif -%}
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{ _route === 'app_admin_users' or _route === 'app_admin_user_edit' ? 'active' }}"
                               href="{{ path('app_admin_users') }}">
                                {{- ux_icon('lucide:users') -}}
                                <span>Users</span>
                            </a>
                        </li>
                    {%- endif -%}
                </ul>
            </nav>
        </aside>
    {%- endblock -%}

    <div class="body">
        {%- block body -%}
            <main class="body-container">
                {%- block breadcrumb -%}
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="{{ path('app_homepage') }}">{{ ux_icon('lucide:house') }}</a>
                            </li>
                            {%- for crumb in breadcrumbs|default([{ label: 'Homepage' }]) -%}
                                <li class="breadcrumb-item {% if loop.last %}active{% endif %}">
                                    {%- if crumb.url is defined -%}
                                        <a href="{{ crumb.url }}">{{ crumb.label }}</a>
                                    {%- else -%}
                                        {{- crumb.label -}}
                                    {%- endif -%}
                                </li>
                            {%- endfor -%}
                        </ol>
                    </nav>
                {%- endblock -%}

                <div id="body-messages" class="body-messages">
                    {%- block flash_messages -%}
                        {%- if app.request.hasPreviousSession -%}
                            {%- for type, messages in app.flashes -%}
                                {%- for message in messages -%}
                                    <div class="alert alert-{{ type }}" role="alert">{{ message|trans }}</div>
                                {%- endfor -%}
                            {%- endfor -%}
                        {%- endif -%}
                    {%- endblock -%}
                </div>

                {%- block showcase %}{% endblock -%}

                {%- block body_title -%}
                    <div class="page-title">
                        <h1>{% block page_title %}{{ block('title') }}{% endblock %}</h1>
                        <div class="page-links">{% block page_links %}{% endblock %}</div>
                    </div>
                {%- endblock -%}

                {%- block main %}{% endblock -%}
            </main>
        {%- endblock -%}

        {%- block footer -%}
            <footer class="footer-container">
                <div class="footer-datetime">
                    <span>Server: {{ 'now'|date('j F, H:i') }}</span>
                    {%- if app.user -%}
                        <span>User: {{ user_date().format('j F, H:i') }}</span>
                    {%- endif -%}
                </div>
                <div class="footer-controls">
                    {%- if app.debug -%}
                        <div class="footer-toolbar" id="footer-toolbar">
                            {{- ux_icon('lucide:database') -}}
                            <span>0</span>
                        </div>
                    {%- endif -%}
                    <div class="footer-bird" id="footer-bird">{{ ux_icon('lucide:bird') }}</div>
                </div>
            </footer>
        {%- endblock -%}
    </div>
</body>
</html>
