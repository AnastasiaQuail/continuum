{%- if app.user and is_couple_day() -%}
    {%- set html_data_day = 'data-couple-day' -%}
    {%- set icon_href = asset('icon-couple-day.svg') -%}
{%- elseif app.user and user_date().format('m-d') === '03-08' -%}
    {%- set html_data_day = 'data-women-day' -%}
    {%- set icon_href = asset('icon-women-day.svg') -%}
{%- else -%}
    {%- set html_data_day = null -%}
    {%- set icon_href = asset('icon.svg') -%}
{%- endif -%}

{%- set body_id = block('body_id') -%}

{% import 'default/_sidebar.html.twig' as sidebar %}

<!DOCTYPE html>
<html lang="en" data-timezone="{{ app.user?.timezone.name }}" {{ html_data_day }}>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>{% block title %}{{ app_title }}{% endblock %}</title>
    <link rel="manifest" href="{{ path('app_manifest') }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('icon_apple_180.png') }}">
    <link rel="shortcut icon" type="image/svg+xml" href="{{ icon_href }}">
    <script>
        Object.keys(localStorage)
            .filter(key => key.startsWith('continuum-ls-'))
            .map(key => document.documentElement.setAttribute(`data-${key.slice(13)}`, localStorage.getItem(key)));
    </script>
    {%- block stylesheets -%}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet"
              href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&display=swap">
    {%- endblock -%}
    {%- block javascripts -%}
        {%- block importmap %}{{ importmap('app') }}{% endblock -%}
    {%- endblock -%}
</head>
<body id="{{ body_id }}" class="{% if sidebar_show|default !== 'hide' %}has-sidebar{% endif %}">
    {%- block header -%}
        <header class="header">
            <nav class="header-container">
                {%- set back_path = back_path|default -%}
                {%- set sidebar_show = sidebar_show|default !== 'hide' -%}

                {%- if back_path or sidebar_show -%}
                    <div class="btn-group-glass btn-group-header-controls">
                        {%- if back_path -%}
                            <a id="previous-page-button" class="btn btn-glass btn-header" href="{{ back_path }}">
                                {{- ux_icon('lucide:chevron-left', {class: 'icon-fix-scale'}) -}}
                            </a>
                        {%- endif -%}
                        {%- if sidebar_show -%}
                            <button id="sidebar-toggler" class="btn btn-glass btn-header">
                                {{- ux_icon('lucide:menu', {class: 'icon-menu-open'}) -}}
                                {{- ux_icon('lucide:x', {class: 'icon-menu-close'}) -}}
                            </button>
                        {%- endif -%}
                    </div>
                {%- endif -%}

                <div class="header-logo">
                    <a class="header-logo-link" href="{{ path('app_homepage') }}">
                        {{- ux_icon('hugeicons:infinity-02') -}}
                        <span class="logo-text">{{ app_title }}</span>
                    </a>
                </div>

                <div class="header-title">
                    <h1 id="page-title-{{ body_id }}">{% block page_title %}{{ block('title') }}{% endblock %}</h1>
                    <h2 class="header-subtitle">{% block page_subtitle %}{% endblock %}</h2>
                </div>

                <div class="header-actions">
                    <div class="btn-group-glass btn-group-header-actions">
                        {%- block header_actions -%}
                            <div class="btn-header btn-dropdown">
                                <div id="shortcut-links-button" class="btn btn-glass" tabindex="0">
                                    <span class="dropdown-icon">{{ ux_icon('lucide:ellipsis') }}</span>
                                    <ul class="dropdown-menu">
                                        {%- block header_actions_shortcut -%}
                                            <li class="dropdown-item">
                                                {%- set is_granted = is_granted('CALENDAR_EDIT') -%}

                                                <{% if is_granted %}a{% else %}button{% endif %}
                                                    {% if is_granted %} href="{{ path('app_calendar_day', {day: user_date('+1 day').format('Y-m-d')}) }}"{% else %} disabled{% endif %}
                                                    class="dropdown-link">
                                                    {{- ux_icon('lucide:calendar-plus') -}}
                                                    <span>New event</span>
                                                </{% if is_granted %}a{% else %}button{% endif %}>
                                            </li>
                                            <li class="dropdown-item">
                                                <hr class="dropdown-divider">
                                            </li>
                                            <li class="dropdown-item">
                                                {%- set is_granted = is_granted('MOOD_REFLECTION_EDIT') -%}

                                                <{% if is_granted %}a{% else %}button{% endif %}
                                                    {% if is_granted %} href="{{ path('app_mood_reflection_last_unfilled') }}"{% else %} disabled{% endif %}
                                                    class="dropdown-link">
                                                    {{- ux_icon('lucide:scan-face') -}}
                                                    <span>Track mood</span>
                                                </{% if is_granted %}a{% else %}button{% endif %}>
                                            </li>
                                            <li class="dropdown-item">
                                                {%- set is_granted = is_granted('BODY_MEASUREMENT_CREATE') -%}

                                                <{% if is_granted %}a{% else %}button{% endif %}
                                                    {% if is_granted %} href="{{ path('app_measurement_create') }}"{% else %} disabled{% endif %}
                                                    class="dropdown-link">
                                                    {{- ux_icon('lucide:ruler') -}}
                                                    <span>Add measurement</span>
                                                </{% if is_granted %}a{% else %}button{% endif %}>
                                            </li>
                                            <li class="dropdown-item">
                                                <form method="post" action="{{ path('app_workout_create') }}">
                                                    <button class="dropdown-link"
                                                            {% if is_granted('WORKOUT_CREATE') %}type="submit"{% else %} disabled{% endif %}>
                                                        {{- ux_icon('lucide:biceps-flexed') -}}
                                                        <span>Start workout</span>
                                                    </button>
                                                </form>
                                            </li>
                                        {%- endblock -%}
                                    </ul>
                                </div>
                            </div>
                        {%- endblock -%}
                    </div>
                </div>
            </nav>
        </header>
    {%- endblock -%}

    {%- block sidebar -%}
        <aside id="sidebar" class="sidebar">
            <div id="sidebar-handle" class="sidebar-handle"></div>
            <div class="sidebar-logo">
                <a class="sidebar-logo-link" href="{{ path('app_homepage') }}">
                    {{- ux_icon('hugeicons:infinity-02') -}}
                    <span>{{ app_title }}</span>
                </a>
            </div>
            <nav class="navbar">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        {{- sidebar.item(
                            'app_calendar',
                            ['app_calendar_day'],
                            ux_icon('lucide:calendar-heart', {class: 'icon-fix-top'}),
                            'Calendar',
                            is_granted('CALENDAR_VIEW'),
                        ) -}}
                    </li>

                    <li>{{ sidebar.divider('Reflection') }}</li>
                    <li class="nav-item">
                        {{- sidebar.item(
                            'app_mood_reflections',
                            ['app_mood_reflection_edit'],
                            ux_icon('lucide:smile-plus'),
                            'Mood tracker',
                            is_granted('MOOD_REFLECTION_VIEW'),
                        ) -}}
                    </li>
                    <li class="nav-item">
                        {{- sidebar.item(
                            'app_weekly_reflections',
                            ['app_weekly_reflection_edit'],
                            ux_icon('lucide:star'),
                            'Week in review',
                            is_granted('WEEKLY_REFLECTION_VIEW'),
                        ) -}}
                    </li>

                    <li>{{ sidebar.divider('Health') }}</li>
                    <li class="nav-item">
                        {{- sidebar.item(
                            'app_measurements',
                            ['app_measurement_create', 'app_measurement_edit', 'app_measurements_history'],
                            ux_icon('lucide:ruler-dimension-line'),
                            'Measurements',
                            is_granted('BODY_MEASUREMENT_VIEW'),
                        ) -}}
                    </li>
                    <li class="nav-item">
                        {{- sidebar.item(
                            'app_workouts',
                            ['app_workouts_view', 'app_exercises', 'app_exercise_create', 'app_exercise_edit'],
                            ux_icon('lucide:dumbbell'),
                            'Workouts',
                            is_granted('WORKOUT_VIEW'),
                        ) -}}
                    </li>

                    <li>{{ sidebar.divider('Settings') }}</li>
                    <li class="nav-item">
                        {{- sidebar.item(
                            'app_profile',
                            ['app_profile_location', 'app_profile_password'],
                            ux_icon('lucide:user'),
                            'Profile',
                        ) -}}
                    </li>
                    {%- if is_granted('REPORT_MONTH_VIEW') -%}
                        <li class="nav-item" data-general-type="red">
                            {{- sidebar.item(
                                'app_report_month',
                                [],
                                ux_icon('lucide:chart-bar-big'),
                                'Monthly report',
                                true,
                                user_date().format('j') <= 3 ? {icon: ux_icon('lucide:badge-info'), type: 'orange'} : {},
                            ) -}}
                        </li>
                    {%- endif -%}
                    {%- if is_granted('ADMIN_USER_VIEW') -%}
                        <li class="nav-item">
                            {{- sidebar.item(
                                'app_admin_users',
                                ['app_admin_user_edit'],
                                ux_icon('lucide:users'),
                                'Users',
                            ) -}}
                        </li>
                    {%- endif -%}
                    {%- if is_granted('ADMIN_BACKUP_VIEW') -%}
                        <li class="nav-item">
                            {{- sidebar.item(
                                'app_admin_backups',
                                [],
                                ux_icon('lucide:database-backup'),
                                'Backups',
                                true,
                                has_backup_alert() ? {icon: ux_icon('lucide:triangle-alert'), type: 'red'} : null,
                            ) -}}
                        </li>
                    {%- endif -%}
                </ul>
            </nav>

            <nav class="navbar navbar-footer">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        {{- sidebar.action_button(
                            ux_icon('lucide:sun', {class: 'theme-light'}) ~ ux_icon('lucide:moon', {class: 'theme-dark'}),
                            'Appearance',
                            'theme-toggler',
                        ) -}}
                    </li>
                    {%- if logout_show|default !== 'hide' and is_granted('ROLE_USER') -%}
                        <li class="nav-item nav-item-logout">
                            {{- sidebar.link(
                                logout_path(),
                                ux_icon('lucide:log-out'),
                                'Logout',
                            ) -}}
                        </li>
                    {%- endif -%}
                </ul>
            </nav>
        </aside>
    {%- endblock -%}

    <div class="body">
        <div id="body-messages" class="body-messages">
            {%- if app.request.hasPreviousSession -%}
                {%- for type, messages in app.flashes -%}
                    {%- for message in messages -%}
                        <div class="alert alert-{{ type }} alert-dismissible hidden"
                             role="alert">{{ message|trans }}</div>
                    {%- endfor -%}
                {%- endfor -%}
            {%- endif -%}
        </div>

        {%- block body -%}
            <main class="body-container">
                {%- block showcase %}{% endblock -%}

                {%- block body_actions -%}{%- endblock -%}

                {%- block main %}{% endblock -%}
            </main>
        {%- endblock -%}

        {%- block footer -%}
            <footer class="footer-container">
                <div class="footer-controls">
                    {%- if app.debug and is_granted('ROLE_SUPER_ADMIN') -%}
                        <div class="footer-control footer-control-link" id="footer-toolbar">
                            {{- ux_icon('lucide:database') -}}
                            <span>0</span>
                        </div>
                    {%- endif -%}
                    <div class="footer-control footer-control-link" id="footer-dog"
                         data-href="{{ path('app_easter_egg_dog') }}">
                        {{- ux_icon('lucide:dog') -}}
                    </div>
                    <div class="footer-control footer-control-bird">
                        {{- ux_icon('lucide:bird') }}{{ bird_name() -}}
                    </div>
                </div>
            </footer>
        {%- endblock -%}
    </div>
</body>
</html>
