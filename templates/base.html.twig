<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Continuum{% endblock %}</title>
    <link rel="icon"
          href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

    {% block stylesheets %}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet"
              href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&display=swap">
    {% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body id="{% block body_id %}{% endblock %}">
    {% block sidebar %}
        <aside id="sidebar" class="sidebar">
            <div class="site-logo">
                <a class="site-logo-link" href="{{ path('app_homepage') }}">
                    {{ ux_icon('hugeicons:infinity-02') }}
                    <span>Continuum</span>
                </a>
            </div>
            <nav class="navbar">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link active" href="#">
                            {{ ux_icon('lucide:calendar-heart', {class: 'icon-fix-top'}) }}
                            <span>Calendar</span>
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <button class="nav-link">
                            {{ ux_icon('lucide:brain') }}
                            <span>Brain</span>
                            {{ ux_icon('lucide:chevron-right', {class: 'dropdown-toggle-chevron'}) }}
                        </button>
                        <ul class="navbar-nav nav-dropdown">
                            <li class="nav-item">
                                <a class="nav-link" href="#">
                                    {{ ux_icon('lucide:smile-plus') }}
                                    <span>Mental pulse</span>
                                </a>
                                <a class="nav-link" href="#">
                                    {{ ux_icon('lucide:medal') }}
                                    <span>Week reflection</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <button class="nav-link">
                            {{ ux_icon('lucide:biceps-flexed') }}
                            <span>Body</span>
                            {{ ux_icon('lucide:chevron-right', {class: 'dropdown-toggle-chevron'}) }}
                        </button>
                        <ul class="navbar-nav nav-dropdown">
                            <li class="nav-item">
                                <a class="nav-link" href="#">
                                    {{ ux_icon('lucide:dumbbell') }}
                                    <span>Exercises</span>
                                </a>
                                <a class="nav-link" href="#">
                                    {{ ux_icon('lucide:ruler-dimension-line') }}
                                    <span>Measurements</span>
                                </a>
                                <a class="nav-link" href="#">
                                    {{ ux_icon('lucide:chart-line') }}
                                    <span>Statistics</span>
                                </a>
                            </li>
                        </ul>
                    </li>

                    {% if is_granted('ROLE_ADMIN') %}
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                {{ ux_icon('lucide:shield-user') }}
                                <span>Admin</span>
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </nav>
        </aside>
    {% endblock %}

    {% block header %}
        {% set _route = app.current_route %}
        <header class="header">
            <nav class="header-container">
                {% if block('sidebar') is not empty %}
                    <button id="sidebar-toggler" class="header-button">{{ ux_icon('lucide:menu') }}</button>
                {% endif %}
                <button id="theme-toggler" class="header-button">
                    <span class="theme-light">{{ ux_icon('lucide:sun') }}</span>
                    <span class="theme-dark">{{ ux_icon('lucide:moon') }}</span>
                </button>
                {% if is_granted('ROLE_USER') %}
                    <a class="header-button" href="{{ logout_path() }}">{{ ux_icon('lucide:log-out') }}</a>
                {% endif %}
            </nav>
        </header>
    {% endblock %}

    <div class="body">
        {% block body %}
            <div class="body-container">
                {% block main %}{% endblock %}
            </div>
        {% endblock %}
    </div>
</body>
</html>
