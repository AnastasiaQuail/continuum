<!DOCTYPE html>
<html lang="en" data-timezone="{{ app.user ? app.user.timezone.name }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Continuum{% endblock %}</title>
    <link rel="shortcut icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">

    {% block stylesheets %}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet"
              href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&display=swap">
    {% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body id="{% block body_id %}{% endblock %}">
    {%- block header -%}
        <header class="header">
            <nav class="header-container">
                {%- if block('sidebar') is not empty -%}
                    <div class="header-logo">
                        <a class="header-logo-link" href="{{ path('app_homepage') }}">
                            {{ ux_icon('hugeicons:infinity-02') }}
                            <span>Continuum</span>
                        </a>
                    </div>
                    <button id="sidebar-toggler" class="header-button">{{ ux_icon('lucide:menu') }}</button>
                {%- endif -%}
                <button id="theme-toggler" class="header-button">
                    <span class="theme-light">{{ ux_icon('lucide:sun') }}</span>
                    <span class="theme-dark">{{ ux_icon('lucide:moon') }}</span>
                </button>
                {%- if is_granted('ROLE_USER') -%}
                    <a class="header-button" href="{{ logout_path() }}">{{ ux_icon('lucide:log-out') }}</a>
                {%- endif -%}
            </nav>
        </header>
    {%- endblock -%}

    {%- block sidebar -%}
        {%- set _route = app.current_route -%}
        <aside id="sidebar" class="sidebar">
            <nav class="navbar">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link {{- _route == 'app_calendar' or _route == 'app_calendar_date' ? ' active' }}"
                           href="{{ path('app_calendar') }}">
                            {{ ux_icon('lucide:calendar-heart', {class: 'icon-fix-top'}) }}
                            <span>Calendar</span>
                        </a>
                    </li>

                    <li>
                        <span class="nav-title-divider">Reflection</span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            {{ ux_icon('lucide:smile-plus') }}
                            <span>Mood tracker</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            {{ ux_icon('lucide:medal') }}
                            <span>Week in review</span>
                        </a>
                    </li>

                    <li>
                        <span class="nav-title-divider">Health</span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            {{ ux_icon('lucide:dumbbell') }}
                            <span>Exercises</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            {{ ux_icon('lucide:ruler-dimension-line') }}
                            <span>Measurements</span>
                        </a>
                    </li>

                    {%- if is_granted('ROLE_ADMIN') -%}
                        <li>
                            <hr class="nav-divider">
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                {{ ux_icon('lucide:shield-user') }}
                                <span>Admin</span>
                            </a>
                        </li>
                    {%- endif -%}
                </ul>
            </nav>
        </aside>
    {%- endblock -%}

    <div class="body">
        {%- block body -%}
            <div class="body-container">
                {%- block breadcrumb -%}
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="{{ path('app_homepage') }}">{{ ux_icon('lucide:house') }}</a>
                            </li>
                            {%- for crumb in breadcrumbs|default([{ label: 'Homepage' }]) -%}
                                <li class="breadcrumb-item {% if loop.last %}active{% endif %}">
                                    {%- if crumb.url is defined -%}
                                        <a href="{{ crumb.url }}">{{ crumb.label }}</a>
                                    {%- else -%}
                                        {{ crumb.label }}
                                    {%- endif -%}
                                </li>
                            {%- endfor -%}
                        </ol>
                    </nav>
                {%- endblock -%}

                <div id="body-messages" class="body-messages">
                    {%- block flash_messages -%}
                        {%- if app.request.hasPreviousSession -%}
                            {%- for type, messages in app.flashes -%}
                                {%- for message in messages -%}
                                    <div class="alert alert-{{ type }}" role="alert">{{ message|trans }}</div>
                                {%- endfor -%}
                            {%- endfor -%}
                        {%- endif -%}
                    {%- endblock -%}
                </div>

                {%- block main %}{% endblock -%}
            </div>
        {%- endblock -%}

        {%- block footer -%}
            <footer class="footer-container">
                <div class="footer-datetime">
                    <span>Server: {{ 'now'|date('j F, H:i') }}</span>
                    {% if app.user %}
                        <span>User: {{ 'now'|date('j F, H:i', app.user.timezone) }}</span>
                    {% endif %}
                </div>
            </footer>
        {%- endblock -%}
    </div>
</body>
</html>
