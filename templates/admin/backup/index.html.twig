{% extends 'admin.html.twig' %}

{% block title %}Database backups{% endblock %}
{% block page_title %}Backups{% endblock %}
{% block body_id %}admin-backups{% endblock %}

{% block header_actions -%}
    <form method="post" action="{{ path('app_admin_backup_create') }}">
        <button
            class="btn btn-glass"
            {% if is_granted('ADMIN_BACKUP_CREATE') %}type="submit" {% else %}disabled{% endif %}>
            Back up
        </button>
    </form>
{%- endblock %}

{% block main -%}
    {%- if not has_relevant_backup -%}
        <div class="alert alert-danger alert-inline">
            {{ ux_icon('lucide:triangle-alert') }}
            <span>More one day from last backup!</span>
        </div>
    {%- endif -%}

    <twig:Card class="card-backups">
        {%- for backup in backups|reverse -%}
            {%- set is_granted = is_granted('ADMIN_BACKUP_DOWNLOAD') -%}
            {%- set backup_date = backup.date.setTimezone(app.user.timezone).format('j F Y, H:i') -%}

            <{% if is_granted %}a{% else %}div{% endif %}
                {% if is_granted %}href="{{ path('app_admin_backup_download', {filename: backup.name}) }}"{% endif %}
                class="backup">

                <div>
                    <div class="backup-date">{{ backup_date }}</div>

                    <div class="backup-information">
                        <span class="backup-size">{{ (backup.size / 1024 / 1024)|number_format(2, '.', ' ') }} MB</span>
                        <span>{{ backup.name }}</span>
                    </div>
                </div>

                <div class="backup-download">{{ ux_icon('lucide:download') }}</div>
            </{% if is_granted %}a{% else %}div{% endif %}>
        {%- endfor -%}
    </twig:Card>
{%- endblock %}
