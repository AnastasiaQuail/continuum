{% extends 'base.html.twig' %}

{% block title %}Edit user{% endblock %}
{% block page_title %}User{% endblock %}
{% block body_id %}admin-user-edit{% endblock %}

{% set back_path = path('app_admin_users') %}

{% block header_actions -%}
    <twig:Form:ExternalSubmit target="#form-user-edit"/>
{%- endblock %}

{% block main -%}
    <twig:CardForm>
        {{- form_start(form, {attr: {id: 'form-user-edit', class: 'form-submit-external'}}) -}}

        <twig:Form:RowField label="Login">{{ user.userIdentifier }}</twig:Form:RowField>

        {{- form_row(form.status) -}}
        {{- form_row(form.roles, {attr: {placeholder: 'Required'}}) -}}

        <twig:Form:Submit/>

        {{- form_end(form) -}}
    </twig:CardForm>
{%- endblock %}
