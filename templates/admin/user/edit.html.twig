{% extends 'base.html.twig' %}

{% block title %}Edit user{% endblock %}
{% block page_title %}User{% endblock %}
{% block body_id %}admin-user-edit{% endblock %}

{% set back_path = path('app_admin_users') %}

{% block main -%}
    <section class="card">
        {{- form_start(form) -}}

        <div class="mb-3">
            <div class="form-label">Login</div>
            <div>{{ user.userIdentifier }}</div>
        </div>

        <div class="mb-3">
            {{- form_label(form.status) -}}
            <div class="form-control-choose-type-group">
                {%- for choice in form.status.vars.choices -%}
                    <label class="form-control-choose-type"
                           data-general-type="{{ choice.data.color.value }}">
                        <input type="radio" name="status" id="{{ form.status.vars.id }}_{{ choice.value }}"
                               value="{{ choice.value }}"
                               {% if form.status.vars.required %}required="required"{% endif %}
                            {% if choice.value === form.status.vars.value %}checked{% endif %}>
                        <span class="btn" tabindex="0">{{ choice.label }}</span>
                    </label>
                {%- endfor -%}
            </div>
            {{- form_errors(form.status) -}}
            {%- do form.status.setRendered -%}
        </div>

        {{- form_row(form.roles) -}}

        <div class="card-submit">
            <button type="submit" class="btn btn-primary btn-outline">Save</button>
        </div>

        {{- form_end(form) -}}
    </section>
{%- endblock %}
