{% extends 'admin.html.twig' %}

{% block title %}Users management{% endblock %}
{% block body_id %}admin-users{% endblock %}

{% set breadcrumbs = [
    {label: 'Users'},
] %}

{% block main -%}
    <section class="card">
        <div class="users">
            {%- for user in users -%}
                {%- set is_granted = is_granted('ADMIN_USER_EDIT', user) -%}
                <div class="user" data-general-type="{{ user.status.color.value }}">
                    <{% if is_granted %}a{% else %}div{% endif %}
                        {% if is_granted %}href="{{ path('app_admin_user_edit', {id: user.id}) }}"{% endif %}
                        class=" user-identifier">
                        <div class="badge">{{ user.status.name }}</div>
                        <div class="user-email">{{ user.userIdentifier }}</div>
                    </{% if is_granted %}a{% else %}div{% endif %}>

                    <div class="user-roles">
                        {%- for role in user.roles -%}
                            <span class="badge">{{ role|slice(5) }}</span>
                        {%- endfor -%}
                    </div>

                    <div class="user-geo">{{ user.timezone.name }}</div>

                    <div class="user-last-visited">
                        {{- user.lastVisitedAt.setTimezone(app.user.timezone).format('j F Y, H:i') -}}
                    </div>
                </div>
            {%- endfor -%}
        </div>
    </section>
{%- endblock %}
