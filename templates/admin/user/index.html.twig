{% extends 'admin.html.twig' %}

{% block title %}Users{% endblock %}
{% block body_id %}admin-users{% endblock %}

{% block main -%}
    {%- set date = user_date() -%}

    {%- for user in users -%}
        <twig:CardForm isPlain>
            <twig:Form:RowField isHeaderLarge href="{{ path('app_admin_user_edit', {id: user.id}) }}"
                                isGranted="{{ is_granted('ADMIN_USER_EDIT', user) }}">
                <twig:block name="label">
                    <twig:Badge color="{{ user.status.color.value }}">{{ user.status.name }}</twig:Badge>
                    {{ user.userIdentifier }}
                </twig:block>
            </twig:Form:RowField>

            <twig:Form:RowField label="Last online">
                {%- set last_visited_date = user.lastVisitedAt.setTimezone(app.user.timezone) -%}
                {%- set diff_days = last_visited_date.diff(date).days -%}
                {%- set general_type = diff_days >= 14 ? 'red' : (diff_days >= 7 ? 'orange' : null) -%}

                <span {% if general_type %}data-general-type="{{ general_type }}"{% endif %}>
                    {{- last_visited_date.format('j F, H:i') -}}
                </span>
            </twig:Form:RowField>

            <twig:Form:RowField label="Roles">
                {%- for role in user.roles -%}
                    <twig:Badge>{{ role|slice(5) }}</twig:Badge>
                {%- endfor -%}
            </twig:Form:RowField>

            <twig:Form:RowField
                href="https://maps.apple.com/?q={{ user.location.latitude }},{{ user.location.longitude }}"
                target="_blank" label="Location">
                {{- user.timezone.name -}}
            </twig:Form:RowField>
        </twig:CardForm>

        <twig:Card:Description>
            <twig:Card:DescriptionLine>
                <span>Created:</span>
                <span>{{ user.createdAt.setTimezone(app.user.timezone).format('j F Y, H:i') }}</span>
            </twig:Card:DescriptionLine>
            <twig:Card:DescriptionLine>
                <span>Updated:</span>
                <span>{{ user.updatedAt.setTimezone(app.user.timezone).format('j F Y, H:i') }}</span>
            </twig:Card:DescriptionLine>
        </twig:Card:Description>
    {%- endfor -%}
{%- endblock %}
