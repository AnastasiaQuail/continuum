{% extends 'admin.html.twig' %}

{% block title %}Admin homepage{% endblock %}
{% block body_id %}admin-homepage{% endblock %}

{% set breadcrumbs = [
    { label: 'Admin' },
] %}

{% block main -%}
    <section class="card">
        {%-if not hasDBBackup -%}
            <div class="alert alert-danger alert-inline">
                <span>More one day from last backup!</span>
                <form method="post" action="{{ path('app_admin_database_backup_create') }}">
                    <button class="btn btn-danger btn-sm">
                        {{- ux_icon('lucide:database-backup') -}}
                        <span>Create Backup</span>
                    </button>
                </form>
            </div>
        {%-else -%}
            <form method="post" action="{{ path('app_admin_database_backup_create') }}">
                <button class="btn btn-primary btn-transparent">
                    {{- ux_icon('lucide:database-backup') -}}
                    <span>Create Backup</span>
                </button>
            </form>
        {%-endif -%}
    </section>

    <section class="card">
        <h3>Error pages</h3>
        <div>
            <a class="btn btn-transparent btn-warning" href="{{ path('_preview_error', {'code': 400}) }}">400</a>
            <a class="btn btn-transparent btn-warning" href="{{ path('_preview_error', {'code': 401}) }}">401</a>
            <a class="btn btn-transparent btn-danger" href="{{ path('_preview_error', {'code': 403}) }}">403</a>
            <a class="btn btn-transparent btn-secondary" href="{{ path('_preview_error', {'code': 404}) }}">404</a>
            <a class="btn btn-transparent btn-danger" href="{{ path('_preview_error', {'code': 500}) }}">500</a>
        </div>
    </section>
{%- endblock %}
