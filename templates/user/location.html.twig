{% extends 'base.html.twig' %}

{%- block javascripts -%}
    {{ parent() }}
    <script src="{{ asset('js/profile.js') }}"></script>
{%- endblock -%}

{% block title %}Edit location{% endblock %}
{% block page_title %}Location{% endblock %}
{% block body_id %}profile-location{% endblock %}

{% set back_path = path('app_profile') %}

{% block header_actions -%}
    <twig:Form:ExternalSubmit target="#form-profile-location"/>
{%- endblock %}

{% block main -%}
    <twig:CardForm id="profile-location-card">
        {{- form_start(form, {attr: {id: 'form-profile-location', class: 'form-submit-external'}}) -}}

        {{- form_row(form.latitude, {attr: {placeholder: 'Required'}}) -}}
        {{- form_row(form.longitude, {attr: {placeholder: 'Required'}}) -}}

        <twig:Form:Row class="form-row-post">
            <div class="alert alert-danger" style="display: none" id="alert-error">
                <div class="alert-title">
                    {{ ux_icon('lucide:triangle-alert') }}
                    <strong>Location blocked by browser.</strong>
                </div>
                <div>
                    <small>
                        To determine your location you can use
                        <a href="https://iplocation.io/my-location#g_latitude" target="_blank">this site</a>
                        or <a href="https://www.woosmap.com/where-am-i-find-my-location" target="_blank">this</a>
                    </small>
                </div>
            </div>

            <button class="btn btn-sm btn-primary btn-link" id="location-detector"
                    data-input-latitude="latitude" data-input-longitude="longitude" data-error="alert-error">
                {{ ux_icon('lucide:locate') }}
                <span>Detect current location</span>
            </button>
        </twig:Form:Row>

        <twig:Form:Submit/>

        {{- form_end(form) -}}
    </twig:CardForm>
{%- endblock %}
