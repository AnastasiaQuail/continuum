{% extends 'base.html.twig' %}

{% block title %}Change password{% endblock %}
{% block body_id %}profile-password{% endblock %}

{% set back_path = path('app_profile') %}

{% block main -%}
    <div class="alert alert-warning">After changing your password, you will be logged out of the application.</div>

    <section id="profile-card" class="card">
        {{- form_start(form) -}}

        {{- form_widget(form) -}}

        <div class="card-submit">
            <button type="submit" class="btn btn-primary btn-outline">Save</button>
        </div>

        {{- form_end(form) -}}
    </section>
{%- endblock %}
