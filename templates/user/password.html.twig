{% extends 'base.html.twig' %}

{% block title %}Change password{% endblock %}
{% block page_title %}Password{% endblock %}
{% block body_id %}profile-password{% endblock %}

{% set back_path = path('app_profile') %}

{% block main -%}
    <div class="alert alert-warning">After changing your password, you will be logged out of the application.</div>

    <section id="profile-card" class="card card-form">
        {{- form_start(form) -}}

        {{- form_row(form.currentPassword, {attr: {placeholder: 'Required'}}) -}}
        {{- form_row(form.newPassword.first, {attr: {placeholder: 'Required'}}) -}}
        {{- form_row(form.newPassword.second, {attr: {placeholder: 'Required'}}) -}}

        {{- form_row_submit() -}}

        {{- form_end(form) -}}
    </section>
{%- endblock %}
