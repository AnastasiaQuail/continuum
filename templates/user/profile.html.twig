{% extends 'base.html.twig' %}

{% block title %}Profile{% endblock %}
{% block body_id %}profile{% endblock %}

{% block main -%}
    <section id="profile-card" class="card card-form card-form-plain">
        <div class="card-form-row">
            <label class="form-label">{{ ux_icon('lucide:user') }} Status</label>
            <div class="form-field">
                {%- set status = app.user.status -%}
                <span class="badge" data-general-type="{{ status.color.value }}">{{ status.name }}</span>
            </div>
        </div>

        <div class="card-form-row">
            <label class="form-label">{{ ux_icon('lucide:mail') }} Email</label>
            <div class="form-field">
                <strong>{{ app.user.userIdentifier|email_secure }}</strong>
            </div>
        </div>

        <div class="card-form-row">
            <label class="form-label">{{ ux_icon('lucide:key-round') }} Password</label>
            <a class="form-field form-field-link" href="{{ path('app_profile_password') }}">
                <span>**********</span>
                {{ ux_icon('lucide:chevron-right') }}
            </a>
        </div>
    </section>

    <h2>Geoposition</h2>

    <section id="profile-location-card" class="card card-form card-form-plain">
        <div class="card-form-row">
            <label class="form-label">{{ ux_icon('lucide:clock') }} Timezone</label>
            <div class="form-field">{{ app.user.timezone.name }}</div>
        </div>

        <div class="card-form-row">
            <label class="form-label">{{ ux_icon('lucide:map-pin') }} Location</label>
            <a class="form-field form-field-link" href="{{ path('app_profile_location') }}">
                <span>{{ app.user.location.latitude ~ ' : ' ~ app.user.location.longitude }}</span>
                {{ ux_icon('lucide:chevron-right') }}
            </a>
        </div>
    </section>

    <div class="text-footer">Created: {{ app.user.createdAt.format('j F Y, H:i') }}</div>
{%- endblock %}
