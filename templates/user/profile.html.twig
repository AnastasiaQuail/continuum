{% extends 'base.html.twig' %}

{% block title %}Profile{% endblock %}
{% block body_id %}profile{% endblock %}

{% block main -%}
    <twig:CardForm isPlain id="profile-card">
        <twig:Form:RowField icon="{{ ux_icon('lucide:user') }}" label="Status">
            <twig:Badge color="{{ app.user.status.color.value }}">{{ app.user.status.name }}</twig:Badge>
        </twig:Form:RowField>

        <twig:Form:RowField icon="{{ ux_icon('lucide:mail') }}" label="Email">
            {{- app.user.userIdentifier|email_secure -}}
        </twig:Form:RowField>

        <twig:Form:RowField href="{{ path('app_profile_password') }}"
                            icon="{{ ux_icon('lucide:key-round') }}" label="Password">
            {{- '**********' -}}
        </twig:Form:RowField>
    </twig:CardForm>

    <h2>Geoposition</h2>

    <twig:CardForm isPlain id="profile-location-card">
        <twig:Form:RowField icon="{{ ux_icon('lucide:clock') }}" label="Timezone">
            {{- app.user.timezone.name -}}
        </twig:Form:RowField>

        <twig:Form:RowField href="{{ path('app_profile_location') }}"
                            icon="{{ ux_icon('lucide:map-pin') }}" label="Location">
            {{- app.user.location.latitude ~ ' : ' ~ app.user.location.longitude -}}
        </twig:Form:RowField>
    </twig:CardForm>

    <div>
        <twig:Card:Description>
            <twig:Card:DescriptionLine>
                <span>Profile updated:</span>
                <span>{{ app.user.updatedAt.setTimezone(app.user.timezone).format('j F Y, H:i') }}</span>
            </twig:Card:DescriptionLine>
            <twig:Card:DescriptionLine>
                <span>Last online:</span>
                <span>{{ app.user.lastVisitedAt.setTimezone(app.user.timezone).format('j F Y, H:i') }}</span>
            </twig:Card:DescriptionLine>
        </twig:Card:Description>
    </div>
{%- endblock %}
