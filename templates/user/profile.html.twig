{% extends 'base.html.twig' %}

{% block title %}Profile{% endblock %}
{% block body_id %}profile{% endblock %}

{% block main -%}
    <section id="profile-card" class="card card-form card-form-plain">
        {%- set status = app.user.status -%}
        {{- _self.form_row_plain(
            ux_icon('lucide:user'),
            'Status',
            '<span class="badge" data-general-type="' ~ status.color.value ~ '">' ~ status.name ~ '</span>',
        ) -}}

        {{- _self.form_row_plain(
            ux_icon('lucide:mail'),
            'Email',
            app.user.userIdentifier|email_secure,
        ) -}}

        {{- _self.form_row_plain(
            ux_icon('lucide:key-round'),
            'Password',
            '**********',
            path('app_profile_password'),
        ) -}}
    </section>

    <h2>Geoposition</h2>

    <section id="profile-location-card" class="card card-form card-form-plain">
        {{- _self.form_row_plain(
            ux_icon('lucide:clock'),
            'Timezone',
            app.user.timezone.name,
        ) -}}

        {{- _self.form_row_plain(
            ux_icon('lucide:map-pin'),
            'Location',
            app.user.location.latitude ~ ' : ' ~ app.user.location.longitude,
            path('app_profile_location'),
        ) -}}
    </section>

    <div>
        <div class="card-description">
            <div>Profile updated: {{ app.user.updatedAt.setTimezone(app.user.timezone).format('j F Y, H:i') }}</div>
            <div>Last online: {{ app.user.lastVisitedAt.setTimezone(app.user.timezone).format('j F Y, H:i') }}</div>
        </div>
    </div>
{%- endblock %}

{%- macro form_row_plain(icon, label, value, url = null) -%}
    <{% if url %}a{% else %}div{% endif %}
        {% if url %}href="{{ url }}"{% endif %} class="form-row">
        <label class="form-label">
            <span class="form-icon">{{ icon|raw }}</span>
            <span>{{ label }}</span>
        </label>
        <div class="form-field">
            <span>{{ value|raw }}</span>
            {%- if url -%}
                {{- ux_icon('lucide:chevron-right', {class: 'form-link-chevron'}) -}}
            {%- endif -%}
        </div>
    </{% if url %}a{% else %}div{% endif %}>
{%- endmacro -%}
