{% extends 'base.html.twig' %}

{% block title %}Profile{% endblock %}
{% block body_id %}profile{% endblock %}

{% block main -%}
    <twig:CardForm isPlain id="profile-card">
        {%- import 'user/profile.html.twig' as profile -%}

        {{- profile.form_row_plain(
            ux_icon('lucide:user'),
            'Status',
            profile.status_badge(app.user.status),
        ) -}}

        {{- profile.form_row_plain(
            ux_icon('lucide:mail'),
            'Email',
            app.user.userIdentifier|email_secure,
        ) -}}

        {{- profile.form_row_plain(
            ux_icon('lucide:key-round'),
            'Password',
            '**********',
            path('app_profile_password'),
        ) -}}
    </twig:CardForm>

    <h2>Geoposition</h2>

    <twig:CardForm isPlain id="profile-location-card">
        {%- import 'user/profile.html.twig' as profile -%}

        {{- profile.form_row_plain(
            ux_icon('lucide:clock'),
            'Timezone',
            app.user.timezone.name,
        ) -}}

        {{- profile.form_row_plain(
            ux_icon('lucide:map-pin'),
            'Location',
            app.user.location.latitude ~ ' : ' ~ app.user.location.longitude,
            path('app_profile_location'),
        ) -}}
    </twig:CardForm>

    <div>
        <twig:Card:Description>
            <twig:Card:DescriptionLine>
                <span>Profile updated:</span>
                <span>{{ app.user.updatedAt.setTimezone(app.user.timezone).format('j F Y, H:i') }}</span>
            </twig:Card:DescriptionLine>
            <twig:Card:DescriptionLine>
                <span>Last online:</span>
                <span>{{ app.user.lastVisitedAt.setTimezone(app.user.timezone).format('j F Y, H:i') }}</span>
            </twig:Card:DescriptionLine>
        </twig:Card:Description>
    </div>
{%- endblock %}

{%- macro form_row_plain(icon, label, value, url = null) -%}
    <{% if url %}a{% else %}div{% endif %}
        {% if url %}href="{{ url }}"{% endif %} class="form-row">
        <label class="form-label">
            <span class="form-icon">{{ icon|raw }}</span>
            <span>{{ label }}</span>
        </label>
        <div class="form-field">
            <span>{{ value|raw }}</span>
            {%- if url -%}
                {{- ux_icon('lucide:chevron-right', {class: 'form-link-chevron'}) -}}
            {%- endif -%}
        </div>
    </{% if url %}a{% else %}div{% endif %}>
{%- endmacro -%}

{%- macro status_badge(status) -%}
    <twig:Badge color="{{ status.color.value }}">{{ status.name }}</twig:Badge>
{%- endmacro -%}
