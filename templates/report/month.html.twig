{% extends 'base.html.twig' %}

{% set is_current_year = month.format('Y') === user_date().format('Y') %}

{% block title %}Monthly report{% endblock %}
{% block page_subtitle %}{{ is_current_year ? month.format('F') : month.format('F Y') }}{% endblock %}
{% block body_id %}report-month{% endblock %}

{% block body_actions -%}
    <div class="body-actions actions-pagination">
        {%- set prev_month = month.modify('last day of previous month') -%}
        {%- set next_month = month.modify('last day of next month') -%}

        {{ include('default/_pagination.html.twig', {
            prev: {
                url: path('app_report_month', {month: prev_month.format('Y-m')}),
                label: prev_month.format('F'),
                is_granted: prev_month.format('Y') >= app_year_min and is_granted('REPORT_MONTH_VIEW', prev_month),
            },
            next: {
                url: path('app_report_month', {month: next_month.format('Y-m')}),
                label: next_month.format('F'),
                is_granted: is_granted('REPORT_MONTH_VIEW', next_month),
            },
        }) }}
    </div>
{%- endblock %}

{% block main -%}
    {%- set progress_offset = progress.offset -%}
    {%- set couple_together_info = couple_together ~ '' -%}

    {%- if progress_offset > 0 or couple_together_info !== '' -%}
        <twig:Card class="card-report" id="card-the-wait">
            {%- if progress_offset > 0 -%}
                <twig:Card:Title type="tertiary" id="card-title-the-wait">
                    <twig:block name="header">The Wait</twig:block>

                    <twig:block name="badge">
                        <div class="badge badge-good">
                            <span>+{{ progress_offset }}</span><span>%</span>
                        </div>
                    </twig:block>

                    <twig:block name="info">
                        <div id="progress-the-wait" class="progress-group">
                            <div class="progress progress-offset">
                                <div class="progress-bar"
                                     style="--progress: {{ progress.startProgress.currentProgress }}%;"></div>
                                <div class="progress-bar" style="--progress: {{ progress_offset }}%;"></div>
                            </div>
                            <div class="progress-text">{{ progress.endProgress.currentProgress }}%</div>
                        </div>
                    </twig:block>
                </twig:Card:Title>

                <hr>
            {%- endif -%}

            {%- if couple_together_info !== '' -%}
                <twig:Card:Title type="tertiary" id="card-title-love-story">
                    <twig:block name="header">Love story</twig:block>

                    <twig:block name="badge">
                        <div class="badge badge-good">
                            <span>+{{ couple_progress_days }}</span><span>days</span>
                        </div>
                    </twig:block>

                    <twig:block name="info">{{ couple_together_info }}</twig:block>
                </twig:Card:Title>
            {%- endif -%}
        </twig:Card>
    {%- else -%}
        <twig:CardEmptyCollection message="The love story has not yet begun"/>
    {%- endif -%}

    {%- if (calendar_events is not empty) and is_granted('CALENDAR_REPORT_VIEW') -%}
        <twig:Card class="card-report" id="card-calendar">
            <twig:Card:Title type="tertiary">
                <twig:block name="header">Calendar</twig:block>
                <twig:block name="info">
                    {%- set events_count = 0 -%}
                    {%- for calendar_event in calendar_events -%}
                        {%- set events_count = events_count + calendar_event.count -%}
                    {%- endfor -%}

                    {{- events_count ~ (events_count > 1 ? ' events' : ' event') -}}
                </twig:block>
            </twig:Card:Title>

            <div class="upcoming-events-body report-upcoming-events">
                {%- for calendar_event in calendar_events -%}
                    <div class="badge" data-general-type="{{ calendar_event.type.value }}">
                        <strong>{{ calendar_event.title }}</strong>
                        {%- if calendar_event.count > 1 -%}
                            <span class="badge-count">{{ calendar_event.count }}</span>
                        {%- endif -%}
                    </div>
                {%- endfor -%}
            </div>
        </twig:Card>
    {%- endif -%}

    {%- set is_mood_reflection_granted = (mood_reflections is not empty) and is_granted('MOOD_REFLECTION_REPORT_VIEW') -%}
    {%- set is_weekly_reflection_granted = (weekly_reflections is not empty) and is_granted('WEEKLY_REFLECTION_REPORT_VIEW', month) -%}

    {%- if is_mood_reflection_granted or is_weekly_reflection_granted -%}
        <h2>Reflection</h2>

        <twig:Card class="card-report" id="card-mood-chart">
            {%- if is_mood_reflection_granted -%}
                {%- set total_days = month.format('t') -%}

                <twig:Card:Title type="tertiary" id="card-title-mood-chart">
                    <twig:block name="header">Mood trend</twig:block>
                    <twig:block name="info">
                        <div class="report-mood-reflection-chart">
                            {%- for day_number in 1..total_days -%}
                                {%- set day = month.format('Y-m-') ~ (day_number < 10 ? '0') ~ day_number -%}

                                {%- if mood_reflections[day] is defined -%}
                                    {%- set mood_reflection = mood_reflections[day] -%}

                                    <div class="mood-reflection-dot" data-type="{{ mood_reflection.type.value }}"
                                         data-general-type="{{ mood_reflection.type.color.value }}"></div>
                                {%- else -%}
                                    <div class="mood-reflection-dot empty-dot"></div>
                                {%- endif -%}
                            {%- endfor -%}
                        </div>
                    </twig:block>
                </twig:Card:Title>

                {%- set okay_days = 0 -%}
                {%- set okay_color = '' -%}
                {%- set good_days = 0 -%}
                {%- set good_color = '' -%}
                {%- set great_days = 0 -%}
                {%- set great_color = '' -%}

                {%- for mood_reflection in mood_reflections -%}
                    {%- if mood_reflection.type.value === 'okay' -%}
                        {%- set okay_days = okay_days + 1 -%}
                        {%- set okay_color = mood_reflection.type.color.value -%}
                    {%- elseif mood_reflection.type.value === 'good' -%}
                        {%- set good_days = good_days + 1 -%}
                        {%- set good_color = mood_reflection.type.color.value -%}
                    {%- elseif mood_reflection.type.value === 'great' -%}
                        {%- set great_days = great_days + 1 -%}
                        {%- set great_color = mood_reflection.type.color.value -%}
                    {%- endif -%}
                {%- endfor -%}

                <div class="report-mood-reflection-messages">
                    {%- if great_days > 0 -%}
                        <div class="mood-reflection-message" data-general-type="{{ great_color }}">
                            More than
                            <strong>{{ (great_days / total_days * 100)|round ~ '%' }}</strong>
                            great days!
                        </div>
                    {%- endif -%}
                    {%- if good_days > 0 -%}
                        <div class="mood-reflection-message" data-general-type="{{ good_color }}">
                            More than
                            <strong>{{ (good_days / total_days * 100)|round ~ '%' }}</strong>
                            good days!
                        </div>
                    {%- endif -%}
                    {%- if (great_days === 0 or good_days === 0) and okay_days > 0 -%}
                        <div class="mood-reflection-message" data-general-type="{{ okay_color }}">
                            <strong>{{ (okay_days / total_days * 100)|round ~ '%' }}</strong>
                            normal days
                        </div>
                    {%- endif -%}
                </div>
            {%- endif -%}

            {%- if is_weekly_reflection_granted -%}
                {%- if is_mood_reflection_granted -%}
                    <hr>
                {%- endif -%}

                <twig:Card:Title type="tertiary" id="card-title-weekly-reflection">
                    <twig:block name="header">Joy of weeks</twig:block>
                </twig:Card:Title>

                <div class="report-weekly-reflections">
                    {%- for weekly_reflection in weekly_reflections -%}
                        {%- set is_private = weekly_reflection.joy.isPrivate -%}
                        {%- set is_secure = is_private and not is_granted('WEEKLY_REFLECTION_PRIVATE') -%}

                        <div
                            class="weekly-reflection-joy {{ is_secure ? 'private-secure' : (is_private ? 'private') }}">
                            {{- is_secure ? ux_icon('lucide:lock') : weekly_reflection.joy.text -}}
                        </div>
                    {%- endfor -%}
                </div>
            {%- endif -%}
        </twig:Card>
    {%- endif -%}

    {%- set weight_change = offset_measurement.offset -%}

    {%- set is_weight_change_granted = weight_change !== 0.0 and is_granted('BODY_MEASUREMENT_REPORT_VIEW') -%}
    {%- set is_workout_granted = workout_report.count > 0 and is_granted('WORKOUT_REPORT_VIEW') -%}

    {%- if is_weight_change_granted or is_workout_granted -%}
        <h2>Health</h2>

        <twig:Card class="card-report" id="card-workouts">
            {%- if is_weight_change_granted -%}
                <twig:Card:Title type="tertiary" id="card-title-weight-change">
                    <twig:block name="header">Weight</twig:block>

                    <twig:block name="badge">
                        <div class="badge {{ weight_change > 0 ? 'badge-bad' : 'badge-good' }}">
                            <span>{{ weight_change > 0 ? '+' ~ weight_change : weight_change }}</span>
                            <span>kg</span>
                        </div>
                    </twig:block>

                    <twig:block name="info">
                        {%- if offset_measurement.min !== offset_measurement.max -%}
                            <span>{{ ux_icon('lucide:trending-up-down') }}</span>
                            <span>min {{ offset_measurement.min }}, max {{ offset_measurement.max }} kg</span>
                        {%- endif -%}
                    </twig:block>
                </twig:Card:Title>
            {%- endif -%}

            {%- if is_workout_granted -%}
                {%- if is_weight_change_granted -%}
                    <hr>
                {%- endif -%}

                <twig:Card:Title type="tertiary" id="card-title-workouts">
                    <twig:block name="header">Workouts</twig:block>

                    <twig:block name="badge">
                        <div class="badge badge-good">
                            <span>+{{ workout_report.count }}</span>
                            <span>{{ workout_report.count > 1 ? 'workouts' : 'workout' }}</span>
                        </div>
                    </twig:block>

                    <twig:block name="info">
                        {{- (workout_report.duration / 3600)|round ~ '+ hours' -}}
                    </twig:block>
                </twig:Card:Title>

                <div class="report-workouts">
                    {%- for workout_progress in workout_report.progresses -%}
                        <div class="badge"
                             data-general-type="{{ workout_progress.exercise.group.color.value }}">
                            <span>{{ workout_progress.exercise.name }}</span>
                            {%- if workout_progress.progress is null -%}
                                <span class="badge-progress">NEW</span>
                            {%- else -%}
                                <span class="badge-progress"
                                      data-change="{{ workout_progress.progress.change.value }}">
                                    {{- workout_progress.progress.percent -}}%
                                    {{- ux_icon('lucide:trending-up') -}}
                                </span>
                            {%- endif -%}
                        </div>
                    {%- endfor -%}
                </div>
            {%- endif -%}
        </twig:Card>
    {%- endif -%}
{%- endblock %}
