{%- props idPrefix = '', label = false, href, months, days = 0 -%}

{%- if days > 0 -%}
    {%- set months_count = (days / 30)|round -%}
    {%- set label = months_count ~ (months_count > 1 ? ' months' : ' month') ~ ux_icon('lucide:chevron-down') -%}
{%- else -%}
    {%- set label = ux_icon('lucide:sliders-horizontal') -%}
{%- endif -%}

<twig:Popover id="{{ idPrefix }}-month-filter" label="{{ label }}">
    {%- for month in months|split(',') -%}
        <twig:Popover:Item href="{{ href|replace({('###'|url_encode): month}) }}"
                           name="{{ month }} {{ month > 1 ? 'months' : 'month' }}"/>
    {%- endfor -%}
</twig:Popover>
