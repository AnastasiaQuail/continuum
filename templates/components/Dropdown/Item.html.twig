{%- props href, isGranted = true, icon = false, name -%}

<li class="dropdown-item">
    {%- block content -%}
        <{% if isGranted %}a{% else %}button{% endif %}
            {% if isGranted %}href="{{ href }}"{% endif %}
            {{ attributes.defaults({class: 'dropdown-link', disabled: not isGranted}) }}>
            {%- if icon %}{{ icon|raw }}{% endif -%}
            <span>{{ name }}</span>
        </{% if isGranted %}a{% else %}button{% endif %}>
    {%- endblock -%}
</li>
