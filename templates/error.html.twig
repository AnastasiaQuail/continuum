{% extends 'base.html.twig' %}

{% block importmap %}{{ importmap('error') }}{% endblock %}

{% block body_id 'error' %}

{% block header %}{% endblock %}
{% block sidebar %}{% endblock %}

{% block body -%}
    <div class="body-error-code" data-code="{{ status_code }}">
        {%- for digit in status_code|split('') -%}
            <span>{{ digit }}</span>
        {%- endfor -%}
    </div>
    <div class="body-error-container">
        <h1 class="error-title">{{ error_title }}</h1>
        <p class="error-description">{{ error_description }}</p>
        <nav>
            {%- block errorButtons -%}
                <a class="btn btn-primary btn-transparent" href="{{ path('app_homepage') }}">
                    {{ ux_icon('lucide:house') }}
                    <span>Go Home</span>
                </a>
            {%- endblock -%}
        </nav>
    </div>
{%- endblock %}

{% block footer %}{% endblock %}
