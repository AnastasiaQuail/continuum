{% extends 'base.html.twig' %}

{% set date = measurement ? measurement.datetime.setTimezone(app.user.timezone) : user_date() %}

{% block title %}Measurement on {{ date.format('j F Y') }}{% endblock %}
{% block page_title %}{{ date.format('j F Y, H:i') }}{% endblock %}
{% block body_id %}body-measurement-edit{% endblock %}

{% set breadcrumbs = [
    { label: 'Body measurements', url: path('app_measurements', {'month': date.format('Y-m')}) },
    { label: measurement ? 'Edit' : 'Add' },
] %}

{% block main -%}
    <section class="card">
        <h2 class="card-title">{{ measurement ? 'Edit measurement' : 'Add measurement' }}</h2>

        {{- form_start(form) -}}

        {{ form_row(form.datetime) }}

        <div class="row row-2 row-sm-3">
            {{- form_row(form.weight) -}}
            {{- form_row(form.neck) -}}
            {{- form_row(form.waist) -}}
            {{- form_row(form.chest) -}}
            {{- form_row(form.shoulders) -}}
            {{- form_row(form.flexedBiceps) -}}
            {{- form_row(form.hips) -}}
            {{- form_row(form.thigh) -}}
            {{- form_row(form.calf) -}}
        </div>

        <div class="card-submit">
            <button type="submit" class="btn btn-primary btn-outline">Save</button>
        </div>

        {{- form_end(form) -}}
    </section>
{%- endblock %}
