{% extends 'base.html.twig' %}

{% set date = measurement ? measurement.datetime.setTimezone(app.user.timezone) : user_date() %}
{% set is_current_year = date.format('Y') === user_date().format('Y') %}

{% block title %}Measurement on {{ date.format('j F Y') }}{% endblock %}
{% block page_title %}Measurement{% endblock %}
{% block page_subtitle %}{{ is_current_year ? date.format('j F, H:i') : date.format('j F Y, H:i') }}{% endblock %}
{% block body_id %}body-measurement-edit{% endblock %}

{% set back_path = path('app_measurements', {month: date.format('Y-m')}) %}

{% block main -%}
    <section class="card card-form">
        {{- form_start(form) -}}

        {{- form_row(form.datetime) -}}

        <div class="row row-md-3">
            {{- form_row(form.weight, {attr: {placeholder: '0 kg'}}) -}}
            {{- form_row(form.neck, {attr: {placeholder: '0 cm'}}) -}}
            {{- form_row(form.waist, {attr: {placeholder: '0 cm'}}) -}}
        </div>

        <div class="row row-md-3 form-row-collapsible">
            <div class="form-row form-row-collapse-toggle"
                 onclick="this.parentNode.classList.add('show'); return false;">
                <span>Show all</span>
                {{- ux_icon('lucide:chevron-down') -}}
            </div>

            {{- form_row(form.chest, {attr: {placeholder: '0 cm'}}) -}}
            {{- form_row(form.shoulders, {attr: {placeholder: '0 cm'}}) -}}
            {{- form_row(form.flexedBiceps, {attr: {placeholder: '0 cm'}}) -}}
            {{- form_row(form.hips, {attr: {placeholder: '0 cm'}}) -}}
            {{- form_row(form.thigh, {attr: {placeholder: '0 cm'}}) -}}
            {{- form_row(form.calf, {attr: {placeholder: '0 cm'}}) -}}
        </div>

        {{- form_row_submit() -}}

        {{- form_end(form) -}}
    </section>
{%- endblock %}
