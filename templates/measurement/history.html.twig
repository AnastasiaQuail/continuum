{% extends 'base.html.twig' %}

{% import 'default/_filters.html.twig' as filters %}

{%- block javascripts -%}
    {{ parent() }}
    <script src="{{ asset('js/echarts.min.js') }}"></script>
    <script src="{{ asset('js/chart.js') }}"></script>
{%- endblock -%}

{% block title %}Measurement history{% endblock %}
{% block page_title %}History{% endblock %}
{% block body_id %}body-measurement-history{% endblock %}

{% set back_path = path('app_measurements') %}

{% block header_actions -%}
    {{- filters.months(
        ux_icon('lucide:sliders-horizontal'),
        measurement_days,
        path('app_measurements_history', {months: '###'}),
        [4, 6, 8, 10],
    ) -}}
{%- endblock %}

{% block main -%}
    {%- if measurements is empty -%}
        <twig:CardEmptyCollection message="No measurements"/>
    {%- else -%}
        <div class="row row-sm-2">
            {{- _self.measurent_chart(_context, 'fatDeurenberg', 'Body fat (Deurenberg)', '%') -}}
            {{- _self.measurent_chart(_context, 'fatUsNavy', 'Body fat (US Navy)', '%') -}}
        </div>

        <div class="row row-sm-2 row-xl-3">
            {{- _self.measurent_chart(_context, 'weight', 'Weight', 'kg') -}}
            {{- _self.measurent_chart(_context, 'neck', 'Neck') -}}
            {{- _self.measurent_chart(_context, 'waist', 'Waist') -}}
            {{- _self.measurent_chart(_context, 'chest', 'Chest') -}}
            {{- _self.measurent_chart(_context, 'shoulders', 'Shoulders') -}}
            {{- _self.measurent_chart(_context, 'flexedBiceps', 'Biceps') -}}
            {{- _self.measurent_chart(_context, 'hips', 'Hips') -}}
            {{- _self.measurent_chart(_context, 'thigh', 'Thigh') -}}
            {{- _self.measurent_chart(_context, 'calf', 'Calf') -}}
        </div>
    {%- endif -%}
{%- endblock %}

{% macro measurent_chart(context, field, name, type = 'cm') -%}
    {%- set values = [] -%}
    {%- set min = 999999 -%}
    {%- set max = 0 -%}

    {%- for measurement in context.measurements -%}
        {%- set value = attribute(measurement, field) -%}

        {%- if value is not null -%}
            {%- set values = values|merge([{
                time: measurement.datetime.setTimezone(app.user.timezone).timestamp,
                value: value,
            }]) -%}
        {%- endif -%}
    {%- endfor -%}

    <twig:Card class="card-measurement-history">
        <twig:Card:Title isCompact>
            <twig:block name="header">{{ outerScope.name }}</twig:block>

            <twig:block name="badge">
                {%- if outerScope.values -%}
                    {%- set result = ((outerScope.values|last).value - (outerScope.values|first).value)|round(1) -%}

                    {%- if result !== 0.0 -%}
                        {%- if field in context.reversed_measurement_names -%}
                            {%- set color = result > 0 ? 'green' : 'red' -%}
                        {%- else -%}
                            {%- set color = result > 0 ? 'red' : 'green' -%}
                        {%- endif -%}

                        <twig:BadgeNumber color="{{ color }}" number="{{ result }}" postfix="{{ outerScope.type }}"/>
                    {%- endif -%}
                {%- endif -%}
            </twig:block>

            <twig:block name="info">
                {%- if outerScope.values -%}{{ (outerScope.values|last).value }} {{ outerScope.type }}{%- endif -%}
            </twig:block>
        </twig:Card:Title>

        {%- if values is empty -%}
            <div class="collection-empty">No values</div>
        {%- else -%}
            <twig:Chart name="measurement-change" values="{{ values }}"
                        data-type="{{ type }}" data-days="{{ context.measurement_days }}"/>
        {%- endif -%}
    </twig:Card>
{%- endmacro %}
