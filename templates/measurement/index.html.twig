{% extends 'base.html.twig' %}

{%- block javascripts -%}
    {{ parent() }}
    {% if chart_measurements %}
        <script src="{{ asset('js/echarts.min.js') }}"></script>
        <script src="{{ asset('js/chart.js') }}"></script>
    {%- endif -%}
{%- endblock -%}

{% set is_current_year = month.format('Y') === user_date().format('Y') %}

{% block title %}Measurements{% endblock %}
{% block page_subtitle %}{{ is_current_year ? month.format('F') : month.format('F Y') }}{% endblock %}
{% block body_id %}body-measurements{% endblock %}

{% block header_actions -%}
    {%- set is_granted = is_granted('BODY_MEASUREMENT_CREATE') -%}

    <{% if is_granted %}a{% else %}button{% endif %}
        {% if is_granted %} href="{{ path('app_measurement_create') }}"{% else %} disabled{% endif %}
        class="btn btn-glass">
        {{- ux_icon('lucide:plus') -}}
    </{% if is_granted %}a{% else %}button{% endif %}>

    {%- set is_granted = is_granted('BODY_MEASUREMENT_HISTORY') -%}

    <{% if is_granted %}a{% else %}button{% endif %}
        {% if is_granted %} href="{{ path('app_measurements_history') }}"{% else %} disabled{% endif %}
        class="btn btn-glass">
        {{- ux_icon('lucide:chart-no-axes-combined') -}}
    </{% if is_granted %}a{% else %}button{% endif %}>
{%- endblock %}

{% block body_actions -%}
    <div class="body-actions actions-pagination">
        {% set prev_month = month.modify('-1 month') %}
        {% set next_month = month.modify('+1 month') %}

        {{ include('default/_pagination.html.twig', {
            prev: {
                url: path('app_measurements', {month: prev_month.format('Y-m')}),
                label: prev_month.format('F'),
                is_granted: prev_month.format('Y') >= app_year_min and is_granted('BODY_MEASUREMENT_VIEW', prev_month),
            },
            next: {
                url: path('app_measurements', {month: next_month.format('Y-m')}),
                label: next_month.format('F'),
                is_granted: user_date().format('Y-m') >= next_month.format('Y-m'),
            },
        }) }}
    </div>
{%- endblock %}

{% block main -%}
    <twig:Card isTransparent class="card-weight-change" id="card-weight-change">
        <twig:Card:Title id="card-title-weight-change">
            <twig:block name="header">Weight</twig:block>

            <twig:block name="badge">
                <twig:BadgeNumber number="{{ offset_measurement.offset }}" postfix="kg" reversable/>
            </twig:block>

            <twig:block name="info">
                <span>{{ ux_icon('lucide:trending-up-down') }}</span>
                <span>
                    {%- if offset_measurement.min !== offset_measurement.max -%}
                        {{- offset_measurement.min ~ ' - ' -}}
                    {%- endif -%}
                    {{- offset_measurement.max ~ ' kg' -}}
                </span>
            </twig:block>
        </twig:Card:Title>

        <twig:Chart name="weight-change" values="{{ chart_measurements }}" showEmpty
                    data-date="{{ month.format('Y-m-d') }}"/>
    </twig:Card>

    {%- if measurements is empty -%}
        <twig:CardEmptyCollection message="No measurements for this month yet"/>
    {%- endif -%}

    {%- for measurement in measurements|reverse -%}
        {%- set progress = progresses[measurement.id] -%}

        <twig:CardForm class="card-measurements">
            {%- set time = measurement.datetime.setTimezone(app.user.timezone).format('j F, H:i') -%}
            {%- set is_granted = is_granted('BODY_MEASUREMENT_EDIT', measurement) -%}

            <{% if is_granted %}a{% else %}div{% endif %}
                {% if is_granted %}href="{{ path('app_measurement_edit', {id: measurement.id}) }}"{% endif %}
                class="form-row form-row-header-edit">
                <div class="form-label">{{ time }}</div>
                <div class="form-field">{{ ux_icon('lucide:square-pen') }}</div>
            </{% if is_granted %}a{% else %}div{% endif %}>

            {%- import 'measurement/index.html.twig' as macro -%}

            {{- macro.measurent_row(
                'Body fat',
                [
                    {
                        value: measurement.fatDeurenberg,
                        legend: 'by Deurenberg',
                        description: '%',
                        progress: progress.fatDeurenberg,
                    },
                    {
                        value: measurement.fatUsNavy,
                        legend: 'by US Navy',
                        description: '%',
                        progress: progress.fatUsNavy,
                    },
                ],
                'orange',
            ) -}}
            {{- macro.measurent_row(
                'Weight',
                {
                    value: measurement.weight,
                    description: 'kg',
                    progress: progress.weight,
                },
            ) -}}
            {{- macro.measurent_row(
                'Neck',
                {
                    value: measurement.neck,
                    progress: progress.neck,
                },
            ) -}}
            {{- macro.measurent_row(
                'Waist',
                {
                    value: measurement.waist,
                    progress: progress.waist,
                },
            ) -}}
            {{- macro.measurent_row(
                'Chest',
                {
                    value: measurement.chest,
                    progress: progress.chest,
                },
            ) -}}
            {{- macro.measurent_row(
                'Shoulders',
                {
                    value: measurement.shoulders,
                    progress: progress.shoulders,
                },
            ) -}}
            {{- macro.measurent_row(
                'Biceps',
                {
                    value: measurement.flexedBiceps,
                    progress: progress.flexedBiceps,
                },
            ) -}}
            {{- macro.measurent_row(
                'Hips',
                {
                    value: measurement.hips,
                    progress: progress.hips,
                },
            ) -}}
            {{- macro.measurent_row(
                'Thigh',
                {
                    value: measurement.thigh,
                    progress: progress.thigh,
                },
            ) -}}
            {{- macro.measurent_row(
                'Calf',
                {
                    value: measurement.calf,
                    progress: progress.calf,
                },
            ) -}}
        </twig:CardForm>
    {%- endfor -%}
{%- endblock %}

{%- macro measurent_row(label, values, color = null) -%}
    {%- set is_available = false -%}
    {%- set values = values['value'] is defined ? [values] : values -%}

    {%- for subvalue in values -%}
        {%- if subvalue.value -%}
            {%- set is_available = true -%}
        {%- endif -%}
    {%- endfor -%}

    {%- if is_available -%}
        <div class="form-row form-row-compact" {% if color %}data-general-type="{{ color }}"{% endif %}>
            <div class="form-label">{{ label }}</div>
            <div class="form-field {% if values|length > 1 %}form-field-multiple{% endif %}">
                {%- for subvalue in values -%}
                    {%- if subvalue.value -%}
                        <div class="form-field-line">
                            {%- if subvalue['legend'] is defined -%}
                                <span class="form-field-legend">{{ subvalue.legend }}</span>
                            {%- endif -%}

                            <span>{{ subvalue.value }}</span>
                            <small>{{ subvalue['description'] is defined ? subvalue.description : 'cm' }}</small>

                            {%- if subvalue.progress and subvalue.progress.progress.value !== 'unchanged' -%}
                                {%- set change = subvalue.progress.progress.value -%}
                                {%- if subvalue.progress.isProgressReversed -%}
                                    {%- set change = change === 'increased' ? 'decreased' : 'increased' -%}
                                {%- endif -%}

                                <span class="form-field-progress" data-change="{{ change }}">
                                    {%- if subvalue.progress.progress.value === 'increased' -%}
                                        {{- ux_icon('lucide:move-up') -}}
                                    {%- else -%}
                                        {{- ux_icon('lucide:move-down') -}}
                                    {%- endif -%}
                                </span>
                            {%- endif -%}

                        </div>
                    {%- endif -%}
                {%- endfor -%}
            </div>
        </div>
    {%- endif -%}
{%- endmacro -%}
