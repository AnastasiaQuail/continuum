{% extends 'base.html.twig' %}

{%- block javascripts -%}
    {{ parent() }}
    {% if chart_measurements %}
        <script src="{{ asset('js/echarts.min.js') }}"></script>
        <script src="{{ asset('js/chart.js') }}"></script>
    {%- endif -%}
{%- endblock -%}

{% set is_current_year = month.format('Y') === user_date().format('Y') %}

{% block title %}Measurements{% endblock %}
{% block page_subtitle %}{{ is_current_year ? month.format('F') : month.format('F Y') }}{% endblock %}
{% block body_id %}body-measurements{% endblock %}

{% block header_actions -%}
    {%- set is_granted = is_granted('BODY_MEASUREMENT_CREATE') -%}

    <{% if is_granted %}a{% else %}button{% endif %}
        {% if is_granted %} href="{{ path('app_measurement_create') }}"{% else %} disabled{% endif %}
        class="btn btn-glass btn-header">
        {{- ux_icon('lucide:plus') -}}
    </{% if is_granted %}a{% else %}button{% endif %}>

    {{ parent() }}
{%- endblock %}

{% block header_actions_shortcut -%}
    <li class="dropdown-item">
        {%- set is_granted = is_granted('BODY_MEASUREMENT_HISTORY') -%}

        <{% if is_granted %}a{% else %}button{% endif %}
            {% if is_granted %} href="{{ path('app_measurements_history') }}"{% else %} disabled{% endif %}
            class="dropdown-link">
            {{- ux_icon('lucide:history') -}}
            <span>History</span>
        </{% if is_granted %}a{% else %}button{% endif %}>
    </li>
    <li class="dropdown-item">
        <hr class="dropdown-divider">
    </li>

    {{ parent() }}
{%- endblock %}

{% block body_actions -%}
    <div class="body-actions actions-pagination">
        {% set prev_month = month.modify('-1 month') %}
        {% set next_month = month.modify('+1 month') %}

        {{ include('default/_pagination.html.twig', {
            prev: {
                url: path('app_measurements', {month: prev_month.format('Y-m')}),
                label: prev_month.format('F'),
                is_granted: prev_month.format('Y') >= app_year_min and is_granted('BODY_MEASUREMENT_VIEW', prev_month),
            },
            next: {
                url: path('app_measurements', {month: next_month.format('Y-m')}),
                label: next_month.format('F'),
                is_granted: user_date().format('Y-m') >= next_month.format('Y-m'),
            },
        }) }}
    </div>
{%- endblock %}

{% block main -%}
    <section id="weight-change-chart" class="card card-transparent card-panel card-weight-change">
        <div class="card-title card-title-controls">
            <h2 id="weight-change-title">Weight</h2>

            {%- set change = offset_measurement.offset -%}
            <div id="weight-change-label"
                 class="badge {{ change > 0 ? 'badge-bad' }}{{ change < 0 ? 'badge-good' }}">
                <span>{{ change > 0 ? '+' ~ change : change }}</span>
                <span>kg</span>
            </div>

            <div id="weight-change-difference" class="card-title-info">
                <span>{{ ux_icon('lucide:trending-up-down') }}</span>
                <span>
                        {%- if offset_measurement.min !== offset_measurement.max -%}
                            {{- offset_measurement.min ~ ' - ' -}}
                        {%- endif -%}
                    {{- offset_measurement.max ~ ' kg' -}}
                    </span>
            </div>
        </div>

        <div class="card-panel-body chart-panel" {% if chart_measurements %}data-chart="weight-change"
             data-date="{{ month.format('Y-m-d') }}"
             data-values="{{ chart_measurements|json_encode }}"{% endif %}></div>
    </section>

    {%- if measurements is empty -%}
        <section class="card collection-empty">
            {{- ux_icon('lucide:frown') -}}
            <span>No measurements</span>
        </section>
    {%- else -%}
        {%- for measurement in measurements|reverse -%}
            <section class="card card-form card-measurements">
                {%- set time = measurement.datetime.setTimezone(app.user.timezone).format('j F H:i') -%}
                {%- set is_granted = is_granted('BODY_MEASUREMENT_EDIT', measurement) -%}

                <{% if is_granted %}a{% else %}div{% endif %}
                    {% if is_granted %}href="{{ path('app_measurement_edit', {id: measurement.id}) }}"{% endif %}
                    class="form-row form-row-header-edit">
                    <div class="form-label">{{ time }}</div>
                    {% if is_granted %}
                        <div class="form-field">{{ ux_icon('lucide:square-pen') }}</div>
                    {% endif %}
                </{% if is_granted %}a{% else %}div{% endif %}>

                {{- _self.measurent_row(
                    'Body fat',
                    {'by Deurenberg': measurement.fatDeurenberg, 'by US Navy': measurement.fatUsNavy},
                    '%',
                    'orange',
                ) -}}
                {{- _self.measurent_row('Weight', measurement.weight, 'kg') -}}
                {{- _self.measurent_row('Neck', measurement.neck) -}}
                {{- _self.measurent_row('Waist', measurement.waist) -}}
                {{- _self.measurent_row('Chest', measurement.chest) -}}
                {{- _self.measurent_row('Shoulders', measurement.shoulders) -}}
                {{- _self.measurent_row('Biceps', measurement.flexedBiceps) -}}
                {{- _self.measurent_row('Hips', measurement.hips) -}}
                {{- _self.measurent_row('Thigh', measurement.thigh) -}}
                {{- _self.measurent_row('Calf', measurement.calf) -}}
            </section>
        {%- endfor -%}
    {%- endif -%}
{%- endblock %}

{%- macro measurent_row(label, values, description = 'cm', color = null) -%}
    {%- set is_available = false -%}
    {%- set length = 0 -%}
    {%- set values = values is not iterable ? [values] : values -%}

    {%- for value in values -%}
        {%- if value -%}
            {%- set is_available = true -%}
            {%- set length = length + 1 -%}
        {%- endif -%}
    {%- endfor -%}

    {%- if is_available -%}
        <div class="form-row" {% if color %}data-general-type="{{ color }}"{% endif %}>
            <div class="form-label">{{ label }}</div>
            <div class="form-field {% if length > 1 %}form-field-multiple{% endif %}">
                {%- for sublabel, value in values -%}
                    {%- if value -%}
                        <div class="form-field-line">
                            {%- if sublabel %}<span class="form-field-legend">{{ sublabel }}</span>{% endif -%}
                            <span>{{ value }}</span><small>{{ description }}</small>
                        </div>
                    {%- endif -%}
                {%- endfor -%}
            </div>
        </div>
    {%- endif -%}
{%- endmacro -%}
