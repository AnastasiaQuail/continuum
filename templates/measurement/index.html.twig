{% extends 'base.html.twig' %}

{%- block javascripts -%}
    {{ parent() }}
    {% if chart_measurements %}
        <script src="{{ asset('js/echarts.min.js') }}"></script>
        <script src="{{ asset('js/chart.js') }}"></script>
    {%- endif -%}
{%- endblock -%}

{% block title %}Measurements{% endblock %}
{% block body_id %}body-measurements{% endblock %}

{% block header_actions -%}
    {%- set is_granted = is_granted('BODY_MEASUREMENT_CREATE') -%}

    <{% if is_granted %}a{% else %}button{% endif %}
        {% if is_granted %} href="{{ path('app_measurement_create') }}"{% else %} disabled{% endif %}
        class="btn btn-glass btn-header">
        {{- ux_icon('lucide:plus') -}}
    </{% if is_granted %}a{% else %}button{% endif %}>

    {{ parent() }}
{%- endblock %}

{% block header_actions_shortcut -%}
    <li class="dropdown-item">
        {%- set is_granted = is_granted('BODY_MEASUREMENT_HISTORY') -%}

        <{% if is_granted %}a{% else %}button{% endif %}
            {% if is_granted %} href="{{ path('app_measurements_history') }}"{% else %} disabled{% endif %}
            class="dropdown-link">
            {{- ux_icon('lucide:history') -}}
            <span>History</span>
        </{% if is_granted %}a{% else %}button{% endif %}>
    </li>
    <li class="dropdown-item">
        <hr class="dropdown-divider">
    </li>

    {{ parent() }}
{%- endblock %}

{% block body_actions -%}
    <div class="body-actions actions-pagination">
        {% set prev_month = month.modify('-1 month') %}
        {% set next_month = month.modify('+1 month') %}

        {{ include('default/_pagination.html.twig', {
            prev: {
                url: path('app_measurements', {month: prev_month.format('Y-m')}),
                label: prev_month.format('F'),
                is_granted: prev_month.format('Y') >= app_year_min and is_granted('BODY_MEASUREMENT_VIEW', prev_month),
            },
            next: {
                url: path('app_measurements', {month: next_month.format('Y-m')}),
                label: next_month.format('F'),
                is_granted: user_date().format('Y-m') >= next_month.format('Y-m'),
            },
        }) }}
    </div>
{%- endblock %}

{% block main -%}
    <h2>{{ month.format('F Y') }}</h2>

    <section id="weight-change-chart" class="card card-weight-result">
        <div class="weight-change">
            <h2 id="weight-change-title" class="weight-change-title">Weight Change</h2>
            {%- set change = offset_measurement.offset -%}
            <div id="weight-change-label"
                 class="badge {{ change > 0 ? 'badge-bad' }}{{ change < 0 ? 'badge-good' }}">
                <span>{{ change > 0 ? '+' ~ change : change }}</span>
                <span>kg</span>
            </div>
            {%- if offset_measurement.max > 0 -%}
                <div id="weight-change-difference" class="weight-change-difference">
                    <span>{{ ux_icon('lucide:trending-up-down') }}</span>
                    <span>
                        {%- if offset_measurement.min !== offset_measurement.max -%}
                            {{- offset_measurement.min ~ ' - ' -}}
                        {%- endif -%}
                        {{- offset_measurement.max ~ ' kg' -}}
                    </span>
                </div>
            {%- endif -%}
        </div>

        <div class="chart-panel" {% if chart_measurements %}data-chart="weight-change"
             data-date="{{ month.format('Y-m-d') }}"
             data-values="{{ chart_measurements|json_encode }}"{% endif %}></div>
    </section>

    <section class="card">
        {%- if measurements is empty -%}
            <div class="collection-empty">
                {{- ux_icon('lucide:frown') -}}
                <span>No measurements</span>
            </div>
        {%- else -%}
            <div class="card-body-measurements">
                {%- for measurement in measurements|reverse -%}
                    <div class="body-measurement">
                        <div class="measurement-date">
                            {%- set time = measurement.datetime.setTimezone(app.user.timezone).format('j F H:i') -%}
                            {%- if is_granted('BODY_MEASUREMENT_EDIT', measurement) -%}
                                <a href="{{ path('app_measurement_edit', {id: measurement.id}) }}">{{ time }}</a>
                            {%- else -%}
                                <span>{{ time }}</span>
                            {%- endif -%}
                        </div>
                        <div class="measurement-values">
                            <div class="measurement-values-fat">
                                {{ _self.measurent_value(measurement.fatDeurenberg, 'Deurenberg', '%') -}}
                                {{ _self.measurent_value(measurement.fatUsNavy, 'US Navy', '%') -}}
                            </div>
                            {{- _self.measurent_value(measurement.weight, 'Weight', 'kg') -}}
                            {{- _self.measurent_value(measurement.neck, 'Neck') -}}
                            {{- _self.measurent_value(measurement.waist, 'Waist') -}}
                            {{- _self.measurent_value(measurement.chest, 'Chest') -}}
                            {{- _self.measurent_value(measurement.shoulders, 'Shoulders') -}}
                            {{- _self.measurent_value(measurement.flexedBiceps, 'Biceps') -}}
                            {{- _self.measurent_value(measurement.hips, 'Hips') -}}
                            {{- _self.measurent_value(measurement.thigh, 'Thigh') -}}
                            {{- _self.measurent_value(measurement.calf, 'Calf') -}}
                        </div>
                    </div>
                {%- endfor -%}
            </div>
        {%- endif -%}
    </section>
{%- endblock %}

{% macro measurent_value(value, name, description = 'cm') -%}
    {%- if value -%}
        <div class="measurement-value">
            <div class="badge">{{ name }}</div>
            <div class="measurement-body">
                <span>{{ value }}</span><span>{{ description }}</span>
            </div>
        </div>
    {%- endif -%}
{%- endmacro %}
