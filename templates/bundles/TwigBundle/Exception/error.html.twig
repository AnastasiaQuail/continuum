{% extends 'error.html.twig' %}

{% set error_title = 'Oops… something happened.' %}
{% set error_description = 'This wasn’t supposed to happen, but we’re on it.' %}

{% block errorButtons -%}
    {{ parent() }}
    <button class="btn btn-secondary btn-transparent" data-button-action="retry">
        {{ ux_icon('lucide:refresh-cw') }}
        <span>Retry</span>
    </button>
{%- endblock %}
