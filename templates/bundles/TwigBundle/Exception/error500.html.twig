{% extends 'error.html.twig' %}

{% set errorTitle = 'Well… this is awkward.' %}
{% set errorDescription = 'Something broke on our side. We’re already looking into it.' %}

{% block errorButtons -%}
    {{ parent() }}
    <button class="btn btn-secondary btn-transparent" data-button-action="retry">
        {{ ux_icon('lucide:refresh-cw') }}
        <span>Retry</span>
    </button>
{%- endblock %}
