{# @var type string #}
{# @var isEmpty bool #}
{# @var text string|null #}
{# @var isPrivate = bool|null #}

{%- set isPrivate = isPrivate|default(false) -%}
{%- set isSecure = isPrivate and not is_granted('ROLE_ADMIN') -%}
{%- set types = {
    'joy': {
        'class': 'alert-success',
        'icon': 'lucide:heart',
        'title': 'Joy',
    },
    'difficulty': {
        'class': 'alert-warning',
        'icon': 'lucide:triangle-alert',
        'title': 'Difficulty',
    },
    'achievement': {
        'class': 'alert-primary',
        'icon': 'lucide:trophy',
        'title': 'Achievement',
    }
} -%}

<article class="alert {{ isEmpty|default(false) ? 'alert-empty' : types[type].class }}">
    <div class="alert-title">
        {{- ux_icon(types[type].icon) -}}
        <span>{{ types[type].title }}</span>
    </div>
    <div class="alert-body {{ isSecure ? 'private-secure' : (isPrivate ? 'private') }}">
        {%- block alert_body -%}
            {{- isSecure ? ux_icon('lucide:lock') : text|default('') -}}
        {%- endblock -%}
    </div>
</article>
