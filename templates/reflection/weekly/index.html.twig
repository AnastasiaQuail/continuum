{% extends 'base.html.twig' %}

{% set monthName = month.format('F Y') %}
{% set isCurrentWeek = monthName == user_date('now').format('F Y') %}

{% block title %}Weekly reflection{{ not isCurrentWeek ? ' | ' ~ monthName }}{% endblock %}
{% block body_id %}weekly-reflection{% endblock %}

{% set breadcrumbs = [
    { label: 'Weekly reflection', url: path('app_weekly_reflection') },
    { label: month.format('F Y') },
] %}

{% block main -%}
    <nav class="calendar-pagination">
        {%- set prevDate = month.modify('-1 month') -%}
        {%- set nextDate = month.modify('+1 month') -%}

        {%- if prevDate.format('Y') >= app_year_min -%}
            <a class="page-link page-link-prev"
               href="{{ path('app_weekly_reflection', {'month': prevDate.format('Y-m')}) }}">
                {{ ux_icon('lucide:chevron-right') }}
                <span>{{ prevDate.format('F') }}</span>
            </a>
        {%- endif -%}

        <h2>{{ month.format('F') }}</h2>

        {%- if nextDate.format('Y') <= app_year_max -%}
            <a class="page-link page-link-next"
               href="{{ path('app_weekly_reflection', {'month': nextDate.format('Y-m')}) }}">
                <span>{{ nextDate.format('F') }}</span>
                {{- ux_icon('lucide:chevron-right') -}}
            </a>
        {%- endif -%}
    </nav>

    <section class="card">
        <div class="weekly-reflection">
            {%- for date, reflection in weeklyReflections -%}
                <div class="week">
                    <div class="week-title">
                        {%- set monday = date(date).modify('-6 days') -%}
                        {%- set sunday = date(date) -%}

                        <a href="{{ path('app_weekly_reflection_edit', {'week': date}) }}">
                            {%- if monday.format('n') != sunday.format('n') -%}
                                {{- monday.format('j F') }} - {{ sunday.format('j F') -}}
                            {%- else -%}
                                {{- monday.format('j') }} - {{ sunday.format('j F') -}}
                            {%- endif -%}
                        </a>
                    </div>
                    <div class="week-body">
                        {% include 'reflection/weekly/_alert.html.twig' with {
                            type: 'joy',
                            isEmpty: reflection is null,
                            text: reflection ? reflection.joy,
                            isPrivate: reflection ? reflection.joyPrivate,
                        } %}
                        {% include 'reflection/weekly/_alert.html.twig' with {
                            type: 'difficulty',
                            isEmpty: reflection is null,
                            text: reflection ? reflection.difficulty,
                            isPrivate: reflection ? reflection.difficultyPrivate,
                        } %}
                        {% include 'reflection/weekly/_alert.html.twig' with {
                            type: 'achievement',
                            isEmpty: reflection is null,
                            text: reflection ? reflection.achievement,
                            isPrivate: reflection ? reflection.achievementPrivate,
                        } %}
                    </div>
                </div>
            {%- endfor -%}
        </div>
    </section>
{%- endblock %}
