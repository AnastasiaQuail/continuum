{% extends 'base.html.twig' %}

{% set weekName = week.format('F Y') %}
{% set isCurrentWeek = weekName == user_date('now').format('F Y') %}

{% block title %}Week in review{{ not isCurrentWeek ? ' | ' ~ weekName }}{% endblock %}
{% block body_id %}week-in-review{% endblock %}

{% set breadcrumbs = [
    { label: 'Week in review', url: path('app_reflection_weekly') },
    { label: week.format('F Y') },
] %}

{% block main -%}
    <section class="card">
    </section>
{%- endblock %}
