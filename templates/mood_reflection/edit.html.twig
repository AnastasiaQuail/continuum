{% extends 'base.html.twig' %}

{% set is_current_year = day.format('Y') === user_date().format('Y') %}

{% block title %}Mood on {{ day.format('j F Y') }}{% endblock %}
{% block page_title %}Mood of the day{% endblock %}
{% block page_subtitle %}{{ is_current_year ? day.format('j F') : day.format('j F Y') }}{% endblock %}
{% block body_id %}mood-reflection-day{% endblock %}

{% set back_path = path('app_mood_reflections', {month: day.format('Y-m')}) %}

{% block header_actions -%}
    <twig:Form:ExternalSubmit target="#form-mood-reflection"/>
{%- endblock %}

{% block showcase -%}
    {%- set mood_day = day.format('Y-m-d') -%}
    {%- set current_date = user_date() -%}

    {%- if mood_day === current_date.format('Y-m-d') -%}
        <div class="alert alert-success">You are rating your mood for today</div>
    {%- elseif mood_day === current_date.modify('-1 day').format('Y-m-d') -%}
        <div class="alert alert-warning">You are rating your mood for yesterday</div>
    {%- else -%}
        <div class="alert alert-danger alert-inline">
            {{- ux_icon('lucide:triangle-alert') -}}
            <span>You are rating a past day</span>
        </div>
    {%- endif -%}
{%- endblock %}

{% block main -%}
    <twig:CardForm>
        {{- form_start(form, {attr: {id: 'form-mood-reflection', class: 'form-submit-external'}}) -}}

        {{- form_row(form.type, {
            icons: {
                terrible: ux_icon('lucide:angry'),
                bad: ux_icon('lucide:frown'),
                okay: ux_icon('lucide:meh'),
                good: ux_icon('lucide:smile'),
                great: ux_icon('lucide:laugh'),
            },
        }) -}}
        {{- form_row(form.text, {attr: {placeholder: 'Optional'}}) -}}

        <twig:Form:Submit/>

        {{- form_end(form) -}}
    </twig:CardForm>
{%- endblock %}
