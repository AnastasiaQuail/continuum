{% extends 'base.html.twig' %}

{% set current_date = user_date() %}
{% set is_current_year = month.format('Y') === current_date.format('Y') %}

{% block title %}Mood reflection{% endblock %}
{% block page_subtitle %}{{ is_current_year ? month.format('F') : month.format('F Y') }}{% endblock %}
{% block body_id %}mood-reflection{% endblock %}

{% block header_actions -%}
    <twig:HeaderAction text="Check-in" href="{{ path('app_mood_reflection_last_unfilled') }}"
                       isGranted="{{ is_granted('MOOD_REFLECTION_LAST_UNFILLED') }}"/>
{%- endblock %}

{% block showcase -%}
    <twig:Card class="card-mood-chart" id="card-mood-chart">
        <div class="mood-chart" style="--chart-columns: {{ last_moods|length }};">
            {%- for last_mood in last_moods -%}
                <div class="chart-day" data-type="{{ last_mood?.type.value }}"
                     {% if last_mood %}data-general-type="{{ last_mood.type.color.value }}"{% endif %}>
                    <div class="chart-day-type">{{ last_mood?.date.format('j') }}</div>
                </div>
            {%- endfor -%}
        </div>
    </twig:Card>
{%- endblock %}

{% block body_pagination_actions -%}
    {%- set prev_month = month.modify('-1 month') -%}
    <twig:Pagination:Prev href="{{ path('app_mood_reflections', {month: prev_month.format('Y-m')}) }}"
                          isGranted="{{ prev_month.format('Y') >= app_year_min and is_granted('MOOD_REFLECTION_VIEW', prev_month) }}"
                          label="{{ prev_month.format('F') }}"/>

    {%- set next_month = month.modify('+1 month') -%}
    <twig:Pagination:Next href="{{ path('app_mood_reflections', {month: next_month.format('Y-m')}) }}"
                          isGranted="{{ current_date.format('Y-m') >= next_month.format('Y-m') }}"
                          label="{{ next_month.format('F') }}"/>
{%- endblock %}

{% block main -%}
    <twig:Card class="card-calendar-month">
        {%- set current_day = current_date.format('Y-m-d') -%}

        <twig:Caledar onlyMonth="{{ month }}">
            {# "day" is an internal string in the "Y-m-d" format #}
            {%- set mood = moods[day] is defined ? moods[day] : null -%}

            <twig:Calendar:Day day="{{ day }}"
                               href="{{ path('app_mood_reflection_edit', {day: day}) }}"
                               isGranted="{{ is_granted('MOOD_REFLECTION_EDIT', day) }}"
                               color="{{ mood !== null ? mood.type.color.value }}"
                               isPast="{{ mood !== null }}"
                               isCurrent="{{ day === current_day }}"
                               isWeekend="{{ day|is_weekend }}">
                {%- if mood?.text -%}
                    <twig:Calendar:Badge color="{{ mood.type.color.value }}"/>
                {%- endif -%}
            </twig:Calendar:Day>
        </twig:Caledar>
    </twig:Card>
{%- endblock %}
