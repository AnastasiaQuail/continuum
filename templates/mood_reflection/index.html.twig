{% extends 'base.html.twig' %}

{% block title %}Mood reflection{% endblock %}
{% block body_id %}mood-reflection{% endblock %}

{% set breadcrumbs = [
    {label: 'Reflection'},
] %}

{% set is_granted = is_granted('MOOD_REFLECTION_EDIT') %}

{% block showcase -%}
    <section id="mood-chart-card" class="card card-mood-chart">
        <div class="mood-chart" style="--chart-columns: {{ last_moods|length }};">
            {%- for last_mood in last_moods -%}
                {%- if last_mood -%}
                    <{% if is_granted %}a{% else %}div{% endif %}
                        {% if is_granted %}href="{{ path('app_mood_reflection_edit', {day: last_mood.date.format('Y-m-d')}) }}"{% endif %}
                        class="chart-day" data-type="{{ last_mood.type.value }}"
                        data-general-type="{{ last_mood.type.color.value }}">
                        <div class="chart-day-type">{{ last_mood.date.format('j') }}</div>
                    </{% if is_granted %}a{% else %}div{% endif %}>
                {%- else -%}
                    <div class="chart-day">
                        <div class="chart-day-type"></div>
                    </div>
                {%- endif -%}
            {%- endfor -%}
        </div>
    </section>
{%- endblock %}

{% block main -%}
    <section class="card card-calendar-mood">
        <div class="card-title card-title-controls">
            <h2>{{ month.format('F Y') }}</h2>

            {% set prev_month = month.modify('-1 month') %}
            {% set next_month = month.modify('+1 month') %}
            {{ include('default/_pagination.html.twig', {
                prev: {
                    url: path('app_mood_reflections', {month: prev_month.format('Y-m')}),
                    label: prev_month.format('F'),
                    is_granted: prev_month.format('Y') >= app_year_min and is_granted('MOOD_REFLECTION_VIEW', prev_month),
                },
                next: {
                    url: path('app_mood_reflections', {month: next_month.format('Y-m')}),
                    label: next_month.format('F'),
                    is_granted: user_date().format('Y-m') >= next_month.format('Y-m'),
                },
            }) }}
        </div>

        <div class="calendar">
            <article class="month">
                {%- set current = user_date().format('Y-m-d') -%}
                {%- set first_week_day = month.format('N') -%}

                <div class="month-days">
                    {%- if first_week_day > 1 -%}
                        <div class="day fake-day" style="--fake-days: {{ first_week_day - 1 }};">
                            <span>1</span>
                        </div>
                    {%- endif -%}

                    {%- for day_number in 1..month.format('t') -%}
                        {%- set day = month.format('Y-m-') ~ (day_number < 10 ? '0') ~ day_number -%}
                        {%- set mood = moods[day] is defined ? moods[day] : null -%}
                        {%- set is_granted_day = is_granted and current >= day -%}

                        <{% if is_granted_day %}a{% else %}div{% endif %}
                            {% if is_granted_day %}href="{{ path('app_mood_reflection_edit', {day: day}) }}"{% endif %}
                            class="day {{- mood !== null ? ' day-past' -}} {{- day === current ? ' day-current' -}} {{- day|is_weekend ? ' day-weekend' -}}"
                            {%- if mood !== null %}data-general-type="{{ mood.type.color.value }}"{% endif -%}>
                            <span>{{ day_number }}</span>

                            {%- if mood?.text -%}
                                <div class="day-badges">
                                    <span class="day-badge" data-general-type="{{ mood.type.color.value }}"></span>
                                </div>
                            {%- endif -%}
                        </{% if is_granted_day %}a{% else %}div{% endif %}>
                    {%- endfor -%}
                </div>
            </article>
        </div>
    </section>
{%- endblock %}
