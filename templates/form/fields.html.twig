{% use 'bootstrap_5_layout.html.twig' %}

{%- block form_row_render -%}
    {%- set row_class = row_class|default(row_attr.class|default('form-row')|trim) -%}
    {{ parent() }}
{%- endblock %}

{%- block enum_widget -%}
    {%- set icons = icons|default({}) -%}

    <div class="form-control-choose-type-group">
        {%- for choice in choices -%}
            <label class="form-control-choose-type"
                   data-general-type="{{ choice.data.color.value }}">
                <input type="radio" name="{{ name }}" id="{{ id }}_{{ choice.value }}" value="{{ choice.value }}"
                       {% if required %}required="required"{% endif %}
                    {% if choice.value === value %}checked="checked"{% endif %}>
                <span class="btn {{ button_size|default('') }}" tabindex="0">
                    {{- icons[choice.value] is defined ? icons[choice.value]|raw -}}
                    {{- choice.label -}}
                </span>
            </label>
        {%- endfor -%}
    </div>
{%- endblock %}

{%- block time_widget -%}
    <div class="form-control-time">
        {{- parent() -}}
        <button class="btn btn-link" onclick="document.getElementById('{{ id }}').value = null; return false;">
            {{- ux_icon('lucide:x') -}}
        </button>
    </div>
{%- endblock %}
