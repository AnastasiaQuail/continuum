<nav class="calendar-pagination">
    <{% if prev.is_granted -%}a{% else %}span{% endif %}
        class="page-link page-link-prev {% if not prev.is_granted -%}page-link-disabled{% endif %}"
        {% if prev.is_granted -%}href="{{ prev.url }}"{% endif %}>
        {{- ux_icon('lucide:chevron-left') -}}
        <span>{{ prev.label }}</span>
    </{% if prev.is_granted %}a{% else %}span{% endif %}>

    <{% if next.is_granted -%}a{% else %}span{% endif %}
        class="page-link page-link-next {% if not next.is_granted -%}page-link-disabled{% endif %}"
        {% if next.is_granted -%}href="{{ next.url }}"{% endif %}>
        <span>{{ next.label }}</span>
        {{- ux_icon('lucide:chevron-right') -}}
    </{% if next.is_granted %}a{% else %}span{% endif %}>
</nav>
