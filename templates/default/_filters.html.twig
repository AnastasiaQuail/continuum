{% macro months(days, path, months) -%}
    <div class="page-filter-dropdown">
        {%- set months_count = (days / 30)|round -%}
        {%- set patch = '###'|url_encode -%}

        <span>{{ months_count }} {{ months_count > 1 ? 'months' : 'month' }} {{ ux_icon('lucide:chevron-right') }}</span>
        <ul class="dropdown-menu">
            {%- for month in months -%}
                <li>
                    <a class="dropdown-item" href="{{ path|replace({(patch): month}) }}">
                        {{- month }} {{ month > 1 ? 'months' : 'month' -}}
                    </a>
                </li>
            {%- endfor -%}
        </ul>
    </div>
{%- endmacro %}
