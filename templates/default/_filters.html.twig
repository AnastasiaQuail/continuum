{% macro months(label, days, path, months) -%}
    <div class="btn btn-glass btn-dropdown" tabindex="0">
        <span class="dropdown-label">
            {%- if label -%}
                {{- label|raw -}}
            {%- else -%}
                {%- set months_count = (days / 30)|round -%}
                {{- months_count }} {{ months_count > 1 ? 'months' : 'month' }} {{ ux_icon('lucide:chevron-down') -}}
            {%- endif -%}
        </span>
        <ul class="dropdown-menu">
            {%- set patch = '###'|url_encode -%}
            {%- for month in months -%}
                <li class="dropdown-item">
                    <a class="dropdown-link" href="{{ path|replace({(patch): month}) }}">
                        {{- month }} {{ month > 1 ? 'months' : 'month' -}}
                    </a>
                </li>
            {%- endfor -%}
        </ul>
    </div>
{%- endmacro %}
