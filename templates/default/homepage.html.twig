{% extends 'base.html.twig' %}

{%- block javascripts -%}
    {{ parent() }}
    <script src="{{ asset('js/echarts.min.js') }}"></script>
    <script src="{{ asset('js/chart.js') }}"></script>
{%- endblock -%}

{% block title %}{{ app_title }} Dashboard{% endblock %}
{% block page_title %}Dashboard{% endblock %}
{% block body_id %}homepage{% endblock %}

{% set current_date = user_date() %}

{% block header_actions %}
    <twig:Popover id="homepage-actions" label="{{ ux_icon('lucide:ellipsis') }}">
        {%- set new_event_day = user_date('+1 day').format('Y-m-d') -%}
        <twig:Popover:Item href="{{ path('app_calendar_day', {day: new_event_day}) }}"
                           isGranted="{{ is_granted('CALENDAR_EDIT', new_event_day) }}"
                           icon="{{ ux_icon('lucide:calendar-plus') }}"
                           name="New event"/>

        <twig:Popover:Divider/>

        <twig:Popover:Item href="{{ path('app_mood_reflection_last_unfilled') }}"
                           isGranted="{{ is_granted('MOOD_REFLECTION_LAST_UNFILLED') }}"
                           icon="{{ ux_icon('lucide:scan-face') }}"
                           name="Track mood"/>
        <twig:Popover:Item href="{{ path('app_measurement_create') }}"
                           isGranted="{{ is_granted('BODY_MEASUREMENT_CREATE') }}"
                           icon="{{ ux_icon('lucide:ruler') }}"
                           name="Add measurement"/>
        <twig:Popover:ItemForm href="{{ path('app_workout_create') }}"
                               isGranted="{{ is_granted('WORKOUT_CREATE') }}"
                               icon="{{ ux_icon('lucide:biceps-flexed') }}"
                               name="Start workout"/>
    </twig:Popover>
{% endblock %}

{% block showcase -%}
    {%- if current_date.format('m-d') === '03-08' -%}
        <twig:Card class="card-shine">
            <twig:Card:Title isCompact>
                <twig:block name="header">International Women's Day 👩‍🔬👩‍🏫👩‍💼👩‍⚕️👩‍💻</twig:block>
            </twig:Card:Title>

            <div>
                <small>Commemorating women's fight for equality and liberation 💪</small>
            </div>
        </twig:Card>
    {%- endif -%}

    <twig:Card id="card-the-wait">
        <twig:Card:Title isCompact id="card-title-the-wait">
            <twig:block name="header">The Wait</twig:block>
            <twig:block name="info">apart, still us {{ ux_icon('lucide:heart') }}</twig:block>
        </twig:Card:Title>

        <div id="progress-the-wait" class="progress-group">
            <div class="progress" style="--progress: {{ progress.currentProgress }}%;">
                <div class="progress-bar"></div>
            </div>
            <div class="progress-text">{{ progress.currentProgress }}%</div>
        </div>

        {%- if +current_date.format('j') === 1 -%}
            <div class="progress-description">
                <strong>{{ progress.pastMonths }}</strong> out of
                <strong>{{ progress.totalMonths }}</strong> months have passed ⚡️
            </div>
        {%- elseif +current_date.format('N') === 1 -%}
            <div class="progress-description">
                <strong>{{ progress.pastWeeks }}</strong> out of
                <strong>{{ progress.totalWeeks }}</strong> weeks have passed 💪
            </div>
        {%- endif -%}
    </twig:Card>

    <div class="row row-md-2">
        <twig:Card>
            <twig:Card:Title isCompact class="card-title-shine" id="card-title-love-story">
                <twig:block name="header">Love story</twig:block>
                <twig:block name="info">{{ couple.together }}</twig:block>
            </twig:Card:Title>

            <div class="card-couple">
                {%- import 'default/homepage.html.twig' as homepage -%}
                {{- homepage.couple_partner(couple.time, couple.weather) -}}
                <div class="couple-distance">
                    <div class="couple-line">
                        {{- ux_icon('lucide:chevron-left') }}{{ ux_icon('lucide:chevron-right') -}}
                    </div>
                    <span class="couple-distance-value">{{ couple.distance|round }} <small>km</small></span>
                </div>
                {{- homepage.couple_partner(couple.partnerTime, couple.partnerWeather) -}}
            </div>
        </twig:Card>

        {%- if is_granted('CALENDAR_UPCOMING_EVENTS') -%}
            <twig:Card id="card-calendar">
                <twig:Card:Title isCompact class="card-title-calendar-upcoming">
                    <twig:block name="header">Calendar</twig:block>
                    <twig:block name="info">
                        {%- if today_events is not empty -%}
                            <div class="today-events" style="--te-count: {{ today_events|length }};">
                                {%- for today_event in today_events -%}
                                    <div class="today-event">{{ today_event }}</div>
                                {%- endfor -%}
                            </div>
                        {%- endif -%}
                    </twig:block>
                </twig:Card:Title>

                {%- if upcoming_events is not empty -%}
                    {{- include('calendar/_upcoming_events.html.twig') -}}
                {%- endif -%}
            </twig:Card>
        {%- endif -%}
    </div>
{%- endblock %}

{% block main -%}
    <div class="row row-sm-2">
        {%- if is_granted('BODY_MEASUREMENT_VIEW') -%}
            <twig:Card id="card-weight-change">
                <twig:Card:Title id="card-title-weight-change">
                    <twig:block name="header">Body fat</twig:block>

                    <twig:block name="badge">
                        {%- if chart_measurements|length > 1 -%}
                            {%- set result = ((chart_measurements|last).weight - (chart_measurements|first).weight)|round(1) -%}

                            {%- if result !== 0.0 -%}
                                <twig:BadgeNumber number="{{ result }}" postfix="kg" reversable/>
                            {%- endif -%}
                        {%- endif -%}
                    </twig:block>

                    <twig:block name="title_info">
                        <twig:MonthFilter href="{{ path('app_homepage', {measurement: '###'}) }}" months="4,6,8,10"
                                          idPrefix="measurements" days="{{ measurement_days }}"/>
                    </twig:block>
                </twig:Card:Title>

                <twig:Chart name="weight-change" values="{{ chart_measurements }}" showEmpty
                            data-days="{{ measurement_days }}" data-symbols="hide"/>
            </twig:Card>
        {%- endif -%}

        {%- if is_granted('WORKOUT_VIEW') -%}
            <twig:Card id="card-workouts">
                <twig:Card:Title id="card-title-workouts">
                    <twig:block name="header">Workouts</twig:block>
                    <twig:block name="title_info">
                        <twig:MonthFilter href="{{ path('app_homepage', {workout: '###'}) }}" months="4,6,8"
                                          idPrefix="workouts" days="{{ workout_days }}"/>
                    </twig:block>
                </twig:Card:Title>

                <div class="calendar-heatmap-workout-container">
                    <div class="calendar-heatmap-week">
                        {%- for day_name in ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'] -%}
                            <div class="calendar-heatmap-week-day">{{ day_name }}</div>
                        {%- endfor -%}
                    </div>
                    <div class="calendar-heatmap-workout">
                        {%- set week_day = current_date.format('N') -%}
                        {%- set date = current_date.modify('+1 day') -%}

                        {%- for workout_day in 1..workout_days -%}
                            {%- set date = date.modify('-1 day') -%}
                            {%- set day = date.format('Y-m-d') -%}

                            {%- set workout = workouts[day] is defined ? workouts[day] : null -%}

                            <{% if workout %}a{% else %}div{% endif %}
                                class="calendar-workout-day"
                                {% if workout %}href="{{ path('app_workouts', {month: date.format('Y-m')}) }}#workout_{{ workout.id }}"{% endif %}
                                {% if loop.first %}style="--workout-row: {{ week_day }};"{% endif %}>
                                <div>{{- date.format('j') -}}</div>

                                {%- if workout -%}
                                    <div class="calendar-workout-exercises">
                                        {%- for workout_exercise in workout.workoutExercises -%}
                                            {%- set exercise_group = workout_exercise.exercise.group -%}
                                            <span data-general-type="{{ exercise_group.color.value }}"></span>
                                        {%- endfor -%}
                                    </div>
                                {%- endif -%}
                            </{% if workout %}a{% else %}div{% endif %}>
                        {%- endfor -%}
                    </div>
                </div>
            </twig:Card>
        {%- endif -%}
    </div>

    {%- if is_granted('MOOD_REFLECTION_VIEW') -%}
        <twig:Card id="card-mood-chart">
            <twig:Card:Title id="card-title-mood-chart">
                <twig:block name="header">Mood trend</twig:block>
                <twig:block name="title_info">
                    <twig:MonthFilter href="{{ path('app_homepage', {mood: '###'}) }}" months="4,6,8,10"
                                      idPrefix="mood-reflections" days="{{ mood_reflection_days }}"/>
                </twig:block>
            </twig:Card:Title>

            <twig:Chart name="mood-reflections" values="{{ chart_mood_reflections }}"
                        data-days="{{ mood_reflection_days }}"/>
        </twig:Card>
    {%- endif -%}
{%- endblock %}

{% macro couple_partner(datetime, weather) -%}
    <div class="couple-partner">
        <div>{{ datetime.format('H:i') }}</div>
        <div class="couple-weather">
            <div class="couple-temperature">
                <span>{{ weather.code?.toEmoji }}</span>
                <span class="couple-temperature-degrees">{{ weather.temperature }}</span>
                <span class="couple-temperature-type">°C</span>
            </div>
            {%- if weather.wind -%}
                <div class="couple-wind">
                    <span>{{ weather.wind.direction.toEmoji }}</span>
                    <span>{{ weather.wind.speed }}</span>
                    <span>m/s</span>
                </div>
            {%- endif -%}
        </div>
    </div>
{%- endmacro %}
