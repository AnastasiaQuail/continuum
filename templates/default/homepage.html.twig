{% extends 'base.html.twig' %}

{%- block javascripts -%}
    {{ parent() }}
    {% if chartMeasurements %}
        <script src="{{ asset('js/echarts.min.js') }}"></script>
        <script src="{{ asset('js/chart.js') }}"></script>
    {%- endif -%}
{%- endblock -%}

{% block body_id %}homepage{% endblock %}

{% set showMonths = (showDays / 30)|round %}

{% block showcase -%}
    <section class="card">
        <h4 class="card-title card-title-justify">
            <span>The Wait</span>
            <span class="card-title-info">apart, still us {{ ux_icon('lucide:heart') }}</span>
        </h4>
        <div class="progress-group">
            <div class="progress" style="--progress: {{ calendarProgress }}%;">
                <div class="progress-bar"></div>
            </div>
            <div class="progress-text">{{ calendarProgress }}%</div>
        </div>
    </section>
{%- endblock %}

{% block main -%}
    <h2>Dashboards</h2>

    <div class="row row-sm-2">
        <section class="card card-panel">
            <h3 class="card-title card-title-justify">
                {%- set result = 0 -%}
                {%- if chartMeasurements -%}
                    {%- set result = ((chartMeasurements|last).weight - (chartMeasurements|first).weight)|round(1) -%}
                {%- endif -%}

                <span>Body fat</span>
                {%- if result !== 0 -%}
                    <span class="card-title-label {{ result > 0 ? 'value-bad' : 'value-good' }}">
                        <span>{{ result > 0 ? '+' ~ result : result }}</span><span>kg</span>
                    </span>
                {%- endif -%}
                <span class="card-title-info">last {{ showMonths }} months</span>
            </h3>

            <div class="card-panel-body chart-weight-change"
                 {% if chartMeasurements %}data-chart="weight-change" data-days="{{ showDays }}" data-symbols="hide"
                 data-values="{{ chartMeasurements|json_encode }}"{% endif %}></div>
        </section>

        <section class="card card-panel">
            <h3 class="card-title card-title-justify">
                <span>Workouts</span>
                <span class="card-title-info">last {{ showMonths }} months</span>
            </h3>

            <div class="card-panel-body calendar-heatmap-workout-container">
                <div class="calendar-heatmap-week">
                    {%- for dayName in ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'] -%}
                        <div class="calendar-heatmap-week-day">{{ dayName|capitalize }}</div>
                    {%- endfor -%}
                </div>
                <div class="calendar-heatmap-workout">
                    {%- set dates = [] -%}
                    {%- for workout in workouts -%}
                        {%- set dates = dates|merge([workout.date.format('Y-m-d')]) -%}
                    {%- endfor -%}

                    {%- set weekDay = user_date().format('N') -%}
                    {%- set date = user_date('+1 day') -%}

                    {%- for day in 1..((showDays / 7)|round * 7 + weekDay) -%}
                        {%- set date = date.modify('-1 day') -%}

                        <div class="calendar-workout-day {{ date.format('Y-m-d') in dates ? 'done' }}"
                             {% if loop.first %}style="--workout-row: {{ weekDay }};"{% endif %}>
                            {{- date.format('j') -}}
                        </div>
                    {%- endfor -%}
                </div>
            </div>
        </section>
    </div>
{%- endblock %}
