{% extends 'base.html.twig' %}

{%- block javascripts -%}
    {{ parent() }}
    <script src="{{ asset('js/echarts.min.js') }}"></script>
    <script src="{{ asset('js/chart.js') }}"></script>
{%- endblock -%}

{% block title %}Continuum Dashboard{% endblock %}
{% block page_title %}Dashboard{% endblock %}
{% block body_id %}homepage{% endblock %}

{% set currentDate = user_date() %}

{% block showcase -%}
    <section class="card">
        <div class="card-title card-title-showcase">
            <h2>The Wait</h2>
            <div class="card-title-info">apart, still us {{ ux_icon('lucide:heart') }}</div>
        </div>
        <div class="progress-group">
            {%- set progressPercent = progress.currentProgress -%}
            <div class="progress" style="--progress: {{ progressPercent }}%;">
                <div class="progress-bar"></div>
            </div>
            <div class="progress-text">{{ progressPercent }}%</div>
        </div>

        {%- if +currentDate.format('j') === 1 -%}
            <div class="progress-description">
                <strong>{{ progress.pastMonths }}</strong> out of
                <strong>{{ progress.totalMonths }}</strong> months have passed ⚡️
            </div>
        {%- elseif +currentDate.format('N') === 1 -%}
            <div class="progress-description">
                <strong>{{ progress.pastWeeks }}</strong> out of
                <strong>{{ progress.totalWeeks }}</strong> weeks have passed 💪
            </div>
        {%- endif -%}
    </section>

    <div class="row row-md-2">
        <section class="card card-coming">
            <div class="card-title card-title-showcase card-title-controls">
                <h2>Love story</h2>
                <span class="card-title-info">{{ couple.togetherString }}</span>
            </div>
            <div class="card-couple">
                <div class="couple-partner">
                    <div>{{ couple.time.format('H:i') }}</div>
                    <div class="couple-weather">
                        <span>{{ couple.weather.code.toEmoji }}</span>
                        <span class="couple-temperature">{{ couple.weather.temperature }}</span>
                        <span class="couple-temperature-type">°C</span>
                    </div>
                </div>
                <div class="couple-distance">
                    <div class="couple-line">
                        {{- ux_icon('lucide:chevron-right') }}{{ ux_icon('lucide:chevron-right') -}}
                    </div>
                    <span class="couple-distance-value">{{ couple.distance|round }} <small>km</small></span>
                </div>
                <div class="couple-partner">
                    <div>{{ couple.partnerTime.format('H:i') }}</div>
                    <div class="couple-weather">
                        <span>{{ couple.partnerWeather.code.toEmoji }}</span>
                        <span class="couple-temperature">{{ couple.partnerWeather.temperature }}</span>
                        <span class="couple-temperature-type">°C</span>
                    </div>
                </div>
            </div>
        </section>

        {%- if is_granted('CALENDAR_UPCOMING_EVENTS') -%}
            <section class="card">
                <div class="card-title card-title-showcase card-title-controls">
                    <h2>Upcoming</h2>

                    {%- if todayEvents is not empty -%}
                        <div class="card-title-info card-today-events">
                            <div class="today-events" style="--te-count: {{ todayEvents|length }};">
                                {%- for todayEvent in todayEvents -%}
                                    <div class="today-event">{{ todayEvent }}</div>
                                {%- endfor -%}
                            </div>
                        </div>
                    {%- endif -%}
                </div>

                {{- include('calendar/_upcoming_events.html.twig') -}}
            </section>
        {%- endif -%}
    </div>
{%- endblock %}

{% block main -%}
    <div class="row row-sm-2">
        {%- if is_granted('BODY_MEASUREMENT_VIEW') -%}
            <section class="card card-panel">
                <div class="card-title card-title-controls">
                    {%- set result = 0 -%}
                    {%- if chartMeasurements -%}
                        {%- set result = ((chartMeasurements|last).weight - (chartMeasurements|first).weight)|round(1) -%}
                    {%- endif -%}

                    <h2>Body fat</h2>
                    {%- if result !== 0 -%}
                        <span class="card-title-label {{ result > 0 ? 'value-bad' : 'value-good' }}">
                            <span>{{ result > 0 ? '+' ~ result : result }}</span><span>kg</span>
                        </span>
                    {%- endif -%}

                    {{- _self.card_title_dropdown(measurementDays, 'measurement') -}}
                </div>

                <div class="card-panel-body chart-panel"
                     {% if chartMeasurements %}data-chart="weight-change" data-days="{{ measurementDays }}"
                     data-symbols="hide" data-values="{{ chartMeasurements|json_encode }}"{% endif %}></div>
            </section>
        {%- endif -%}

        {%- if is_granted('WORKOUT_VIEW') -%}
            <section class="card card-panel">
                <div class="card-title card-title-controls">
                    <h2>Workouts</h2>
                    {{- _self.card_title_dropdown(workoutDays, 'workout') -}}
                </div>

                <div class="card-panel-body calendar-heatmap-workout-container">
                    <div class="calendar-heatmap-week">
                        {%- for dayName in ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'] -%}
                            <div class="calendar-heatmap-week-day">{{ dayName|capitalize }}</div>
                        {%- endfor -%}
                    </div>
                    <div class="calendar-heatmap-workout">
                        {%- set dates = [] -%}
                        {%- for workout in workouts -%}
                            {%- set dates = dates|merge({(workout.date.format('Y-m-d')): workout}) -%}
                        {%- endfor -%}

                        {%- set weekDay = currentDate.format('N') -%}
                        {%- set date = currentDate.modify('+1 day') -%}

                        {%- for workoutDay in 1..workoutDays -%}
                            {%- set date = date.modify('-1 day') -%}
                            {%- set day = date.format('Y-m-d') -%}
                            {%- set workout = dates[day] is defined ? dates[day] : null -%}

                            <div class="calendar-workout-day {{ workout !== null ? 'done' }}"
                                 {% if loop.first %}style="--workout-row: {{ weekDay }};"{% endif %}>
                                <div>{{- date.format('j') -}}</div>
                                <div class="calendar-workout-exercises">
                                    {%- for workoutExercise in workout?.workoutExercises -%}
                                        <span
                                            data-general-type="{{ workoutExercise.exercise.group.color.value }}"></span>
                                    {%- endfor -%}
                                </div>
                            </div>
                        {%- endfor -%}
                    </div>
                </div>
            </section>
        {%- endif -%}
    </div>

    {%- if is_granted('MOOD_REFLECTION_VIEW') -%}
        <section class="card card-panel">
            <div class="card-title card-title-controls">
                <h2>Mood trend</h2>
                {{- _self.card_title_dropdown(moodReflectionDays, 'mood') -}}
            </div>

            <div class="card-panel-body chart-panel"
                 {% if chartMoodReflections %}data-chart="mood-reflections" data-days="{{ moodReflectionDays }}"
                 data-values="{{ chartMoodReflections|json_encode }}"{% endif %}></div>
        </section>
    {%- endif -%}
{%- endblock %}

{% macro card_title_dropdown(days, query) -%}
    <div class="card-title-dropdown">
        {%- set months = (days / 30)|round -%}
        <span>{{ months }} {{ months > 1 ? 'months' : 'month' }} {{ ux_icon('lucide:chevron-right') }}</span>
        <ul class="dropdown-menu">
            {%- for month in 1..3 -%}
                <li>
                    <a class="dropdown-item" href="{{ path('app_homepage', {(query): month}) }}">
                        {{- month }} {{ month > 1 ? 'months' : 'month' -}}
                    </a>
                </li>
            {%- endfor -%}
        </ul>
    </div>
{%- endmacro %}
