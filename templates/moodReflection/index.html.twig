{% extends 'base.html.twig' %}

{% set monthName = month.format('F Y') %}
{% set isCurrentMonth = monthName == user_date()|date('F Y') %}

{% block title %}Mood tracker{{ not isCurrentMonth ? ' | ' ~ monthName }}{% endblock %}
{% block body_id %}mood-tracker{% endblock %}

{% set breadcrumbs = [
    { label: 'Mood tracker', url: path('app_mood_reflections') },
    { label: monthName },
] %}

{% set prevMonth = month.modify('-1 month') %}
{% set nextMonth = month.modify('+1 month') %}
{% set paginations = {
    prev: {
        url: path('app_mood_reflections', {'month': prevMonth.format('Y-m')}),
        label: prevMonth.format('F'),
        isGranted: prevMonth.format('Y') >= app_year_min and is_granted('MOOD_REFLECTION_VIEW', prevMonth),
    },
    title: month.format('F'),
    next: {
        url: path('app_mood_reflections', {'month': nextMonth.format('Y-m')}),
        label: nextMonth.format('F'),
        isGranted: user_date().format('Y-m') >= nextMonth.format('Y-m'),
    },
} %}

{% set isGranted = is_granted('MOOD_REFLECTION_EDIT') %}

{% block showcase -%}
    <section class="card card-mood-chart">
        <div class="mood-chart" style="--chart-columns: {{ lastMoods|length }};">
            {%- for lastMood in lastMoods -%}
                {%- if lastMood -%}
                    <{% if isGranted %}a{% else %}div{% endif %}
                        {% if isGranted %}href="{{ path('app_mood_reflection_edit', {'day': lastMood.date.format('Y-m-d')}) }}"{% endif %}
                        class="chart-day" data-type="{{ lastMood.type.value }}"
                        data-general-type="{{ lastMood.type.color.value }}">
                        <div class="chart-day-type">{{ lastMood.date.format('j') }}</div>
                    </{% if isGranted %}a{% else %}div{% endif %}>
                {%- else -%}
                    <div class="chart-day">
                        <div class="chart-day-type"></div>
                    </div>
                {%- endif -%}
            {%- endfor -%}
        </div>
    </section>
{%- endblock %}

{% block main -%}
    <section class="card card-calendar-mood">
        <div class="calendar">
            <article class="month">
                {%- set current = user_date().format('Y-m-d') -%}
                {%- set firstWeekDay = month.format('N') -%}

                <div class="month-days">
                    {%- if firstWeekDay > 1 -%}
                        <div class="day fake-day" style="--fake-days: {{ firstWeekDay - 1 }};">
                            <span>1</span>
                        </div>
                    {%- endif -%}

                    {%- for dayNumber in 1..month.format('t') -%}
                        {%- set day = month.format('Y-m-') ~ (dayNumber < 10 ? '0') ~ dayNumber -%}
                        {%- set mood = moods[day] is defined ? moods[day] : null -%}
                        {%- set isGrantedDay = isGranted and current >= day -%}

                        <{% if isGrantedDay %}a{% else %}div{% endif %}
                            {% if isGrantedDay %}href="{{ path('app_mood_reflection_edit', {'day': day}) }}"{% endif %}
                            class="day {{- day == current ? ' day-current' -}} {{- mood is not null ? ' day-past' }}"
                            {%- if mood is not null %}data-general-type="{{ mood.type.color.value }}"{% endif -%}>
                            <span>{{ dayNumber }}</span>
                        </{% if isGrantedDay %}a{% else %}div{% endif %}>
                    {%- endfor -%}
                </div>
            </article>
        </div>
    </section>
{%- endblock %}
