{% extends 'base.html.twig' %}

{% block title %}Mood tracker | {{ day.format('j F Y') }}{% endblock %}
{% block body_id %}mood-tracker-day{% endblock %}

{% set breadcrumbs = [
    { label: 'Mood tracker', url: path('app_mood_reflections') },
    { label: day.format('F Y'), url: path('app_mood_reflections', {'month': day.format('Y-m')}) },
    { label: day.format('j') },
] %}

{% block main -%}
    <section class="card">
        <h3 class="card-title">Mood of the day</h3>

        {{- form_start(form, {method: 'POST', action: path('app_mood_reflection_edit', {'day': day.format('Y-m-d')})}) -}}

        <div class="mb-3">
            {{- form_label(form.type) -}}
            <div class="form-control-choose-type-group">
                {%- for choice in form.type.vars.choices -%}
                    <label class="form-control-choose-type"
                           data-general-type="{{ choice.data.color.value }}">
                        <input type="radio" name="type" id="{{ form.type.vars.id }}_{{ choice.value }}"
                               value="{{ choice.value }}"
                               {% if form.type.vars.required %}required="required"{% endif %}
                               {% if choice.value === form.type.vars.value %}checked{% endif %}>
                        <span class="btn">
                            {%- if choice.value === 'terrible' -%}
                                {{- ux_icon('lucide:angry') -}}
                            {%- elseif choice.value === 'bad' -%}
                                {{- ux_icon('lucide:frown') -}}
                            {%- elseif choice.value === 'good' -%}
                                {{- ux_icon('lucide:smile') -}}
                            {%- elseif choice.value === 'great' -%}
                                {{- ux_icon('lucide:laugh') -}}
                            {%- else -%}
                                {{- ux_icon('lucide:meh') -}}
                            {%- endif -%}
                            <span>{{ choice.label }}</span>
                        </span>
                    </label>
                {%- endfor -%}
            </div>
            {{- form_errors(form.type) -}}
            {%- do form.type.setRendered -%}
        </div>

        {{- form_row(form.text) -}}

        <div class="card-submit">
            <button type="submit" class="btn btn-primary btn-outline">Save</button>
        </div>

        {{- form_end(form) -}}
    </section>
{%- endblock %}
