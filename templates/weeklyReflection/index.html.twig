{% extends 'base.html.twig' %}

{% block title %}Weekly reflection{% endblock %}
{% block body_id %}weekly-reflection{% endblock %}

{% set breadcrumbs = [
    { label: 'Reflection' },
] %}

{% block main -%}
    <section class="card">
        <div class="card-title card-title-controls">
            <h2>{{ month.format('F Y') }}</h2>

            {% set prevMonth = month.modify('-1 month') %}
            {% set nextMonth = month.modify('+1 month') %}
            {{ include('default/_pagination.html.twig', {
                'prev': {
                    url: path('app_weekly_reflections', {'month': prevMonth.format('Y-m')}),
                    label: prevMonth.format('F'),
                    isGranted: prevMonth.format('Y') >= app_year_min and is_granted('WEEKLY_REFLECTION_VIEW', prevMonth),
                },
                'next': {
                    url: path('app_weekly_reflections', {'month': nextMonth.format('Y-m')}),
                    label: nextMonth.format('F'),
                    isGranted: user_date().format('Y-m') >= nextMonth.format('Y-m'),
                }
            }) }}
        </div>

        <div class="weekly-reflection">
            {%- for date, reflection in weeklyReflections -%}
                <div class="week">
                    <div class="week-title">
                        {%- set monday = date(date).modify('-6 days') -%}
                        {%- set sunday = date(date) -%}
                        {%- set isDifferentMonth = monday.format('n') !== sunday.format('n') -%}
                        {%- set time = monday.format(isDifferentMonth ? 'j F' : 'j') ~ ' - ' ~ sunday.format('j F') -%}

                        {%- if is_granted('WEEKLY_REFLECTION_EDIT') -%}
                            <a href="{{ path('app_weekly_reflection_edit', {'week': date}) }}">{{ time }}</a>
                        {%- else -%}
                            <span>{{ time }}</span>
                        {%- endif -%}
                    </div>
                    <div class="week-body">
                        {% include 'weeklyReflection/_alert.html.twig' with {
                            type: 'joy',
                            isEmpty: reflection is null,
                            text: reflection?.joy,
                            isPrivate: reflection?.joyPrivate,
                        } %}
                        {% include 'weeklyReflection/_alert.html.twig' with {
                            type: 'difficulty',
                            isEmpty: reflection is null,
                            text: reflection?.difficulty,
                            isPrivate: reflection?.difficultyPrivate,
                        } %}
                        {% include 'weeklyReflection/_alert.html.twig' with {
                            type: 'achievement',
                            isEmpty: reflection is null,
                            text: reflection?.achievement,
                            isPrivate: reflection?.achievementPrivate,
                        } %}
                    </div>
                </div>
            {%- endfor -%}
        </div>
    </section>
{%- endblock %}
